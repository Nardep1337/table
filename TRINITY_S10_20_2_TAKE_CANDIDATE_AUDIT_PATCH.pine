bool bottomContRenewalObservation = bottomContStage == 2 and not bottomContDefenseFailure and bar_index > bottomContDefenseBar and close < nz(bottomContRenewalLevel, low[1]) - 0.02 * resolverAtr and close < open and directionalClose <= 0.45 and priceVelocityAtr < 0 and bottomRenewalQuality >= contRenewalMin
bool topContRenewalObservation = topContStage == 2 and not topContDefenseFailure and bar_index > topContDefenseBar and close > nz(topContRenewalLevel, high[1]) + 0.02 * resolverAtr and close > open and directionalClose >= 0.55 and priceVelocityAtr > 0 and topRenewalQuality >= contRenewalMin
// Three-hypothesis competition. A renewal-shaped candle can be either genuine
