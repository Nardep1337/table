float sellLogOdds = -1.20 + sellCalibrationBias + 0.80 * (0.25 + 1.50 * sellReliabilityReservoir) * topEnergyEvidence + 1.25 * (0.25 + 1.50 * sellReliabilityTurn) * topTurnEvidence + 1.55 * (0.25 + 1.50 * sellReliabilityPrice) * topPriceEvidence + 0.55 * (0.25 + 1.50 * sellReliabilityFlow) * topFlowEvidence + 1.75 * (0.25 + 1.50 * sellReliabilityStructure) * topStructureEvidence - 1.20 * topContinuationRisk
