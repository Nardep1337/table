float topPhasePriceVictory = clamp01(0.30 * topPhaseControlDisplacement + 0.24 * topPriceEvidence + 0.16 * topPhaseCloseVictory + 0.15 * topPhaseImpulseVictory + 0.15 * math.max(topStructureEvidence, shortMicroBreak ? 0.65 : 0.0))
