float bottomCarTurnLogit = -0.55 + 2.40 * math.max(bottomCarTurnScore, bottomCarTurnPeak)
float topCarTurnLogit = -0.55 + 2.40 * math.max(topCarTurnScore, topCarTurnPeak)
float bottomCarTakeoverLogit = -0.85 + 3.10 * bottomCarOpposingResponse + (bottomCarTurnSeen ? 0.20 : 0.0)
float topCarTakeoverLogit = -0.85 + 3.10 * topCarOpposingResponse + (topCarTurnSeen ? 0.20 : 0.0)
float bottomCarContinuationLogit = -0.45 + 2.20 * bottomContinuationAcceptance + 0.35 * clamp01(math.max(-carResponseZ, 0.0) / 2.0)
float topCarContinuationLogit = -0.45 + 2.20 * topContinuationAcceptance + 0.35 * clamp01(math.max(carResponseZ, 0.0) / 2.0)
float bottomCarMaxLogit = math.max(bottomCarTurnLogit, math.max(bottomCarTakeoverLogit, bottomCarContinuationLogit))
float topCarMaxLogit = math.max(topCarTurnLogit, math.max(topCarTakeoverLogit, topCarContinuationLogit))
float bottomCarTurnExp = math.exp(bottomCarTurnLogit - bottomCarMaxLogit)
float bottomCarTakeoverExp = math.exp(bottomCarTakeoverLogit - bottomCarMaxLogit)
float bottomCarContinuationExp = math.exp(bottomCarContinuationLogit - bottomCarMaxLogit)
float topCarTurnExp = math.exp(topCarTurnLogit - topCarMaxLogit)
float topCarTakeoverExp = math.exp(topCarTakeoverLogit - topCarMaxLogit)
