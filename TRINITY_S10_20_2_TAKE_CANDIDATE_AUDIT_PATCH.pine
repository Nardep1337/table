            oppositeHigh := math.max(oppositeHigh, high[sfpIndex])
        bullSfpSwingLevel := lastSfpLow
        bullSfpSweepExtreme := low
        bullSfpOpposite := oppositeHigh
        bullSfpRecoveryLevel := low + recoveryFib * math.max(oppositeHigh - low, syminfo.mintick)
        bullSfpArmBar := bar_index
