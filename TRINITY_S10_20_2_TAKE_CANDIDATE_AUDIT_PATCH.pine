bool topContDefenseObservation = topContStage == 1 and bar_index > topContAttackBar and close < close[1] and topContDefenseFraction >= contDefenseMin and topContDefenseFraction <= contDefenseMax and close >= nz(topResolverExtreme, close) - 0.10 * resolverAtr and topControlState < 0.15
