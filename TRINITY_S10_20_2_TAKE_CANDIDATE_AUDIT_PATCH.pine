plot(topReversalPrior * 100.0, "Top Reversal Prior", display = display.data_window)
plot(bottomContinuationPrior * 100.0, "Bottom Continuation Prior", display = display.data_window)
plot(topContinuationPrior * 100.0, "Top Continuation Prior", display = display.data_window)
