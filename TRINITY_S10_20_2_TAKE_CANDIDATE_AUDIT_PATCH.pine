int selectedShortRoute = not topCycleArmed ? 0 : topStructureEvidence >= math.max(topIndexDriver, topFlowEvidence) ? 3 : topFlowEvidence >= 0.55 and topStructureEvidence >= 0.45 and topFlowEvidence > topIndexDriver ? 2 : 1
