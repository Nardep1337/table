bool topContDefenseFailure = topContStage == 2 and (topContDefenseFraction > contDefenseMax or close < nz(topResolverExtreme, close) - 0.15 * resolverAtr or bar_index - topContDefenseBar > contDefenseMemory)
float bottomRenewalQuality = clamp01(0.30 * bottomContinuationAcceptance + 0.20 * bottomDominantImpulse + 0.18 * bottomMomentumAcceptance + 0.12 * bottomIndexRelapse + 0.10 * bottomCloseAcceptance + 0.10 * clamp01(-bottomSequentialIncrement / 0.35))
