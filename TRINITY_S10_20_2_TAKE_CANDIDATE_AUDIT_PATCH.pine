float bottomDecisionBoundary = resolverDecisionBoundary * (bottomResolverAge >= resolverLatencyBars ? 0.80 : 1.0)
float topDecisionBoundary = resolverDecisionBoundary * (topResolverAge >= resolverLatencyBars ? 0.80 : 1.0)
int bottomRequiredPersistence = bottomResolverAge >= resolverLatencyBars ? math.max(resolverConfirmBars - 1, 1) : resolverConfirmBars
int topRequiredPersistence = topResolverAge >= resolverLatencyBars ? math.max(resolverConfirmBars - 1, 1) : resolverConfirmBars
bool bottomReversalPriceBoundary = bottomResolverPending and close > nz(bottomResolverLevel, close) + cycleControlBufferAtr * resolverAtr and bottomControlState > 0.05
bool topReversalPriceBoundary = topResolverPending and close < nz(topResolverLevel, close) - cycleControlBufferAtr * resolverAtr and topControlState > 0.05
