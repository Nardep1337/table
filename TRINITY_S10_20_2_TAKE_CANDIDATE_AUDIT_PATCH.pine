float topFreshnessThreshold = topResolverTransferred ? revTransferFreshnessMin : revFreshnessMin
bool bottomReversalHypothesisLive = bottomResolverPending and bottomReversalFreshness >= bottomFreshnessThreshold and (not bottomResolverTransferred or bottomSecondPriceVictory)
bool topReversalHypothesisLive = topResolverPending and topReversalFreshness >= topFreshnessThreshold and (not topResolverTransferred or topSecondPriceVictory)
// Directional Victory Transfer (DVT). The original exhaustion extreme is frozen
