float topTerminalIndexBrake = clamp01(math.max(-exhaustionAcceleration, 0.0) / 2.0)
float bottomTerminalAbsorption = math.max(aerfReady ? bullModelMismatch : bullGeometryAbsorption, clamp01(bullAbsorptionRecentQuality / 100.0))
float topTerminalAbsorption = math.max(aerfReady ? bearModelMismatch : bearGeometryAbsorption, clamp01(bearAbsorptionRecentQuality / 100.0))
