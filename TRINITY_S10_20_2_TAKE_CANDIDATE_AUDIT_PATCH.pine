float topTerminalGeometry = clamp01(math.max(topStructureEvidence, topTurnEvidence))
float bottomTerminalScore = bottomResolverPending ? clamp01(0.25 * bottomTerminalPriceBrake + 0.22 * bottomTerminalIndexBrake + 0.22 * bottomTerminalAbsorption + 0.16 * bottomTerminalGeometry + 0.15 * bottomExtremeDepth) : 0.0
float topTerminalScore = topResolverPending ? clamp01(0.25 * topTerminalPriceBrake + 0.22 * topTerminalIndexBrake + 0.22 * topTerminalAbsorption + 0.16 * topTerminalGeometry + 0.15 * topExtremeDepth) : 0.0
float bottomRenewalAcceleration = clamp01(math.max(-priceAccelerationAtr, 0.0) / 0.45)
float topRenewalAcceleration = clamp01(math.max(priceAccelerationAtr, 0.0) / 0.45)
