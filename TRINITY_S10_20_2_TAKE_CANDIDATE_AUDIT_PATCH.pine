    if not na(bearSfpSwingLevel)
        bearSfpRecoverySeen := bearSfpRecoverySeen or close <= bearSfpRecoveryLevel
        if bar_index - bearSfpArmBar > sfpConfirmMemory or close > bearSfpSweepExtreme
            bearSfpSwingLevel := na
            bearSfpRecoverySeen := false
    if not na(bullSfpSwingLevel)
        bullSfpRecoverySeen := bullSfpRecoverySeen or close >= bullSfpRecoveryLevel
        if bar_index - bullSfpArmBar > sfpConfirmMemory or close < bullSfpSweepExtreme
            bullSfpSwingLevel := na
            bullSfpRecoverySeen := false
bool bearSfpActive = not na(bearSfpSwingLevel)
bool bullSfpActive = not na(bullSfpSwingLevel)
bool bearishSfpConfirmed = barstate.isconfirmed and bearSfpActive and bearSfpRecoverySeen and close < bearSfpOpposite and close[1] >= bearSfpOpposite and close < open and directionalClose <= 0.40
bool bullishSfpConfirmed = barstate.isconfirmed and bullSfpActive and bullSfpRecoverySeen and close > bullSfpOpposite and close[1] <= bullSfpOpposite and close > open and directionalClose >= 0.60
float longExtremeDepth = 20.0 * clamp01((dynamicLow - nz(lowCriticalExtreme, dynamicLow)) / math.max(dynamicLow, 1.0))
float shortExtremeDepth = 20.0 * clamp01((nz(highCriticalExtreme, dynamicHigh) - dynamicHigh) / math.max(100.0 - dynamicHigh, 1.0))
bool reversalLongContextPass = not bearImpulseRecent or (bullAbsorptionSeen and exhLongQuality >= 0.60 * transferMin) or (bullDivergenceSeen and longSweepSeen)
bool reversalShortContextPass = not bullImpulseRecent or (bearAbsorptionSeen and exhShortQuality >= 0.60 * transferMin) or (bearDivergenceSeen and shortSweepSeen)
float reversalLongQuality = (bullSfpActive ? 20.0 : 0.0) + (bullSfpRecoverySeen ? 15.0 : 0.0) + (bullishSfpConfirmed ? 25.0 : 0.0) + 10.0 * longCloseQuality + 10.0 * clamp01(volumePercentile / 100.0) + 10.0 * clamp01(bullAbsorptionRecentQuality / 100.0) + 15.0 * clamp01(exhLongQuality / 100.0) + (bullFvg ? 10.0 : 0.0) + longExtremeDepth
float reversalShortQuality = (bearSfpActive ? 20.0 : 0.0) + (bearSfpRecoverySeen ? 15.0 : 0.0) + (bearishSfpConfirmed ? 25.0 : 0.0) + 10.0 * shortCloseQuality + 10.0 * clamp01(volumePercentile / 100.0) + 10.0 * clamp01(bearAbsorptionRecentQuality / 100.0) + 15.0 * clamp01(exhShortQuality / 100.0) + (bearFvg ? 10.0 : 0.0) + shortExtremeDepth
//=============================================================================
// Experimental MORPHEUS time table. It never creates direction by itself.
//=============================================================================
isMorpheusMinute(int h, int m) =>
    bool universal = m == 22 or m == 33 or m == 44 or m == 55
    bool custom = switch h
        1  => m == 18 or m == 29 or m == 32
        2  => m == 1 or m == 5 or m == 11
        3  => m == 2 or m == 8 or m == 20
        4  => m == 3 or m == 9 or m == 18 or m == 30
        5  => m == 4 or m == 10 or m == 15
        6  => m == 5 or m == 50
        7  => m == 6
        8  => m == 1 or m == 7
        9  => m == 0 or m == 8
        10 => m == 0 or m == 9 or m == 51
        11 => m == 0 or m == 4 or m == 10
        12 => m == 5 or m == 11
        13 => m == 6 or m == 12
        14 => m == 1 or m == 13 or m == 31
        15 => m == 2 or m == 8 or m == 14 or m == 20 or m == 30 or m == 41
        16 => m == 3 or m == 9 or m == 15 or m == 30 or m == 51
        17 => m == 0 or m == 4 or m == 8 or m == 16
        18 => m == 5 or m == 17 or m == 37 or m == 50
        19 => m == 6 or m == 12 or m == 18 or m == 36
        20 => m == 7 or m == 14 or m == 19 or m == 27
        21 => m == 2 or m == 4 or m == 8 or m == 14 or m == 20
        22 => m == 3 or m == 9 or m == 15 or m == 21 or m == 27 or m == 30 or m == 51
        23 => m == 4 or m == 10 or m == 16
        => false
    universal or custom
inTimingWindow(int h, int m, int tolerance) =>
    bool found = false
    for delta = -tolerance to tolerance
        int wrapped = (h * 60 + m + delta + 1440) % 1440
        int testHour = int(math.floor(wrapped / 60))
        int testMinute = wrapped % 60
        if isMorpheusMinute(testHour, testMinute)
            found := true
    found
int timingHour = hour(time, timeZone)
int timingMinute = minute(time, timeZone)
bool timingWindow = inTimingWindow(timingHour, timingMinute, timingTol)
float softBonus = timingMode == "Soft bonus" and timingWindow ? timingBonus : 0.0
bool hardTimingPass = timingMode != "Hard gate" or timingWindow
longBreakQuality := clamp(longBreakQuality + softBonus, 0.0, 100.0)
shortBreakQuality := clamp(shortBreakQuality + softBonus, 0.0, 100.0)
longAcceptedBreakQuality := clamp(longAcceptedBreakQuality + softBonus, 0.0, 100.0)
shortAcceptedBreakQuality := clamp(shortAcceptedBreakQuality + softBonus, 0.0, 100.0)
exhLongQuality := clamp(exhLongQuality + softBonus, 0.0, 100.0)
exhShortQuality := clamp(exhShortQuality + softBonus, 0.0, 100.0)
continuationLongQuality := clamp(continuationLongQuality + softBonus, 0.0, 100.0)
continuationShortQuality := clamp(continuationShortQuality + softBonus, 0.0, 100.0)
reversalLongQuality := clamp(reversalLongQuality + softBonus, 0.0, 100.0)
reversalShortQuality := clamp(reversalShortQuality + softBonus, 0.0, 100.0)
//=============================================================================
// LEGACY RESEARCH STATES + CAUSAL AUCTION RESPONSE v7.0
// Critical exhaustion is a potential-energy sensor, not a direct entry.
// Evidence is aggregated additively in log-odds space, so one missing observation
// cannot collapse the complete model to zero. Reliability is learned with delayed,
// already-known returns; current signals never use their own future outcome.
//=============================================================================
// Main cycle: 0 = initial discovery, +1 = a BUY was confirmed and SELL is next,
// -1 = a SELL was confirmed and BUY is next.
var int cyclePhase = 0
var int lastLongSignal = -100000
var int lastShortSignal = -100000
var int lastLongRoute = 0
var int lastShortRoute = 0
var float lastCycleSignalPrice = na
var float lastCycleSignalAtr = na
var int lastCycleSignalBar = -100000
var bool expectedOppositeCriticalSeen = false
var int expectedOppositeCriticalBar = -100000
var int cycleResyncCount = 0
bool elasticBuyResync = false
bool elasticSellResync = false
if barstate.isconfirmed
    if cyclePhase == 1 and criticalHighNow
        expectedOppositeCriticalSeen := true
        expectedOppositeCriticalBar := bar_index
    if cyclePhase == -1 and criticalLowNow
        expectedOppositeCriticalSeen := true
        expectedOppositeCriticalBar := bar_index
    bool cycleLockExpired = bar_index - lastCycleSignalBar >= cycleResyncBars
    bool failedOppositeExpired = expectedOppositeCriticalSeen and bar_index - expectedOppositeCriticalBar >= cycleResyncGraceBars
    elasticBuyResync := enforceAlternation and cyclePhase == 1 and criticalLowNow and (cycleLockExpired or failedOppositeExpired)
    elasticSellResync := enforceAlternation and cyclePhase == -1 and criticalHighNow and (cycleLockExpired or failedOppositeExpired)
    if elasticBuyResync or elasticSellResync
        cyclePhase := 0
        expectedOppositeCriticalSeen := false
        expectedOppositeCriticalBar := -100000
        cycleResyncCount += 1
bool cycleMayBuy = not enforceAlternation or cyclePhase <= 0
bool cycleMaySell = not enforceAlternation or cyclePhase >= 0
var float bottomReservoir = 0.0
var float topReservoir = 0.0
var float bottomReservoirPeak = 0.0
var float topReservoirPeak = 0.0
var float bottomCycleExtremeIndex = na
var float topCycleExtremeIndex = na
var float bottomCycleExtremePrice = na
var float topCycleExtremePrice = na
var int bottomCycleArmBar = -100000
var int topCycleArmBar = -100000
float bottomInstantDepth = clamp01(0.25 + 0.75 * math.max(dynamicLow - exhaustion, 0.0) / math.max(dynamicLow, 1.0))
float topInstantDepth = clamp01(0.25 + 0.75 * math.max(exhaustion - dynamicHigh, 0.0) / math.max(100.0 - dynamicHigh, 1.0))
float cycleEffortFactor = 0.55 + 0.45 * aerfVolumeEffort
if barstate.isconfirmed
    if not cycleMayBuy or bar_index - bottomCycleArmBar > cycleArmMemory
        bottomReservoir := 0.0
        bottomReservoirPeak := 0.0
        bottomCycleExtremeIndex := na
        bottomCycleExtremePrice := na
        bottomCycleArmBar := -100000
    else if not criticalLowNow
        bottomReservoir := clamp01(bottomReservoir * cycleReservoirDecay)
    if not cycleMaySell or bar_index - topCycleArmBar > cycleArmMemory
        topReservoir := 0.0
        topReservoirPeak := 0.0
        topCycleExtremeIndex := na
        topCycleExtremePrice := na
        topCycleArmBar := -100000
    else if not criticalHighNow
        topReservoir := clamp01(topReservoir * cycleReservoirDecay)
    if criticalLowNow and cycleMayBuy
        bool freshBottomEpisode = bar_index - bottomCycleArmBar > cycleArmMemory
        bottomReservoir := freshBottomEpisode ? bottomInstantDepth * cycleEffortFactor : clamp01(cycleReservoirDecay * bottomReservoir + (1.0 - cycleReservoirDecay) * bottomInstantDepth * cycleEffortFactor)
        bottomReservoirPeak := freshBottomEpisode ? bottomReservoir : math.max(bottomReservoirPeak, bottomReservoir)
        bottomCycleExtremeIndex := freshBottomEpisode ? exhaustion : math.min(nz(bottomCycleExtremeIndex, exhaustion), exhaustion)
        bottomCycleExtremePrice := freshBottomEpisode ? low : math.min(nz(bottomCycleExtremePrice, low), low)
        bottomCycleArmBar := bar_index
    else if cycleMayBuy and bar_index - bottomCycleArmBar <= cycleArmMemory and not na(bottomCycleExtremePrice)
        bottomCycleExtremePrice := math.min(bottomCycleExtremePrice, low)
    if criticalHighNow and cycleMaySell
        bool freshTopEpisode = bar_index - topCycleArmBar > cycleArmMemory
        topReservoir := freshTopEpisode ? topInstantDepth * cycleEffortFactor : clamp01(cycleReservoirDecay * topReservoir + (1.0 - cycleReservoirDecay) * topInstantDepth * cycleEffortFactor)
        topReservoirPeak := freshTopEpisode ? topReservoir : math.max(topReservoirPeak, topReservoir)
        topCycleExtremeIndex := freshTopEpisode ? exhaustion : math.max(nz(topCycleExtremeIndex, exhaustion), exhaustion)
        topCycleExtremePrice := freshTopEpisode ? high : math.max(nz(topCycleExtremePrice, high), high)
        topCycleArmBar := bar_index
    else if cycleMaySell and bar_index - topCycleArmBar <= cycleArmMemory and not na(topCycleExtremePrice)
        topCycleExtremePrice := math.max(topCycleExtremePrice, high)
bool bottomCycleArmed = cycleMayBuy and bar_index - bottomCycleArmBar <= cycleArmMemory and bottomReservoirPeak >= cycleMinReservoir and not na(bottomCycleExtremeIndex)
bool topCycleArmed = cycleMaySell and bar_index - topCycleArmBar <= cycleArmMemory and topReservoirPeak >= cycleMinReservoir and not na(topCycleExtremeIndex)
float exhaustionVelocity = ta.ema(exhaustion - exhaustion[1], 2)
float exhaustionAcceleration = exhaustionVelocity - exhaustionVelocity[1]
float priceVelocityAtr = ta.ema(atr > 0 ? (close - close[1]) / atr : 0.0, 3)
float priceAccelerationAtr = priceVelocityAtr - priceVelocityAtr[1]
float bottomIndexRecovery = bottomCycleArmed ? math.max(exhaustion - bottomCycleExtremeIndex, 0.0) : 0.0
float topIndexRecovery = topCycleArmed ? math.max(topCycleExtremeIndex - exhaustion, 0.0) : 0.0
float bottomTurnEvidence = bottomCycleArmed ? clamp01(0.55 * clamp01(bottomIndexRecovery / math.max(2.0 * cycleRecoveryPoints, 0.01)) + 0.30 * clamp01(math.max(exhaustionVelocity, 0.0) / 3.0) + 0.15 * clamp01(math.max(exhaustionAcceleration, 0.0) / 2.0)) : 0.0
float topTurnEvidence = topCycleArmed ? clamp01(0.55 * clamp01(topIndexRecovery / math.max(2.0 * cycleRecoveryPoints, 0.01)) + 0.30 * clamp01(math.max(-exhaustionVelocity, 0.0) / 3.0) + 0.15 * clamp01(math.max(-exhaustionAcceleration, 0.0) / 2.0)) : 0.0
float bottomPriceEvidence = bottomCycleArmed ? clamp01(0.45 * clamp01(math.max(priceVelocityAtr, 0.0) / 0.60) + 0.30 * clamp01(math.max(priceAccelerationAtr, 0.0) / 0.40) + 0.15 * (close > open ? directionalClose : 0.0) + (longMicroBreak ? 0.20 : 0.0)) : 0.0
float topPriceEvidence = topCycleArmed ? clamp01(0.45 * clamp01(math.max(-priceVelocityAtr, 0.0) / 0.60) + 0.30 * clamp01(math.max(-priceAccelerationAtr, 0.0) / 0.40) + 0.15 * (close < open ? 1.0 - directionalClose : 0.0) + (shortMicroBreak ? 0.20 : 0.0)) : 0.0
float bottomFlowEvidence = bottomCycleArmed ? clamp01(0.30 * (aerfReady ? bullModelMismatch : bullGeometryAbsorption) + 0.20 * bullDriveDecay + 0.20 * bullOpposingControl + 0.30 * clamp01(bullAbsorptionRecentQuality / 100.0)) : 0.0
float topFlowEvidence = topCycleArmed ? clamp01(0.30 * (aerfReady ? bearModelMismatch : bearGeometryAbsorption) + 0.20 * bearDriveDecay + 0.20 * bearOpposingControl + 0.30 * clamp01(bearAbsorptionRecentQuality / 100.0)) : 0.0
float bottomStructureEvidence = bottomCycleArmed ? clamp01((longMicroBreak ? 0.30 : 0.0) + (bullRejection ? 0.20 : 0.0) + (longSweepSeen ? 0.20 : 0.0) + (bullDivergenceSeen ? 0.20 : 0.0) + (bullSfpRecoverySeen ? 0.15 : 0.0) + (bullishSfpConfirmed ? 0.20 : 0.0)) : 0.0
float topStructureEvidence = topCycleArmed ? clamp01((shortMicroBreak ? 0.30 : 0.0) + (bearRejection ? 0.20 : 0.0) + (shortSweepSeen ? 0.20 : 0.0) + (bearDivergenceSeen ? 0.20 : 0.0) + (bearSfpRecoverySeen ? 0.15 : 0.0) + (bearishSfpConfirmed ? 0.20 : 0.0)) : 0.0
float bottomContinuationRisk = bottomCycleArmed ? clamp01((strongBearImpulse ? 0.55 : 0.0) + (bearImpulseRecent ? 0.20 : 0.0) + 0.25 * clamp01(math.max(-priceVelocityAtr, 0.0) / 0.80)) : 0.0
float topContinuationRisk = topCycleArmed ? clamp01((strongBullImpulse ? 0.55 : 0.0) + (bullImpulseRecent ? 0.20 : 0.0) + 0.25 * clamp01(math.max(priceVelocityAtr, 0.0) / 0.80)) : 0.0
// Completed-leg maturity prevents a minor counter-move from being mistaken for a
// new full cycle immediately after the opposite signal.
float cycleReferenceAtr = math.max(nz(lastCycleSignalAtr, atr), syminfo.mintick)
float bottomLegMoveAtr = cyclePhase == -1 and not na(lastCycleSignalPrice) and not na(bottomCycleExtremePrice) ? math.max(lastCycleSignalPrice - bottomCycleExtremePrice, 0.0) / cycleReferenceAtr : 99.0
float topLegMoveAtr = cyclePhase == 1 and not na(lastCycleSignalPrice) and not na(topCycleExtremePrice) ? math.max(topCycleExtremePrice - lastCycleSignalPrice, 0.0) / cycleReferenceAtr : 99.0
int cycleLegAge = bar_index - lastCycleSignalBar
bool bottomLegMature = cyclePhase == 0 or na(lastCycleSignalPrice) or (cycleLegAge >= cycleMinLegBars and bottomLegMoveAtr >= cycleMinLegAtr)
bool topLegMature = cyclePhase == 0 or na(lastCycleSignalPrice) or (cycleLegAge >= cycleMinLegBars and topLegMoveAtr >= cycleMinLegAtr)
bool bottomStrongTurn = bullishSfpConfirmed or (bullDivergenceSeen and (longSweepSeen or bullRejection)) or (longSweepSeen and bullRejection)
bool topStrongTurn = bearishSfpConfirmed or (bearDivergenceSeen and (shortSweepSeen or bearRejection)) or (shortSweepSeen and bearRejection)
bool bottomCounterTrend = strongBearImpulse or (bearImpulseRecent and priceVelocityAtr < 0)
bool topCounterTrend = strongBullImpulse or (bullImpulseRecent and priceVelocityAtr > 0)
bool bottomTrendPass = not bottomCounterTrend or bottomStructureEvidence >= cycleStrongTrendStructure or bottomStrongTurn
bool topTrendPass = not topCounterTrend or topStructureEvidence >= cycleStrongTrendStructure or topStrongTurn
//=============================================================================
// Change-Point Reversal Authenticity (RCA)
// The current ATR-normalized return is scored against a predictive distribution
// frozen before the current close. A true reversal additionally needs an
// intrinsic-time directional change away from the live cycle extreme. This
// evidence is independent of the later control-break candle and is never based
// on a future pivot.
//=============================================================================
var float rcaPredictiveMean = 0.0
var float rcaPredictiveVariance = 0.25
float rcaObservation = atr > 0 ? clamp((close - close[1]) / atr, -3.0, 3.0) : 0.0
float rcaPriorMean = rcaPredictiveMean
float rcaPriorVariance = math.max(rcaPredictiveVariance, 0.04)
float rcaPredictiveScale = math.sqrt(rcaPriorVariance)
float rcaInnovationZ = clamp((rcaObservation - rcaPriorMean) / rcaPredictiveScale, -4.0, 4.0)
float bottomPriorAttack = clamp01(0.55 * clamp01(math.max(-rcaPriorMean, 0.0) / 0.16) + 0.45 * clamp01(math.max(-nz(midSlopeAtr[1]), 0.0) / 0.12))
float topPriorAttack = clamp01(0.55 * clamp01(math.max(rcaPriorMean, 0.0) / 0.16) + 0.45 * clamp01(math.max(nz(midSlopeAtr[1]), 0.0) / 0.12))
float bottomPredictiveSurprise = bottomPriorAttack * clamp01((rcaInnovationZ - 0.45) / 2.55)
float topPredictiveSurprise = topPriorAttack * clamp01((-rcaInnovationZ - 0.45) / 2.55)
float bottomDirectionalMoveAtr = bottomCycleArmed and not na(bottomCycleExtremePrice) and atr > 0 ? math.max(close - bottomCycleExtremePrice, 0.0) / atr : 0.0
float topDirectionalMoveAtr = topCycleArmed and not na(topCycleExtremePrice) and atr > 0 ? math.max(topCycleExtremePrice - close, 0.0) / atr : 0.0
float bottomDirectionalChange = 0.55 * clamp01(bottomDirectionalMoveAtr / rcaFastThresholdAtr) + 0.45 * clamp01(bottomDirectionalMoveAtr / rcaSlowThresholdAtr)
float topDirectionalChange = 0.55 * clamp01(topDirectionalMoveAtr / rcaFastThresholdAtr) + 0.45 * clamp01(topDirectionalMoveAtr / rcaSlowThresholdAtr)
float bottomAuctionFailure = math.max(bullModelMismatch, bullDriveDecay)
