// now. Both directional scores are mirrors of the same conserved process.
float bottomEvidenceVelocityNorm = clamp(bottomEvidenceVelocity / 0.90, -1.0, 1.0)
float topEvidenceVelocityNorm = clamp(topEvidenceVelocity / 0.90, -1.0, 1.0)
