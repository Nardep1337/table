float topExtremeIntegrity = topResolverPending and not na(topResolverExtreme) ? clamp01((topResolverExtreme - close + 0.15 * resolverAtr) / (0.65 * resolverAtr)) : 0.0
float bottomReversalFreshness = bottomResolverPending ? clamp01(0.24 * bottomLiveIndexRecovery + 0.24 * bottomLiveControl + 0.16 * bottomLiveMomentum + 0.12 * bottomLiveImpulse + 0.12 * bottomLiveClose + 0.12 * bottomExtremeIntegrity) : 0.0
float topReversalFreshness = topResolverPending ? clamp01(0.24 * topLiveIndexRecovery + 0.24 * topLiveControl + 0.16 * topLiveMomentum + 0.12 * topLiveImpulse + 0.12 * topLiveClose + 0.12 * topExtremeIntegrity) : 0.0
bool bottomSecondPriceVictory = close > high[1] and close > open and directionalClose >= 0.55 and priceVelocityAtr > 0 and bottomIndexStep >= 0
bool topSecondPriceVictory = close < low[1] and close < open and directionalClose <= 0.45 and priceVelocityAtr < 0 and topIndexStep >= 0
