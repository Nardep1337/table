float bottomCarDenominator = math.max(bottomCarTurnExp + bottomCarTakeoverExp + bottomCarContinuationExp, 0.001)
float topCarDenominator = math.max(topCarTurnExp + topCarTakeoverExp + topCarContinuationExp, 0.001)
float bottomCarTurnProbability = bottomCarTurnExp / bottomCarDenominator
float bottomCarTakeoverProbability = bottomCarTakeoverExp / bottomCarDenominator
float bottomCarContinuationProbability = bottomCarContinuationExp / bottomCarDenominator
