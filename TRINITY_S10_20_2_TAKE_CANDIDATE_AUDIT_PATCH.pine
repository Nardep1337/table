        topContAcceptStreak := 0
        bottomContStage := 0
        topContStage := 0
        bottomContAttackBar := -100000
        topContAttackBar := -100000
        bottomContDefenseBar := -100000
        topContDefenseBar := -100000
        bottomContFrontier := na
        topContFrontier := na
        bottomContAttackAtr := na
        topContAttackAtr := na
        bottomContRenewalLevel := na
        topContRenewalLevel := na
        bottomContRenewalBar := -100000
        topContRenewalBar := -100000
        bottomContRenewalSeen := false
        topContRenewalSeen := false
        bottomTerminalTransferSeen := false
        topTerminalTransferSeen := false
        bottomFreshnessHoldSeen := false
