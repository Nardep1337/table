// Dashboard-only aggregate projections removed from the global body. The
// Strategy Tester remains authoritative, while the exact-bar TAKE audit is
// still rendered by renderLeadShadowDashboard().
//=============================================================================
// Visuals, diagnostics and alerts
//=============================================================================
color bull = #00B884
color bear = #D84A7F
color neutral = #9AA0AA
color railColor = fastLeg == 1 ? bull : fastLeg == -1 ? bear : neutral
plot(showRail ? fastRail : na, "Kalman-Ratchet Rail", railColor, 2)
plot(showFLI ? fliLine : na, "Confirmed FLI", fliDir == 1 ? color.new(bull, 20) : fliDir == -1 ? color.new(bear, 20) : neutral, 2, plot.style_linebr)
plot(showStructure ? resistanceTop : na, "Resistance Zone Top", color.new(bear, 35), 1, plot.style_stepline)
plot(showStructure ? resistanceBottom : na, "Resistance Zone Bottom", color.new(bear, 72), 1, plot.style_stepline)
plot(showStructure ? supportTop : na, "Support Zone Top", color.new(bull, 72), 1, plot.style_stepline)
plot(showStructure ? supportBottom : na, "Support Zone Bottom", color.new(bull, 35), 1, plot.style_stepline)
barcolor(colorBars ? color.new(railColor, 55) : na)
