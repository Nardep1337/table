        bearSfpRecoverySeen := false
        longArmBar := na
        shortArmBar := na
        longSweepBar := na
        shortSweepBar := na
        longRecoveryBar := na
        shortRecoveryBar := na
        lowCriticalEpisode := false
        highCriticalEpisode := false
    if sellSignal
        lastShortSignal := bar_index
        lastShortRoute := sellSignalRoute
        cyclePhase := -1
        expectedOppositeCriticalSeen := false
        expectedOppositeCriticalBar := -100000
        lastCycleSignalPrice := close
        lastCycleSignalAtr := math.max(atr, syminfo.mintick)
        lastCycleSignalBar := bar_index
        shortAcceptTop := na
