            array.set(strategyFreshnessCounts, 0, array.get(strategyFreshnessCounts, 0) + 1)
    if sellSignal and sellSignalRoute == 10
        if strategySellEveStale
            array.set(strategyFreshnessCounts, 3, array.get(strategyFreshnessCounts, 3) + 1)
        else
            array.set(strategyFreshnessCounts, 2, array.get(strategyFreshnessCounts, 2) + 1)
// Rolling outcome audit. Same-bar target/stop collisions are scored conservatively as a stop.
// Otherwise it stores the first resolved outcome, exact expiry result, MFE and MAE in ATR.
pushRolling(array<float> values, float value, int limit) =>
    array.push(values, value)
    if array.size(values) > limit
        array.shift(values)
positiveRate(array<float> values) =>
    float positives = 0.0
    int count = array.size(values)
    if count > 0
        for rateIndex = 0 to count - 1
            positives += array.get(values, rateIndex) > 0 ? 1.0 : 0.0
    count > 0 ? 100.0 * positives / count : na
safeAverage(array<float> values) =>
    array.size(values) > 0 ? array.avg(values) : na
//=============================================================================
// UNIQUE EPISODE EVENT AUDIT v10.18.5 — telemetry only
// Each EVE episode contributes at most one DECAY, takeover and reversal sample.
// All six streams use the same stop-first 1.00 / 0.75 ATR, 12-bar audit.
//=============================================================================
eventSamples(EventOutcomeAudit audit) =>
    array.size(audit.results)
eventWinRate(EventOutcomeAudit audit) =>
    positiveRate(audit.results)
eventExpectancy(EventOutcomeAudit audit) =>
    safeAverage(audit.results)
eventAverageX(EventOutcomeAudit audit) =>
    safeAverage(audit.resultX)
eventAverageLag(EventOutcomeAudit audit) =>
    safeAverage(audit.resultLag)
//=============================================================================
// LEAD SHADOW EVALUATOR v10.18 — telemetry only
// Uses the existing fixed target/stop/horizon audit and never feeds execution.
//=============================================================================
leadShadowStep(array<float> entries, array<float> atrs, array<int> sides, array<int> bars, array<int> states, array<int> conversionStates, array<float> results, array<float> buyResults, array<float> sellResults, array<float> conversions, array<float> victoryBars, array<float> victoryEdges) =>
    if barstate.isconfirmed
        if bottomEveLeadPulse or topEveLeadPulse
            int leadSide = bottomEveLeadPulse ? 1 : -1
            array.push(entries, close)
            array.push(atrs, math.max(atr, syminfo.mintick))
            array.push(sides, leadSide)
            array.push(bars, bar_index)
            array.push(states, 0)
            array.push(conversionStates, 0)
        int leadCount = array.size(entries)
        if leadCount > 0 and (bottomEvePulse or topEvePulse)
            int victorySide = bottomEvePulse ? 1 : -1
            for leadReverse = 0 to leadCount - 1
                int leadIndex = leadCount - 1 - leadReverse
                int leadAge = bar_index - array.get(bars, leadIndex)
                bool conversionMatch = array.get(conversionStates, leadIndex) == 0 and array.get(sides, leadIndex) == victorySide and leadAge >= 0 and leadAge <= evaluationBars
                if conversionMatch
                    array.set(conversionStates, leadIndex, 1)
                    pushRolling(conversions, 1.0, auditWindow)
                    float conversionBars = victorySide == 1 ? bottomVictoryLeadBars : topVictoryLeadBars
                    float conversionEdge = victorySide == 1 ? bottomVictoryLeadEdgeAtr : topVictoryLeadEdgeAtr
                    if not na(conversionBars)
                        pushRolling(victoryBars, conversionBars, auditWindow)
                    if not na(conversionEdge)
                        pushRolling(victoryEdges, conversionEdge, auditWindow)
                    break
        if leadCount > 0
            for leadIndex = 0 to leadCount - 1
                int leadAge = bar_index - array.get(bars, leadIndex)
                if array.get(states, leadIndex) == 0 and leadAge > 0
                    float leadEntry = array.get(entries, leadIndex)
                    float leadAtr = array.get(atrs, leadIndex)
                    int leadSide = array.get(sides, leadIndex)
                    float leadMfe = leadSide == 1 ? (high - leadEntry) / leadAtr : (leadEntry - low) / leadAtr
                    float leadMae = leadSide == 1 ? (leadEntry - low) / leadAtr : (high - leadEntry) / leadAtr
                    bool leadTargetHit = leadMfe >= evaluationTargetAtr
                    bool leadStopHit = leadMae >= evaluationStopAtr
                    bool leadExpired = leadAge >= evaluationBars
                    if leadTargetHit or leadStopHit or leadExpired
                        float leadResult = leadTargetHit and not leadStopHit ? evaluationTargetAtr : leadStopHit ? -evaluationStopAtr : leadSide * (close - leadEntry) / leadAtr
                        array.set(states, leadIndex, leadResult > 0 ? 1 : -1)
                        pushRolling(results, leadResult, auditWindow)
                        if leadSide == 1
                            pushRolling(buyResults, leadResult, auditWindow)
                        else
                            pushRolling(sellResults, leadResult, auditWindow)
                if array.get(conversionStates, leadIndex) == 0 and leadAge >= evaluationBars
                    array.set(conversionStates, leadIndex, -1)
                    pushRolling(conversions, 0.0, auditWindow)
// Runtime-safe build: the legacy rolling lead-shadow arrays are intentionally
// not instantiated. They never participated in entries/exits and duplicated
// the exact-bar TAKE audit retained below.
var array<float> auditEntry = array.new_float()
var array<float> auditAtr = array.new_float()
var array<int> auditSide = array.new_int()
var array<int> auditRoute = array.new_int()
var array<int> auditBar = array.new_int()
var array<int> auditState = array.new_int()
var array<float> auditMfe = array.new_float()
var array<float> auditMae = array.new_float()
var array<float> allResults = array.new_float()
var array<float> allMfe = array.new_float()
var array<float> allMae = array.new_float()
var array<float> brkResults = array.new_float()
var array<float> brkMfe = array.new_float()
var array<float> brkMae = array.new_float()
var array<float> brkLongResults = array.new_float()
var array<float> brkShortResults = array.new_float()
var array<float> standardRevResults = array.new_float()
var array<float> standardRevMfe = array.new_float()
var array<float> standardRevMae = array.new_float()
var array<float> transferredRevResults = array.new_float()
var array<float> transferredRevMfe = array.new_float()
var array<float> transferredRevMae = array.new_float()
var array<float> terminalRevResults = array.new_float()
var array<float> terminalRevMfe = array.new_float()
var array<float> terminalRevMae = array.new_float()
var array<float> carResults = array.new_float()
var array<float> carMfe = array.new_float()
var array<float> carMae = array.new_float()
var array<float> phaseResults = array.new_float()
var array<float> phaseMfe = array.new_float()
var array<float> phaseMae = array.new_float()
var array<float> exhResults = array.new_float()
var array<float> exhMfe = array.new_float()
var array<float> exhMae = array.new_float()
var array<float> exhLongResults = array.new_float()
var array<float> exhShortResults = array.new_float()
var array<float> contDirectResults = array.new_float()
var array<float> contRenewalResults = array.new_float()
var array<float> revResults = array.new_float()
var array<float> revMfe = array.new_float()
var array<float> revMae = array.new_float()
var array<float> revLongResults = array.new_float()
var array<float> revShortResults = array.new_float()
if barstate.isconfirmed
    if buySignal
        array.push(auditEntry, close)
        array.push(auditAtr, math.max(atr, syminfo.mintick))
        array.push(auditSide, 1)
        array.push(auditRoute, buySignalRoute)
        array.push(auditBar, bar_index)
        array.push(auditState, 0)
        array.push(auditMfe, 0.0)
        array.push(auditMae, 0.0)
    if sellSignal
        array.push(auditEntry, close)
        array.push(auditAtr, math.max(atr, syminfo.mintick))
        array.push(auditSide, -1)
        array.push(auditRoute, sellSignalRoute)
        array.push(auditBar, bar_index)
        array.push(auditState, 0)
        array.push(auditMfe, 0.0)
        array.push(auditMae, 0.0)
    int auditSize = array.size(auditEntry)
    if auditSize > 0
        for auditIndex = 0 to auditSize - 1
            if array.get(auditState, auditIndex) == 0
                int signalBar = array.get(auditBar, auditIndex)
                int age = bar_index - signalBar
                if age > 0
                    float entryPrice = array.get(auditEntry, auditIndex)
                    float signalAtr = array.get(auditAtr, auditIndex)
                    int side = array.get(auditSide, auditIndex)
                    float currentMfe = side == 1 ? (high - entryPrice) / signalAtr : (entryPrice - low) / signalAtr
                    float currentMae = side == 1 ? (entryPrice - low) / signalAtr : (high - entryPrice) / signalAtr
                    float maximumMfe = math.max(array.get(auditMfe, auditIndex), currentMfe)
                    float maximumMae = math.max(array.get(auditMae, auditIndex), currentMae)
                    array.set(auditMfe, auditIndex, maximumMfe)
                    array.set(auditMae, auditIndex, maximumMae)
                    bool targetHit = currentMfe >= evaluationTargetAtr
                    bool stopHit = currentMae >= evaluationStopAtr
                    bool expired = age >= evaluationBars
                    bool resolved = targetHit or stopHit or expired
                    if resolved
                        float resultAtr = targetHit and not stopHit ? evaluationTargetAtr : stopHit ? -evaluationStopAtr : side * (close - entryPrice) / signalAtr
                        array.set(auditState, auditIndex, resultAtr > 0 ? 1 : -1)
                        pushRolling(allResults, resultAtr, auditWindow)
                        pushRolling(allMfe, maximumMfe, auditWindow)
                        pushRolling(allMae, maximumMae, auditWindow)
                        int route = array.get(auditRoute, auditIndex)
                        float routeSuccess = resultAtr > 0 ? 1.0 : 0.0
                        float posteriorDecay = 1.0 - resolverPriorRate
                        // Discounted Beta update. A route learns only from its own
                        // completed outcome and its own direction/episode type.
                        if (route == 1 or route == 5 or route == 6 or route == 8) and side == 1
                            bottomRevAlpha := 2.0 + posteriorDecay * (bottomRevAlpha - 2.0) + routeSuccess
                            bottomRevBeta := 3.0 + posteriorDecay * (bottomRevBeta - 3.0) + (1.0 - routeSuccess)
                            bottomRevOutcomes += 1
                        else if (route == 1 or route == 5 or route == 6 or route == 8) and side == -1
                            topRevAlpha := 2.0 + posteriorDecay * (topRevAlpha - 2.0) + routeSuccess
                            topRevBeta := 3.0 + posteriorDecay * (topRevBeta - 3.0) + (1.0 - routeSuccess)
                            topRevOutcomes += 1
                        else if (route == 4 or route == 7) and side == -1
                            bottomContAlpha := 2.5 + posteriorDecay * (bottomContAlpha - 2.5) + routeSuccess
                            bottomContBeta := 2.5 + posteriorDecay * (bottomContBeta - 2.5) + (1.0 - routeSuccess)
                            bottomContOutcomes += 1
                        else if (route == 4 or route == 7) and side == 1
                            topContAlpha := 2.5 + posteriorDecay * (topContAlpha - 2.5) + routeSuccess
                            topContBeta := 2.5 + posteriorDecay * (topContBeta - 2.5) + (1.0 - routeSuccess)
                            topContOutcomes += 1
                        if route == 1 or route == 5 or route == 6 or route == 8 or route == 9 or route == 10
                            pushRolling(brkResults, resultAtr, auditWindow)
                            pushRolling(brkMfe, maximumMfe, auditWindow)
                            pushRolling(brkMae, maximumMae, auditWindow)
                            if side == 1
                                pushRolling(brkLongResults, resultAtr, auditWindow)
                            else
                                pushRolling(brkShortResults, resultAtr, auditWindow)
                            if route == 9
                                pushRolling(carResults, resultAtr, auditWindow)
                                pushRolling(carMfe, maximumMfe, auditWindow)
                                pushRolling(carMae, maximumMae, auditWindow)
                            else if route == 1
                                pushRolling(standardRevResults, resultAtr, auditWindow)
                                pushRolling(standardRevMfe, maximumMfe, auditWindow)
                                pushRolling(standardRevMae, maximumMae, auditWindow)
                            else if route == 5
                                pushRolling(phaseResults, resultAtr, auditWindow)
                                pushRolling(phaseMfe, maximumMfe, auditWindow)
                                pushRolling(phaseMae, maximumMae, auditWindow)
                            else if route == 6
                                pushRolling(transferredRevResults, resultAtr, auditWindow)
                                pushRolling(transferredRevMfe, maximumMfe, auditWindow)
                                pushRolling(transferredRevMae, maximumMae, auditWindow)
                            else
                                pushRolling(terminalRevResults, resultAtr, auditWindow)
                                pushRolling(terminalRevMfe, maximumMfe, auditWindow)
                                pushRolling(terminalRevMae, maximumMae, auditWindow)
                        else if route == 4 or route == 7
                            pushRolling(exhResults, resultAtr, auditWindow)
                            pushRolling(exhMfe, maximumMfe, auditWindow)
                            pushRolling(exhMae, maximumMae, auditWindow)
                            if side == 1
                                pushRolling(exhLongResults, resultAtr, auditWindow)
                            else
                                pushRolling(exhShortResults, resultAtr, auditWindow)
                            if route == 7
                                pushRolling(contRenewalResults, resultAtr, auditWindow)
                            else
                                pushRolling(contDirectResults, resultAtr, auditWindow)
                        else
                            pushRolling(revResults, resultAtr, auditWindow)
                            pushRolling(revMfe, maximumMfe, auditWindow)
                            pushRolling(revMae, maximumMae, auditWindow)
                            if side == 1
                                pushRolling(revLongResults, resultAtr, auditWindow)
                            else
                                pushRolling(revShortResults, resultAtr, auditWindow)
    while array.size(auditEntry) > 300
        array.shift(auditEntry)
        array.shift(auditAtr)
        array.shift(auditSide)
        array.shift(auditRoute)
        array.shift(auditBar)
        array.shift(auditState)
        array.shift(auditMfe)
        array.shift(auditMae)
    if buySignal
        lastLongSignal := bar_index
        lastLongRoute := buySignalRoute
        cyclePhase := 1
        expectedOppositeCriticalSeen := false
        expectedOppositeCriticalBar := -100000
        lastCycleSignalPrice := close
        lastCycleSignalAtr := math.max(atr, syminfo.mintick)
        lastCycleSignalBar := bar_index
        longAcceptTop := na
        longAcceptBottom := na
        bullPullbackBar := -100000
        bullPullbackEnergy := 0.0
        bullPullbackQuality := 0.0
        bottomReservoir := 0.0
        topReservoir := 0.0
        bottomReservoirPeak := 0.0
        topReservoirPeak := 0.0
        bottomCycleExtremeIndex := na
        topCycleExtremeIndex := na
        bottomCycleExtremePrice := na
        topCycleExtremePrice := na
        bottomCycleArmBar := -100000
        topCycleArmBar := -100000
