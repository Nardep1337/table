float topEvidenceAccelerationNorm = clamp(topEvidenceAcceleration / 0.70, -1.0, 1.0)
float bottomReversalVictory = bottomResolverLogRatio + evidenceVelocityWeight * bottomEvidenceVelocityNorm + evidenceAccelerationWeight * bottomEvidenceAccelerationNorm
float topReversalVictory = topResolverLogRatio + evidenceVelocityWeight * topEvidenceVelocityNorm + evidenceAccelerationWeight * topEvidenceAccelerationNorm
float bottomContinuationVictoryScore = -bottomResolverLogRatio - evidenceVelocityWeight * bottomEvidenceVelocityNorm - evidenceAccelerationWeight * bottomEvidenceAccelerationNorm
float topContinuationVictoryScore = -topResolverLogRatio - evidenceVelocityWeight * topEvidenceVelocityNorm - evidenceAccelerationWeight * topEvidenceAccelerationNorm
// Latency relaxes proof by only 20% and persistence by one bar. It never forces
