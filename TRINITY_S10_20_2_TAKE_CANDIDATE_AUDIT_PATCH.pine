//=============================================================================
float carResidualZ = clamp(aerfResidual / math.max(aerfResidualScale, 0.03), -3.0, 3.0)
float carForceZ = clamp(aerfSignedForce / math.max(aerfForceScale, 0.02), -3.0, 3.0)
float carResponseZ = clamp(aerfPriceResponse / math.max(aerfResidualScale, 0.03), -3.0, 3.0)
// Positive bottom shock = sellers apply effort but receive less downside than
// the adaptive model expected. Top shock is its exact mirror.
float bottomCarInefficiencyShock = clamp01(math.max(-carForceZ, 0.0) / 2.0) * clamp01(math.max(carResidualZ, 0.0) / 2.0)
float topCarInefficiencyShock = clamp01(math.max(carForceZ, 0.0) / 2.0) * clamp01(math.max(-carResidualZ, 0.0) / 2.0)
var float bottomCarCusum = 0.0
var float topCarCusum = 0.0
var bool bottomCarTurnSeen = false
var bool topCarTurnSeen = false
var float bottomCarTurnPeak = 0.0
var float topCarTurnPeak = 0.0
var int bottomCarTurnBar = -100000
var int topCarTurnBar = -100000
