float topResolverLogRatio = topResolverPending ? clamp(topPriorLogRatio + topResolverEvidence, -8.0, 8.0) : 0.0
float bottomResolverReversal = bottomResolverPending ? sigmoidSafe(bottomResolverLogRatio) : 0.0
float topResolverReversal = topResolverPending ? sigmoidSafe(topResolverLogRatio) : 0.0
float bottomResolverContinuation = bottomResolverPending ? 1.0 - bottomResolverReversal : 0.0
float topResolverContinuation = topResolverPending ? 1.0 - topResolverReversal : 0.0
// Evidence Kinematics: level says how much proof exists; velocity says whether
