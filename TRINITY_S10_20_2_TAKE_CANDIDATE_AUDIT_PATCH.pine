float bottomCarAbsorption = clamp01(math.max(bottomTerminalAbsorption, bottomFlowEvidence))
float topCarAbsorption = clamp01(math.max(topTerminalAbsorption, topFlowEvidence))
float bottomCarDepth = bottomCycleArmed and not na(bottomCycleExtremeIndex) ? clamp01((dynamicLow - bottomCycleExtremeIndex + cycleRecoveryPoints) / math.max(dynamicLow, 1.0)) : 0.0
float topCarDepth = topCycleArmed and not na(topCycleExtremeIndex) ? clamp01((topCycleExtremeIndex - dynamicHigh + cycleRecoveryPoints) / math.max(100.0 - dynamicHigh, 1.0)) : 0.0
float bottomCarTurnScore = bottomCycleArmed ? clamp01(0.30 * clamp01(bottomCarCusum / 1.50) + 0.22 * bottomCarInefficiencyShock + 0.18 * bottomCarAttackBrake + 0.16 * bottomCarAbsorption + 0.14 * math.max(bottomCarDepth, bottomTurnEvidence)) : 0.0
float topCarTurnScore = topCycleArmed ? clamp01(0.30 * clamp01(topCarCusum / 1.50) + 0.22 * topCarInefficiencyShock + 0.18 * topCarAttackBrake + 0.16 * topCarAbsorption + 0.14 * math.max(topCarDepth, topTurnEvidence)) : 0.0
float bottomCarOpposingResponse = clamp01(0.34 * clamp01(math.max(carResidualZ, 0.0) / 2.0) + 0.22 * clamp01(math.max(carForceZ, 0.0) / 2.0) + 0.18 * bottomPriceEvidence + 0.14 * bottomStructureEvidence + 0.12 * clamp01(math.max(priceAccelerationAtr, 0.0) / 0.45))
float topCarOpposingResponse = clamp01(0.34 * clamp01(math.max(-carResidualZ, 0.0) / 2.0) + 0.22 * clamp01(math.max(-carForceZ, 0.0) / 2.0) + 0.18 * topPriceEvidence + 0.14 * topStructureEvidence + 0.12 * clamp01(math.max(-priceAccelerationAtr, 0.0) / 0.45))
// Three normalized hypotheses: latent turn, opposing takeover, old-direction
