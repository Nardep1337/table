float topContinuationAuthenticity = clamp01(0.30 * topRenewalQuality + 0.20 * topMomentumAcceptance + 0.18 * topIndexRelapse + 0.16 * continuationRangeExpansion + 0.16 * topRenewalAcceleration - 0.28 * topTerminalScore)
