        bullPullbackBar := -100000
        bullPullbackEnergy := 0.0
        bullPullbackQuality := 0.0
    if strongBullImpulse and not bearPullbackEvent
        bearPullbackBar := -100000
        bearPullbackEnergy := 0.0
        bearPullbackQuality := 0.0
bool bullPullbackActive = bar_index - bullPullbackBar <= continuationMemory
bool bearPullbackActive = bar_index - bearPullbackBar <= continuationMemory
float bullContinuationBreak = ta.highest(high[1], 2)
float bearContinuationBreak = ta.lowest(low[1], 2)
bool bullContinuationRecovery = bullPullbackActive and close > bullContinuationBreak and close > open and directionalClose >= 0.58 and aerfSignedForce > 0 and biasMid == 1 and not strongBearImpulse
bool bearContinuationRecovery = bearPullbackActive and close < bearContinuationBreak and close < open and directionalClose <= 0.42 and aerfSignedForce < 0 and biasMid == -1 and not strongBullImpulse
float bullContinuationForce = clamp01(math.max(aerfSignedForce, 0.0) / (2.0 * aerfForceScale))
float bearContinuationForce = clamp01(math.max(-aerfSignedForce, 0.0) / (2.0 * aerfForceScale))
float bullContinuationStructure = bullContinuationRecovery ? 0.70 + 0.30 * longCloseQuality : 0.0
float bearContinuationStructure = bearContinuationRecovery ? 0.70 + 0.30 * shortCloseQuality : 0.0
float bullContinuationProduct = bullPullbackEnergy * bullPullbackQuality * bullContinuationForce * bullContinuationStructure * (0.50 + 0.50 * longRoomQuality)
float bearContinuationProduct = bearPullbackEnergy * bearPullbackQuality * bearContinuationForce * bearContinuationStructure * (0.50 + 0.50 * shortRoomQuality)
float continuationLongQuality = 100.0 * math.pow(math.max(bullContinuationProduct, 0.0), 0.20)
float continuationShortQuality = 100.0 * math.pow(math.max(bearContinuationProduct, 0.0), 0.20)
bool continuationLongReadyBase = barstate.isconfirmed and bullContinuationRecovery and longChopPass
bool continuationShortReadyBase = barstate.isconfirmed and bearContinuationRecovery and shortChopPass
// Confirmed SFP state. Exhaustion arms the scenario; price must reclaim and then break the opposite extreme.
float sfpPivotHigh = ta.pivothigh(high, sfpLeft, 1)
float sfpPivotLow = ta.pivotlow(low, sfpLeft, 1)
var float lastSfpHigh = na
var float lastSfpLow = na
var int lastSfpHighBar = -100000
var int lastSfpLowBar = -100000
if barstate.isconfirmed
    if not na(sfpPivotHigh)
        lastSfpHigh := sfpPivotHigh
        lastSfpHighBar := bar_index - 1
    if not na(sfpPivotLow)
        lastSfpLow := sfpPivotLow
        lastSfpLowBar := bar_index - 1
int bearSfpAge = bar_index - lastSfpHighBar
int bullSfpAge = bar_index - lastSfpLowBar
bool bearishSfpEvent = barstate.isconfirmed and shortArmed and not na(lastSfpHigh) and bearSfpAge >= 1 and bearSfpAge <= sfpMaxAge and high > lastSfpHigh and open < lastSfpHigh and close < lastSfpHigh and directionalClose <= 0.45
bool bullishSfpEvent = barstate.isconfirmed and longArmed and not na(lastSfpLow) and bullSfpAge >= 1 and bullSfpAge <= sfpMaxAge and low < lastSfpLow and open > lastSfpLow and close > lastSfpLow and directionalClose >= 0.55
var float bearSfpSwingLevel = na
var float bearSfpSweepExtreme = na
var float bearSfpOpposite = na
var float bearSfpRecoveryLevel = na
var int bearSfpArmBar = -100000
var bool bearSfpRecoverySeen = false
var float bullSfpSwingLevel = na
var float bullSfpSweepExtreme = na
var float bullSfpOpposite = na
var float bullSfpRecoveryLevel = na
var int bullSfpArmBar = -100000
var bool bullSfpRecoverySeen = false
if barstate.isconfirmed
    if bearishSfpEvent
        float oppositeLow = low[1]
