// REV freshness remains fully active in the signal engine and is shown as H
// in the live SET dashboard. Its two duplicate Data Window plots are omitted
// to remain below TradingView's 64-plot runtime limit.
plot(cyclePhase, "CYCLE Phase (+1 seek SELL / -1 seek BUY)", display = display.data_window)
plot(cycleResyncCount, "ELASTIC Cycle Resync Count", display = display.data_window)
plot(bottomResolverPending ? 1 : topResolverPending ? -1 : 0, "SET Pending (+BOTTOM/-TOP)", display = display.data_window)
plot(resolverReversalCount, "SET Reversal Count", display = display.data_window)
plot(resolverContinuationCount, "SET Continuation Count", display = display.data_window)
plot(resolverBalance, "SET Conservation Balance (must be 0)", display = display.data_window)
plot(buySignal ? buySignalRoute : sellSignal ? -sellSignalRoute : 0, "Signal Driver (+BUY/-SELL, 1/5/6/8 REV, 3 STRUCT, 9 CAR, 10 EVE)", display = display.data_window)
string buySignalMode = routeName(buySignalRoute)
string sellSignalMode = routeName(sellSignalRoute)
if buySignal and (strategyShowStaleEveSignals or not strategyBuyEveStale)
    string buyFreshnessText = buySignalRoute == 10 and not na(strategyBuyDefenseAge) ? " D+" + str.tostring(strategyBuyDefenseAge, "#") : ""
    string buyExecutionState = strategyBuyEveStale ? " STALE" : not strategyBuyRoutePass ? " FILTERED" : strategy.position_size > 0 ? " HOLD" : ""
    label.new(bar_index, low, "BUY " + buySignalMode + buyExecutionState + buyFreshnessText + "\nH " + str.tostring(buySignalProbability, "#.0"), yloc = yloc.belowbar, style = label.style_label_up, color = strategyBuyEveStale ? color.new(neutral, 20) : not strategyBuyRoutePass ? color.new(neutral, 20) : strategy.position_size > 0 ? color.new(bull, 45) : bull, textcolor = color.white, size = size.small)
if sellSignal and (strategyShowStaleEveSignals or not strategySellEveStale)
    string sellFreshnessText = sellSignalRoute == 10 and not na(strategySellDefenseAge) ? " D+" + str.tostring(strategySellDefenseAge, "#") : ""
    string sellExecutionState = strategySellEveStale ? " STALE" : not strategySellRoutePass ? " FILTERED" : strategy.position_size < 0 ? " HOLD" : ""
    label.new(bar_index, high, "SELL " + sellSignalMode + sellExecutionState + sellFreshnessText + "\nH " + str.tostring(sellSignalProbability, "#.0"), yloc = yloc.abovebar, style = label.style_label_down, color = strategySellEveStale ? color.new(neutral, 20) : not strategySellRoutePass ? color.new(neutral, 20) : strategy.position_size < 0 ? color.new(bear, 45) : bear, textcolor = color.white, size = size.small)
signedMetric(float value) =>
    na(value) ? "—" : (value >= 0 ? "+" : "") + str.tostring(value, "#.00")
var table leadDash = table.new(position.middle_right, 2, 13, frame_color = color.new(neutral, 55), frame_width = 1)
eventAuditText(EventOutcomeAudit audit) =>
    int samples = eventSamples(audit)
    float winRate = eventWinRate(audit)
    float expectancy = eventExpectancy(audit)
    str.tostring(samples) + " / " + (samples > 0 ? str.tostring(winRate, "#.0") + "% / E" + signedMetric(expectancy) : "—")
eventXLagText(EventOutcomeAudit buyAudit, EventOutcomeAudit sellAudit) =>
    "B " + signedMetric(eventAverageX(buyAudit)) + "/" + signedMetric(eventAverageLag(buyAudit)) + " | T " + signedMetric(eventAverageX(sellAudit)) + "/" + signedMetric(eventAverageLag(sellAudit))
eventAuditColor(EventOutcomeAudit audit) =>
    int samples = eventSamples(audit)
    float expectancy = eventExpectancy(audit)
    samples >= 10 and expectancy > 0 ? bull : samples >= 10 and expectancy < 0 ? bear : neutral
renderLeadShadowDashboard(table panel) =>
    if barstate.islast and showLeadDash
        color bg = color.new(#10141C, 5)
        table.cell(panel, 0, 0, "TAKE VALID v10.20", text_color = color.white, bgcolor = bg)
        table.cell(panel, 1, 0, "RAW vs EXEC", text_color = color.orange, bgcolor = bg)
        table.cell(panel, 0, 1, "DECAY BUY n/win/EV", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 1, eventAuditText(eventTelemetry.audits.decayBuy), text_color = eventAuditColor(eventTelemetry.audits.decayBuy), bgcolor = bg)
        table.cell(panel, 0, 2, "DECAY SELL n/win/EV", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 2, eventAuditText(eventTelemetry.audits.decaySell), text_color = eventAuditColor(eventTelemetry.audits.decaySell), bgcolor = bg)
        table.cell(panel, 0, 3, "TAKE BUY n/win/EV", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 3, eventAuditText(eventTelemetry.audits.takeoverBuy), text_color = eventAuditColor(eventTelemetry.audits.takeoverBuy), bgcolor = bg)
        table.cell(panel, 0, 4, "TAKE SELL n/win/EV", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 4, eventAuditText(eventTelemetry.audits.takeoverSell), text_color = eventAuditColor(eventTelemetry.audits.takeoverSell), bgcolor = bg)
        table.cell(panel, 0, 5, "REV BUY n/win/EV", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 5, eventAuditText(eventTelemetry.audits.reversalBuy), text_color = eventAuditColor(eventTelemetry.audits.reversalBuy), bgcolor = bg)
        table.cell(panel, 0, 6, "REV SELL n/win/EV", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 6, eventAuditText(eventTelemetry.audits.reversalSell), text_color = eventAuditColor(eventTelemetry.audits.reversalSell), bgcolor = bg)
        table.cell(panel, 0, 7, "DECAY X / lag B|T", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 7, eventXLagText(eventTelemetry.audits.decayBuy, eventTelemetry.audits.decaySell), text_color = neutral, bgcolor = bg)
        table.cell(panel, 0, 8, "TAKE X / lag B|T", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 8, eventXLagText(eventTelemetry.audits.takeoverBuy, eventTelemetry.audits.takeoverSell), text_color = neutral, bgcolor = bg)
        table.cell(panel, 0, 9, "REV X / lag B|T", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 9, eventXLagText(eventTelemetry.audits.reversalBuy, eventTelemetry.audits.reversalSell), text_color = neutral, bgcolor = bg)
        table.cell(panel, 0, 10, "Episodes / victory B|T", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 10, str.tostring(eventTelemetry.bottom.episodes) + "/" + str.tostring(eventTelemetry.bottom.victories) + " | " + str.tostring(eventTelemetry.top.episodes) + "/" + str.tostring(eventTelemetry.top.victories), text_color = neutral, bgcolor = bg)
        table.cell(panel, 0, 11, "Cancels B / T", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 11, str.tostring(eventTelemetry.bottom.cancels) + " / " + str.tostring(eventTelemetry.top.cancels), text_color = neutral, bgcolor = bg)
        table.cell(panel, 0, 12, "EXEC TAKE n/win/EV", text_color = neutral, bgcolor = bg)
        table.cell(panel, 1, 12, eventAuditText(strategyTakeBuyAdmission.executedAudit), text_color = eventAuditColor(strategyTakeBuyAdmission.executedAudit), bgcolor = bg)
renderLeadShadowDashboard(leadDash)
//=============================================================================
// Shadow Tail Laboratory — telemetry only, never participates in execution
//=============================================================================
labFmt(float value) =>
    na(value) ? "n" : str.tostring(value, "#.00")
labReset(array<float> data) =>
    array.fill(data, na)
labObserve(array<float> data, int age, int direction, float entryPrice, float entryAtr, float bullControl, float bearControl) =>
    float unit = math.max(entryAtr, syminfo.mintick)
    float favorableBar = direction == 1 ? math.max(high - entryPrice, 0.0) / unit : math.max(entryPrice - low, 0.0) / unit
    float adverseBar = direction == 1 ? math.max(entryPrice - low, 0.0) / unit : math.max(high - entryPrice, 0.0) / unit
    float maxFavorable = math.max(nz(array.get(data, 16), 0.0), favorableBar)
    float maxAdverse = math.max(nz(array.get(data, 17), 0.0), adverseBar)
    array.set(data, 16, maxFavorable)
    array.set(data, 17, maxAdverse)
    int slot = age == 2 ? 0 : age == 4 ? 4 : age == 8 ? 8 : age == 12 ? 12 : -1
    if slot >= 0
        float progress = direction * (close - entryPrice) / unit
        float controlEdge = direction == 1 ? bullControl - bearControl : bearControl - bullControl
        array.set(data, slot, maxFavorable)
        array.set(data, slot + 1, maxAdverse)
        array.set(data, slot + 2, progress)
        array.set(data, slot + 3, controlEdge)
labWriteTiming(array<float> data, float extremeLag, float armLag, float decayLag, float defenseLag, float displacementAtr, float leadBars, float leadEdgeAtr, float leadScore) =>
    array.set(data, 18, extremeLag)
    array.set(data, 19, armLag)
    array.set(data, 20, decayLag)
    array.set(data, 21, defenseLag)
    array.set(data, 22, displacementAtr)
    array.set(data, 23, leadBars)
    array.set(data, 24, leadEdgeAtr)
    array.set(data, 25, leadScore)
labObserveBuyLaunchGovernor(array<float> data, bool enabled, int age, int direction, float entryPrice, float entryAtr, float bullControl, float bearControl) =>
    bool triggerNow = false
    if enabled and direction == 1 and age >= 2 and age <= 4 and na(array.get(data, 26))
        float unit = math.max(entryAtr, syminfo.mintick)
        float maxFavorable = nz(array.get(data, 16), 0.0)
        float maxAdverse = nz(array.get(data, 17), 0.0)
        float progress = (close - entryPrice) / unit
        float controlEdge = bullControl - bearControl
        triggerNow := maxFavorable <= 0.10 and progress <= 0.0 and controlEdge <= -0.05
        if triggerNow
            array.set(data, 26, age)
            array.set(data, 27, progress)
            array.set(data, 28, maxFavorable)
            array.set(data, 29, maxAdverse)
            array.set(data, 30, controlEdge)
    triggerNow
leadShadowCsvTag() =>
    // Legacy LS telemetry removed from the runtime-safe build. Exact TAKE
    // event and executed-entry audits remain available through TKB/TKX.
    ""
leadFunnelOne(string prefix, LeadFunnel funnel) =>
    // D,S,R,M,X,K,G,C,T are a sequential causal funnel.
    // Q=max score, N=min displacement ATR, V=max signed kinematic margin.
    " " + prefix + "(" + str.tostring(funnel.defense) + "," + str.tostring(funnel.score) + "," + str.tostring(funnel.rising) + "," + str.tostring(funnel.dominance) + "," + str.tostring(funnel.displacement) + "," + str.tostring(funnel.kinematic) + "," + str.tostring(funnel.geometry) + "," + str.tostring(funnel.candle) + "," + str.tostring(funnel.trend) + "," + labFmt(funnel.maxScore) + "," + labFmt(funnel.minDisplacement) + "," + labFmt(funnel.maxKinematic) + ")"
leadFunnelCsvTag() =>
    leadFunnelOne("LFB", bottomLeadFunnel) + leadFunnelOne("LFT", topLeadFunnel)
leadDisplacementOne(string prefix, LeadFunnel funnel) =>
    // M, <=.85/1/1.25/1.5/2/2.5/3 ATR, min/avg/max X after M,
    // then independent K/G/C/T and their full conjunction without X.
    float averageDominantX = funnel.dominance > 0 ? funnel.dominantSumDisplacement / funnel.dominance : na
    " " + prefix + "(" + str.tostring(funnel.dominance) + "," + str.tostring(funnel.displacement) + "," + str.tostring(funnel.x100) + "," + str.tostring(funnel.x125) + "," + str.tostring(funnel.x150) + "," + str.tostring(funnel.x200) + "," + str.tostring(funnel.x250) + "," + str.tostring(funnel.x300) + "," + labFmt(funnel.dominantMinDisplacement) + "," + labFmt(averageDominantX) + "," + labFmt(funnel.dominantMaxDisplacement) + "," + str.tostring(funnel.dominantKinematic) + "," + str.tostring(funnel.dominantGeometry) + "," + str.tostring(funnel.dominantCandle) + "," + str.tostring(funnel.dominantTrend) + "," + str.tostring(funnel.dominantAllWithoutDisplacement) + ")"
leadDisplacementCsvTag() =>
    leadDisplacementOne("DXB", bottomLeadFunnel) + leadDisplacementOne("DXT", topLeadFunnel)
eventAuditOne(string prefix, EventOutcomeAudit audit) =>
    int samples = eventSamples(audit)
    " " + prefix + "(" + str.tostring(samples) + "," + labFmt(eventWinRate(audit)) + "," + labFmt(eventExpectancy(audit)) + "," + labFmt(eventAverageX(audit)) + "," + labFmt(eventAverageLag(audit)) + ")"
decayEventCsvTag() =>
    eventAuditOne("DEB", eventTelemetry.audits.decayBuy) + eventAuditOne("DET", eventTelemetry.audits.decaySell) +
      eventAuditOne("TKB", eventTelemetry.audits.takeoverBuy) + eventAuditOne("TKT", eventTelemetry.audits.takeoverSell) +
      eventAuditOne("RVB", eventTelemetry.audits.reversalBuy) + eventAuditOne("RVT", eventTelemetry.audits.reversalSell) +
      eventAuditOne("TKX", strategyTakeBuyAdmission.executedAudit)
labTag(string reason, array<float> data, float entryAtrPct) =>
    reason + "|LAB V" + labFmt(entryAtrPct) +
      " L2(" + labFmt(array.get(data, 0)) + "," + labFmt(array.get(data, 1)) + "," + labFmt(array.get(data, 2)) + "," + labFmt(array.get(data, 3)) + ")" +
      " L4(" + labFmt(array.get(data, 4)) + "," + labFmt(array.get(data, 5)) + "," + labFmt(array.get(data, 6)) + "," + labFmt(array.get(data, 7)) + ")" +
      " L8(" + labFmt(array.get(data, 8)) + "," + labFmt(array.get(data, 9)) + "," + labFmt(array.get(data, 10)) + "," + labFmt(array.get(data, 11)) + ")" +
      " L12(" + labFmt(array.get(data, 12)) + "," + labFmt(array.get(data, 13)) + "," + labFmt(array.get(data, 14)) + "," + labFmt(array.get(data, 15)) + ")" +
      " TIM(" + labFmt(array.get(data, 18)) + "," + labFmt(array.get(data, 19)) + "," + labFmt(array.get(data, 20)) + "," + labFmt(array.get(data, 21)) + "," + labFmt(array.get(data, 22)) + "," + labFmt(array.get(data, 23)) + "," + labFmt(array.get(data, 24)) + "," + labFmt(array.get(data, 25)) + ")" +
      " LG(" + labFmt(array.get(data, 26)) + "," + labFmt(array.get(data, 27)) + "," + labFmt(array.get(data, 28)) + "," + labFmt(array.get(data, 29)) + "," + labFmt(array.get(data, 30)) + ")" +
      leadShadowCsvTag() +
      leadFunnelCsvTag() +
      leadDisplacementCsvTag() +
      decayEventCsvTag()
memoryWithoutTailService(int firstIndex, float longWin, float longLoss, float shortWin, float shortLoss) =>
    float nextLongWin = longWin
    float nextLongLoss = longLoss
    float nextShortWin = shortWin
    float nextShortLoss = shortLoss
    for memoryIndex = firstIndex to strategy.closedtrades - 1
        string exitComment = strategy.closedtrades.exit_comment(memoryIndex)
        bool isTailService = not na(exitComment) and str.contains(exitComment, "TAIL RECOVERY DE-RISK")
        if not isTailService
            float tradeReturn = strategy.closedtrades.profit_percent(memoryIndex)
            bool wasLong = strategy.closedtrades.entry_id(memoryIndex) == "LONG"
            if wasLong
                nextLongWin := strategyMemoryDecay * nextLongWin + math.max(tradeReturn, 0.0)
                nextLongLoss := strategyMemoryDecay * nextLongLoss + math.max(-tradeReturn, 0.0)
            else
                nextShortWin := strategyMemoryDecay * nextShortWin + math.max(tradeReturn, 0.0)
                nextShortLoss := strategyMemoryDecay * nextShortLoss + math.max(-tradeReturn, 0.0)
    [nextLongWin, nextLongLoss, nextShortWin, nextShortLoss]
tailRecoveryStep(array<float> data, int age, bool alreadyFlagged) =>
    bool nextFlagged = alreadyFlagged
    bool reduceNow = false
    if age == 8
        float mfe8 = array.get(data, 8)
        float mae8 = array.get(data, 9)
        float progress8 = array.get(data, 10)
        float control8 = array.get(data, 11)
        nextFlagged := not na(mfe8) and not na(mae8) and not na(progress8) and not na(control8) and mfe8 <= 0.50 and mae8 >= 0.20 and progress8 <= -0.10 and control8 <= -0.05
    if age == 12 and nextFlagged
        float mfe8 = array.get(data, 8)
        float mfe12 = array.get(data, 12)
        float progress12 = array.get(data, 14)
        reduceNow := not na(mfe8) and not na(mfe12) and not na(progress12) and mfe12 - mfe8 <= 0.10 and progress12 <= 0.0
    [nextFlagged, reduceNow]
//=============================================================================
// Strategy execution — BUY/SELL mathematics above remains unchanged
//=============================================================================
var int strategyTradeDirection = 0
var int strategyTradeRoute = 0
var int strategyEntryBar = -100000
var int strategyLastEntrySignalBar = -100000
var int strategyLogicalBreakStreak = 0
var bool strategyInvalidationActive = false
var float strategyInvalidationEvidence = 0.0
var bool strategyTargetExtended = false
var bool strategyBaseTargetTouched = false
var bool strategyTargetExtensionAllowed = false
var float strategyMaxFavorableProgress = 0.0
var int strategyLaunchFailureStreak = 0
var float strategyEntryPrice = na
var float strategyEntryAtr = na
var float strategyLogicalStop = na
var float strategyHardStop = na
var float strategyLogicalDistance = na
var float strategyHardDistance = na
var float strategyTarget = na
var float strategyTargetDistance = na
var float strategyBaseTarget = na
var float strategyExtendedTarget = na
var float strategyBaseTargetDistance = na
var float strategyExtendedTargetDistance = na
var int strategyMemoryClosedCount = 0
var bool strategyTailFlagged = false
var bool strategyTailReduced = false
var float strategyLongMemoryWin = 2.0
var float strategyLongMemoryLoss = 1.5
var float strategyShortMemoryWin = 2.0
var float strategyShortMemoryLoss = 1.5
var line strategyLogicalGuide = na
var line strategyHardGuide = na
var line strategyTargetGuide = na
var bool strategyPendingLong = false
var bool strategyPendingShort = false
var int strategyPendingLongRoute = 0
var int strategyPendingShortRoute = 0
var int strategyPendingLongBar = -100000
var int strategyPendingShortBar = -100000
var float strategyPendingLongQuality = na
var float strategyPendingShortQuality = na
var float strategyPendingLongPrice = na
var float strategyPendingShortPrice = na
var float strategyPendingLongAtr = na
var float strategyPendingShortAtr = na
var float strategyPendingLongEvidence = 0.0
var float strategyPendingShortEvidence = 0.0
var float strategyPendingLongHigh = na
var float strategyPendingLongLow = na
var float strategyPendingShortHigh = na
var float strategyPendingShortLow = na
var float strategyPendingShortRegimeScore = na
var float strategyPendingShortRegimeSpread = na
var float strategyPendingShortRegimeDrift = na
var float strategyPendingShortFrontier = na
var float strategyPendingLongExtreme = na
var float strategyPendingShortExtreme = na
var bool strategyPendingLongProof1 = false
var bool strategyPendingLongProof2 = false
var bool strategyPendingShortProof1 = false
var bool strategyPendingShortProof2 = false
// Slots 0..15 contain MFE, MAE, close progress and control edge at 2/4/8/12.
// 16..17 are running MFE/MAE. 18..25 are causal timing telemetry:
// extreme lag, arm lag, decay lag, defense lag, victory displacement ATR,
// LEAD advance bars, LEAD price edge ATR and LEAD score.
// Slots 0..25 preserve the v10.13.1 audit contract. Slots 26..30 are shadow-only
// BUY Launch Governor telemetry: age, virtual progress, MFE, MAE, control edge.
var array<float> strategyLabData = array.new_float(31, na)
var float strategyTimingExtremeLag = na
var float strategyTimingArmLag = na
var float strategyTimingDecayLag = na
var float strategyTimingDefenseLag = na
var float strategyTimingDisplacementAtr = na
var float strategyTimingLeadBars = na
var float strategyTimingLeadEdgeAtr = na
var float strategyTimingLeadScore = na
bool strategyJustFlat = strategy.position_size == 0 and nz(strategy.position_size[1]) != 0
if strategyJustFlat
    if not na(strategyLogicalGuide)
        line.set_x2(strategyLogicalGuide, bar_index)
        strategyLogicalGuide := na
    if not na(strategyHardGuide)
        line.set_x2(strategyHardGuide, bar_index)
        strategyHardGuide := na
    if not na(strategyTargetGuide)
        line.set_x2(strategyTargetGuide, bar_index)
        strategyTargetGuide := na
    strategyTradeDirection := 0
    strategyTradeRoute := 0
    strategyEntryBar := -100000
    strategyLogicalBreakStreak := 0
    strategyInvalidationActive := false
    strategyInvalidationEvidence := 0.0
    strategyTargetExtended := false
    strategyBaseTargetTouched := false
    strategyTargetExtensionAllowed := false
    strategyMaxFavorableProgress := 0.0
    strategyLaunchFailureStreak := 0
    strategyEntryPrice := na
    strategyEntryAtr := na
    strategyLogicalStop := na
    strategyHardStop := na
    strategyLogicalDistance := na
    strategyHardDistance := na
    strategyTarget := na
    strategyTargetDistance := na
    strategyBaseTarget := na
    strategyExtendedTarget := na
    strategyBaseTargetDistance := na
    strategyExtendedTargetDistance := na
    strategyTailFlagged := false
    strategyTailReduced := false
    labReset(strategyLabData)
if strategy.closedtrades > strategyMemoryClosedCount
    [strategyNextLongWin, strategyNextLongLoss, strategyNextShortWin, strategyNextShortLoss] = memoryWithoutTailService(strategyMemoryClosedCount, strategyLongMemoryWin, strategyLongMemoryLoss, strategyShortMemoryWin, strategyShortMemoryLoss)
    strategyLongMemoryWin := strategyNextLongWin
    strategyLongMemoryLoss := strategyNextLongLoss
    strategyShortMemoryWin := strategyNextShortWin
    strategyShortMemoryLoss := strategyNextShortLoss
    strategyMemoryClosedCount := strategy.closedtrades
float strategyLongMemoryPf = strategyLongMemoryWin / math.max(strategyLongMemoryLoss, 0.0001)
float strategyShortMemoryPf = strategyShortMemoryWin / math.max(strategyShortMemoryLoss, 0.0001)
float strategyLongMemoryScale = strategyUseCapitalIntelligence ? clamp(math.pow(strategyLongMemoryPf / strategyMemoryTargetPf, strategyMemoryResponse), strategyMemoryMinScale, 1.0) : 1.0
float strategyShortMemoryScale = strategyUseCapitalIntelligence ? clamp(math.pow(strategyShortMemoryPf / strategyMemoryTargetPf, strategyMemoryResponse), strategyMemoryMinScale, 1.0) : 1.0
float strategyEquityQty = math.max(strategy.equity, 0.0) * strategyEquityPct * 0.01 / math.max(close * syminfo.pointvalue, syminfo.mintick)
float strategyExposureQty = math.max(strategy.equity, 0.0) * strategyMaxExposurePct * 0.01 / math.max(close * syminfo.pointvalue, syminfo.mintick)
float strategyCurrentWickAtr = strategySignalAtr > 0 ? math.max(high - math.max(open, close), math.min(open, close) - low) / strategySignalAtr : 0.0
float strategyAdaptiveNoiseAtr = clamp(nz(ta.sma(strategyCurrentWickAtr, strategyWickNoiseLookback), 0.0), 0.0, strategyMaxWickNoiseAtr)
float strategyBullControl = clamp01(0.34 * bullOpposingControl + 0.24 * math.max(impulseDirection, 0.0) + 0.18 * longCloseQuality + 0.12 * (bullStructure ? 1.0 : 0.0) + 0.12 * (strongBullImpulse ? 1.0 : 0.0))
float strategyBearControl = clamp01(0.34 * bearOpposingControl + 0.24 * math.max(-impulseDirection, 0.0) + 0.18 * shortCloseQuality + 0.12 * (bearStructure ? 1.0 : 0.0) + 0.12 * (strongBearImpulse ? 1.0 : 0.0))
bool strategyDeferredBuyPulse = false
bool strategyDeferredSellPulse = false
int strategyDeferredBuyRoute = 0
int strategyDeferredSellRoute = 0
float strategyDeferredBuyQuality = na
float strategyDeferredSellQuality = na
float strategyDeferredBuyProof = na
float strategyDeferredSellProof = na
float strategyDeferredSellTransition = na
if barstate.isconfirmed
    // A queued hypothesis is a flat-state opportunity, never a reservation
    // that may keep accumulating evidence while another trade is active.
    if strategy.position_size != 0
        strategyPendingLong := false
        strategyPendingShort := false
        strategyPendingLongEvidence := 0.0
        strategyPendingShortEvidence := 0.0
    // A new accepted raw signal always has priority over an older pending one.
    if buySignal and strategyBuyRoutePass and strategyBuyFreshnessPass
        strategyPendingLong := false
        strategyPendingLongEvidence := 0.0
    if sellSignal and strategySellRoutePass and strategySellFreshnessPass
        strategyPendingShort := false
        strategyPendingShortEvidence := 0.0
    // Any opposite signal invalidates a queued hypothesis before it may execute.
    if sellSignal and strategySellFreshnessPass
        strategyPendingLong := false
        strategyPendingLongEvidence := 0.0
    if buySignal and strategyBuyFreshnessPass
        strategyPendingShort := false
        strategyPendingShortEvidence := 0.0
    // Only flat-state filtered signals from an eligible route may become
    // grey reclaim candidates.
    if strategyUseDeferredAdmission and strategy.position_size == 0 and buySignal and strategyBuyFreshnessPass and not strategyBuyRoutePass and deferredRouteEligible(buySignalRoute, buySignalProbability, 1)
        strategyPendingLong := true
        strategyPendingLongRoute := buySignalRoute
        strategyPendingLongBar := bar_index
        strategyPendingLongQuality := buySignalProbability
        strategyPendingLongPrice := close
        strategyPendingLongAtr := strategySignalAtr
        strategyPendingLongEvidence := 0.0
        strategyPendingLongHigh := high
        strategyPendingLongLow := low
        strategyPendingLongExtreme := low
        strategyPendingLongProof1 := false
        strategyPendingLongProof2 := false
    if strategyUseDeferredAdmission and strategy.position_size == 0 and sellSignal and strategySellFreshnessPass and not strategySellRoutePass and deferredRouteEligible(sellSignalRoute, sellSignalProbability, -1)
        strategyPendingShort := true
        strategyPendingShortRoute := sellSignalRoute
        strategyPendingShortBar := bar_index
        strategyPendingShortQuality := sellSignalProbability
        strategyPendingShortPrice := close
        strategyPendingShortAtr := strategySignalAtr
        strategyPendingShortEvidence := 0.0
        strategyPendingShortHigh := high
        strategyPendingShortLow := low
        strategyPendingShortRegimeScore := strategyRegimeScore
        strategyPendingShortRegimeSpread := strategyRegimeSpreadAtr
        strategyPendingShortRegimeDrift := strategyRegimeDriftAtr
        strategyPendingShortFrontier := sellSignalRoute == 10 ? nz(topEve.frontier, low) : na
        strategyPendingShortExtreme := high
        strategyPendingShortProof1 := false
        strategyPendingShortProof2 := false
    // Ambiguous two-sided hypotheses contain no directional edge.
    if strategyPendingLong and strategyPendingShort
        strategyPendingLong := false
        strategyPendingShort := false
        strategyPendingLongEvidence := 0.0
        strategyPendingShortEvidence := 0.0
    if strategyPendingLong and bar_index > strategyPendingLongBar
        int pendingLongAge = bar_index - strategyPendingLongBar
        strategyPendingLongExtreme := math.min(nz(strategyPendingLongExtreme, low), low)
        float pendingLongProgress = strategyPendingLongAtr > 0 ? (close - strategyPendingLongPrice) / strategyPendingLongAtr : 0.0
        float pendingLongReclaimLevel = strategyPendingLongLow + strategyGreyReclaimFraction * math.max(strategyPendingLongHigh - strategyPendingLongLow, syminfo.mintick)
        bool pendingLongSweep = strategyPendingLongExtreme <= strategyPendingLongLow - 0.03 * strategyPendingLongAtr
        bool pendingLongHigherLow = low > strategyPendingLongLow
        bool pendingLongGeometry = close > pendingLongReclaimLevel and (pendingLongSweep or pendingLongHigherLow)
        bool pendingLongRailProof = (close > fastRail and fastRail >= nz(fastRail[1], fastRail)) or fliDir == 1
        bool pendingLongControlProof = strategyBullControl >= strategyDeferredControlMin and strategyBullControl >= nz(strategyBullControl[1], strategyBullControl)
        bool pendingLongImpulseBar = impulseDirection > 0.0 or strongBullImpulse
        bool pendingLongCandleProof = longCloseQuality >= 0.52 or close > open
        int pendingLongSupport = (pendingLongRailProof ? 1 : 0) + (pendingLongControlProof ? 1 : 0) + (pendingLongImpulseBar ? 1 : 0) + (pendingLongCandleProof ? 1 : 0)
        bool pendingLongQualifiedBar = pendingLongGeometry and pendingLongSupport >= 2
        int pendingLongProofCount = (pendingLongQualifiedBar ? 1 : 0) + (strategyPendingLongProof1 ? 1 : 0) + (strategyPendingLongProof2 ? 1 : 0)
        strategyPendingLongProof2 := strategyPendingLongProof1
        strategyPendingLongProof1 := pendingLongQualifiedBar
        float pendingLongPriceProof = clamp01(math.max(pendingLongProgress, 0.0) / 0.30)
        float pendingLongRouteFloor = deferredRouteMinimum(strategyPendingLongRoute, 1)
        float pendingLongRouteProof = 0.50 + 0.50 * clamp01((strategyPendingLongQuality - pendingLongRouteFloor) / math.max(100.0 - pendingLongRouteFloor, 1.0))
        float pendingLongImpulseProof = clamp01(0.50 + 0.50 * impulseDirection)
        float pendingLongScore = 0.25 * (pendingLongGeometry ? 1.0 : 0.0) + 0.15 * pendingLongPriceProof + 0.20 * strategyBullControl + 0.15 * (pendingLongRailProof ? 1.0 : 0.0) + 0.10 * pendingLongImpulseProof + 0.10 * longCloseQuality + 0.05 * pendingLongRouteProof
        strategyPendingLongEvidence := strategyDeferredEvidenceMemory * strategyPendingLongEvidence + pendingLongScore
        bool pendingLongExpired = pendingLongAge > strategyDeferredMemoryBars
        bool pendingLongInvalid = pendingLongProgress <= -strategyDeferredInvalidAtr
        bool pendingLongConfirmed = pendingLongProgress >= strategyDeferredMinMoveAtr and pendingLongProgress <= strategyDeferredMaxChaseAtr and strategyBullControl >= strategyDeferredControlMin and pendingLongProofCount >= strategyGreyProofBars and strategyPendingLongEvidence >= strategyDeferredEvidenceMin
        if pendingLongConfirmed and strategy.position_size == 0
            strategyDeferredBuyPulse := true
            strategyDeferredBuyRoute := strategyPendingLongRoute
            strategyDeferredBuyQuality := strategyPendingLongQuality
            strategyDeferredBuyProof := strategyPendingLongEvidence
            strategyPendingLong := false
            strategyPendingLongEvidence := 0.0
        else if pendingLongExpired or pendingLongInvalid
            strategyPendingLong := false
            strategyPendingLongEvidence := 0.0
    if strategyPendingShort and bar_index > strategyPendingShortBar
        int pendingShortAge = bar_index - strategyPendingShortBar
        bool pendingShortIsEveTransition = strategyUseAsymmetricEveTransition and strategyPendingShortRoute == 10
        strategyPendingShortExtreme := math.max(nz(strategyPendingShortExtreme, high), high)
        float pendingShortProgress = strategyPendingShortAtr > 0 ? (strategyPendingShortPrice - close) / strategyPendingShortAtr : 0.0
        float pendingShortReclaimLevel = strategyPendingShortHigh - strategyGreyReclaimFraction * math.max(strategyPendingShortHigh - strategyPendingShortLow, syminfo.mintick)
        bool pendingShortSweep = strategyPendingShortExtreme >= strategyPendingShortHigh + 0.03 * strategyPendingShortAtr
        bool pendingShortLowerHigh = high < strategyPendingShortHigh
        bool pendingShortGeometry = close < pendingShortReclaimLevel and (pendingShortSweep or pendingShortLowerHigh)
        bool pendingShortRailProof = (close < fastRail and fastRail <= nz(fastRail[1], fastRail)) or fliDir == -1
        bool pendingShortControlProof = strategyBearControl >= strategyDeferredControlMin and strategyBearControl >= nz(strategyBearControl[1], strategyBearControl)
        bool pendingShortImpulseBar = impulseDirection < 0.0 or strongBearImpulse
        bool pendingShortCandleProof = shortCloseQuality >= 0.52 or close < open
        int pendingShortSupport = (pendingShortRailProof ? 1 : 0) + (pendingShortControlProof ? 1 : 0) + (pendingShortImpulseBar ? 1 : 0) + (pendingShortCandleProof ? 1 : 0)
        bool pendingShortQualifiedBar = pendingShortGeometry and pendingShortSupport >= 2
        int pendingShortProofCount = (pendingShortQualifiedBar ? 1 : 0) + (strategyPendingShortProof1 ? 1 : 0) + (strategyPendingShortProof2 ? 1 : 0)
        strategyPendingShortProof2 := strategyPendingShortProof1
        strategyPendingShortProof1 := pendingShortQualifiedBar
        float pendingShortPriceProof = clamp01(math.max(pendingShortProgress, 0.0) / 0.30)
        float pendingShortRouteFloor = deferredRouteMinimum(strategyPendingShortRoute, -1)
        float pendingShortRouteProof = 0.50 + 0.50 * clamp01((strategyPendingShortQuality - pendingShortRouteFloor) / math.max(100.0 - pendingShortRouteFloor, 1.0))
        float pendingShortImpulseProof = clamp01(0.50 - 0.50 * impulseDirection)
        float pendingShortScore = 0.25 * (pendingShortGeometry ? 1.0 : 0.0) + 0.15 * pendingShortPriceProof + 0.20 * strategyBearControl + 0.15 * (pendingShortRailProof ? 1.0 : 0.0) + 0.10 * pendingShortImpulseProof + 0.10 * shortCloseQuality + 0.05 * pendingShortRouteProof
        strategyPendingShortEvidence := strategyDeferredEvidenceMemory * strategyPendingShortEvidence + pendingShortScore
        float pendingShortRegimeDrop = nz(strategyPendingShortRegimeScore, strategyRegimeScore) - strategyRegimeScore
        float pendingShortSpreadDrop = nz(strategyPendingShortRegimeSpread, strategyRegimeSpreadAtr) - strategyRegimeSpreadAtr
        bool pendingShortFrontierAccepted = not pendingShortIsEveTransition or (not na(strategyPendingShortFrontier) and close < strategyPendingShortFrontier - strategyEveTransitionFrontierBufferAtr * strategyPendingShortAtr)
        bool pendingShortTransitionEvidence = not pendingShortIsEveTransition or not strategyShortEveOpposingRegime or (pendingShortRegimeDrop >= strategyEveTransitionScoreDrop and pendingShortSpreadDrop >= strategyEveTransitionSpreadDrop and strategyRegimeDriftAtr <= nz(strategyPendingShortRegimeDrift, strategyRegimeDriftAtr) and not strongBullImpulse)
        int pendingShortMemoryBars = pendingShortIsEveTransition ? strategyEveTransitionMemoryBars : strategyDeferredMemoryBars
        bool pendingShortExpired = pendingShortAge > pendingShortMemoryBars
        bool pendingShortInvalid = pendingShortProgress <= -strategyDeferredInvalidAtr
        bool pendingShortConfirmed = pendingShortProgress >= strategyDeferredMinMoveAtr and pendingShortProgress <= strategyDeferredMaxChaseAtr and strategyBearControl >= strategyDeferredControlMin and pendingShortProofCount >= strategyGreyProofBars and strategyPendingShortEvidence >= strategyDeferredEvidenceMin and pendingShortFrontierAccepted and pendingShortTransitionEvidence
        if pendingShortConfirmed and strategy.position_size == 0
            strategyDeferredSellPulse := true
            strategyDeferredSellRoute := strategyPendingShortRoute
            strategyDeferredSellQuality := strategyPendingShortQuality
            strategyDeferredSellProof := strategyPendingShortEvidence
            strategyDeferredSellTransition := pendingShortRegimeDrop
            strategyPendingShort := false
            strategyPendingShortEvidence := 0.0
        else if pendingShortExpired or pendingShortInvalid
            strategyPendingShort := false
            strategyPendingShortEvidence := 0.0
    // A simultaneous confirmation is treated as uncertainty, not two orders.
    if strategyDeferredBuyPulse and strategyDeferredSellPulse
        strategyDeferredBuyPulse := false
        strategyDeferredSellPulse := false
float strategyDeferredBuyDefenseAge = strategyDeferredBuyRoute == 10 and bottomLead.defenseBar > -100000 ? bar_index - bottomLead.defenseBar : na
float strategyDeferredSellDefenseAge = strategyDeferredSellRoute == 10 and topLead.defenseBar > -100000 ? bar_index - topLead.defenseBar : na
bool strategyDeferredBuyFreshnessPass = not strategyUseEveFreshnessGate or strategyDeferredBuyRoute != 10 or na(strategyDeferredBuyDefenseAge) or strategyDeferredBuyDefenseAge <= strategyEveFreshnessBars
bool strategyDeferredSellFreshnessPass = not strategyUseEveFreshnessGate or strategyDeferredSellRoute != 10 or na(strategyDeferredSellDefenseAge) or strategyDeferredSellDefenseAge <= strategyEveFreshnessBars
bool strategyConfirmedExecuteBuySignal = (buySignal and strategyBuyRoutePass and strategyBuyFreshnessPass) or (strategyDeferredBuyPulse and strategyDeferredBuyFreshnessPass)
bool strategyConfirmedExecuteSellSignal = (sellSignal and strategySellRoutePass and strategySellFreshnessPass) or (strategyDeferredSellPulse and strategyDeferredSellFreshnessPass)
// Pine does not allow [] directly on a field of a user-defined object.
// Snapshot the field into a scalar series first; [1] then remains the exact
// confirmed takeover pulse from the previous bar.
bool strategyTakeBuyTakeoverPulseNow = eventTelemetry.bottom.takeoverPulse
var TakeCandidateAudit strategyTakeCandidateAudit = newTakeCandidateAudit()

bool strategyTakeCandidateNow =
     barstate.isconfirmed and
     strategyTakeBuyTakeoverPulseNow[1] and
     bottomCycleArmed and
     bottomEveState > 0 and bottomEveState < 4 and
     bottomEveTakeover > bottomEveContinuation

strategyTakeCandidateAudit.capture(
     strategyTakeCandidateNow,
     bottomEve.armBar,
     bottomEveTakeover,
     bottomEveContinuation,
     24)

strategyTakeBuyAdmission.step(strategyUseTakeBuyExecution, strategyUseTakeBuyNoiseGate, strategyTakeBuyTakeoverPulseNow[1], bottomCycleArmed, bottomEveState, bottomEve.armBar, bottomEveTakeover, bottomEveContinuation, bottomEveScore, eveDecisionBoundary, strategyUseRegimeRouter, strategyRegimeReady, strategyBearRegime, eveCounterRegimeMin, eveDominanceMargin, bottomStructureEvidence, strategy.position_size == 0, strategyConfirmedExecuteBuySignal, strategyConfirmedExecuteSellSignal, evaluationTargetAtr, evaluationStopAtr, evaluationBars, auditWindow)
bool strategyTakeBuyPulse = strategyTakeBuyAdmission.pulse
bool strategyExecuteBuySignal = strategyConfirmedExecuteBuySignal or strategyTakeBuyPulse
// Isolated execution lane: the causal lead candidate may open a new SHORT only
// while flat. It never closes/reverses LONG and never changes confirmed sellSignal.
bool strategyFlatLeadSellPulse = strategyUseFlatLeadSell and barstate.isconfirmed and strategy.position_size == 0 and not strategyExecuteBuySignal and not strategyConfirmedExecuteSellSignal and topEveLeadPulse and strategyShortEveRegimePass
bool strategyExecuteSellSignal = strategyConfirmedExecuteSellSignal or strategyFlatLeadSellPulse
int strategyExecuteBuyRoute = strategyTakeBuyPulse ? 10 : strategyDeferredBuyPulse ? strategyDeferredBuyRoute : buySignalRoute
int strategyExecuteSellRoute = strategyFlatLeadSellPulse ? 10 : strategyDeferredSellPulse ? strategyDeferredSellRoute : sellSignalRoute
float strategyExecuteBuyQuality = strategyTakeBuyPulse ? strategyTakeBuyAdmission.quality : strategyDeferredBuyPulse ? strategyDeferredBuyQuality : buySignalProbability
float strategyExecuteSellQuality = strategyFlatLeadSellPulse ? 100.0 * topLeadScore : strategyDeferredSellPulse ? strategyDeferredSellQuality : sellSignalProbability
float strategyExecuteSellTransition = strategyDeferredSellPulse ? nz(strategyDeferredSellTransition, 0.0) : 0.0
// Pure calculation services keep Pine's global/main body below its runtime IR
// limit. They do not create orders, labels, alerts, drawings or mutable state.
buildLongTradePlan(int route, float executionQuality, bool deferredPulse) =>
    bool exhaustionRoute = route == 9 or route == 10
    float reference = exhaustionRoute ? strategyLongCarReference : strategyLongStructReference
    float baseBufferAtr = exhaustionRoute ? strategyCarStopBufferAtr : strategyStructStopBufferAtr
    float minimumAtr = exhaustionRoute ? strategyCarMinLogicalStopAtr : strategyStructMinLogicalStopAtr
    float logicalDistance = math.max(close - (reference - (baseBufferAtr + strategyAdaptiveNoiseAtr) * strategySignalAtr), minimumAtr * strategySignalAtr)
    float hardDistance = logicalDistance + strategyHardStopExtraAtr * strategySignalAtr
    float sizingDistance = logicalDistance + strategySizingStopExtraAtr * strategySignalAtr
    float quality = clamp01((executionQuality - 50.0) / 50.0)
    float projectionDistance = clamp((exhaustionRoute ? strategyCarTargetBaseAtr : strategyStructTargetBaseAtr) + strategyTargetQualityBoostAtr * quality, strategyMinTargetAtr, strategyMaxTargetAtr) * strategySignalAtr
    float candidate = exhaustionRoute ? strategyLongCarEquilibrium : strategyLongStructObstacle
    float candidateDistance = not na(candidate) and candidate > close + strategyMinTargetAtr * strategySignalAtr ? candidate - close : na
    float targetDistance = not na(candidateDistance) ? math.min(projectionDistance, math.max(candidateDistance - strategyObstacleBufferAtr * strategySignalAtr, strategyMinTargetAtr * strategySignalAtr)) : projectionDistance
    bool obstacleLimited = not na(candidateDistance) and targetDistance < projectionDistance - syminfo.mintick
    float extendedDistance = obstacleLimited ? targetDistance : math.min(targetDistance + strategyTargetExtensionAtr * strategySignalAtr, strategyMaxTargetAtr * strategySignalAtr)
    float expectedRiskQty = math.max(strategy.equity, 0.0) * strategyRiskPct * 0.01 / math.max(sizingDistance * syminfo.pointvalue, syminfo.mintick)
    float catastropheRiskQty = math.max(strategy.equity, 0.0) * strategyCatastropheRiskPct * 0.01 / math.max(hardDistance * syminfo.pointvalue, syminfo.mintick)
    float riskQty = math.min(expectedRiskQty, catastropheRiskQty)
    float baseQty = strategySizeMode == "State-aware risk" ? math.min(riskQty, strategyExposureQty) : strategySizeMode == "Percent of equity" ? strategyEquityQty : strategyFixedQty
    float capitalScale = capitalIntelligenceScale(strategyUseCapitalIntelligence and strategySizeMode == "State-aware risk", baseQty, strategyExposureQty, strategyCapitalReferenceUtilization, strategyCapitalConvexity, strategyCapitalMinScale, strategyLongMemoryScale)
    float riskSurfaceScale = causalRiskSurfaceScale(strategyUseCausalRiskSurface and strategySizeMode == "State-aware risk", 1, capitalScale, 0.0, strategyRiskSurfaceFloor, strategyLongFragileCeiling, strategyLongFragileWidth, strategyShortUncertaintyCenter, strategyShortUncertaintyHalfWidth)
    float qty = baseQty * capitalScale * riskSurfaceScale * (deferredPulse ? strategyDeferredRiskScale : 1.0)
    [logicalDistance, hardDistance, targetDistance, extendedDistance, obstacleLimited, capitalScale, riskSurfaceScale, qty]
buildShortTradePlan(int route, float executionQuality, bool deferredPulse) =>
    bool exhaustionRoute = route == 9 or route == 10
    float reference = exhaustionRoute ? strategyShortCarReference : strategyShortStructReference
    float baseBufferAtr = exhaustionRoute ? strategyCarStopBufferAtr : strategyStructStopBufferAtr
    float minimumAtr = exhaustionRoute ? strategyCarMinLogicalStopAtr : strategyStructMinLogicalStopAtr
    float logicalDistance = math.max((reference + (baseBufferAtr + strategyAdaptiveNoiseAtr) * strategySignalAtr) - close, minimumAtr * strategySignalAtr)
    float hardDistance = logicalDistance + strategyHardStopExtraAtr * strategySignalAtr
    float sizingDistance = logicalDistance + strategySizingStopExtraAtr * strategySignalAtr
    float quality = clamp01((executionQuality - 50.0) / 50.0)
    float projectionDistance = clamp((exhaustionRoute ? strategyCarTargetBaseAtr : strategyStructTargetBaseAtr) + strategyTargetQualityBoostAtr * quality, strategyMinTargetAtr, strategyMaxTargetAtr) * strategySignalAtr
    float candidate = exhaustionRoute ? strategyShortCarEquilibrium : strategyShortStructObstacle
    float candidateDistance = not na(candidate) and candidate < close - strategyMinTargetAtr * strategySignalAtr ? close - candidate : na
    float targetDistance = not na(candidateDistance) ? math.min(projectionDistance, math.max(candidateDistance - strategyObstacleBufferAtr * strategySignalAtr, strategyMinTargetAtr * strategySignalAtr)) : projectionDistance
    bool obstacleLimited = not na(candidateDistance) and targetDistance < projectionDistance - syminfo.mintick
    float extendedDistance = obstacleLimited ? targetDistance : math.min(targetDistance + strategyTargetExtensionAtr * strategySignalAtr, strategyMaxTargetAtr * strategySignalAtr)
    float expectedRiskQty = math.max(strategy.equity, 0.0) * strategyRiskPct * 0.01 / math.max(sizingDistance * syminfo.pointvalue, syminfo.mintick)
    float catastropheRiskQty = math.max(strategy.equity, 0.0) * strategyCatastropheRiskPct * 0.01 / math.max(hardDistance * syminfo.pointvalue, syminfo.mintick)
    float riskQty = math.min(expectedRiskQty, catastropheRiskQty)
    float baseQty = strategySizeMode == "State-aware risk" ? math.min(riskQty, strategyExposureQty) : strategySizeMode == "Percent of equity" ? strategyEquityQty : strategyFixedQty
    float capitalScale = capitalIntelligenceScale(strategyUseCapitalIntelligence and strategySizeMode == "State-aware risk", baseQty, strategyExposureQty, strategyCapitalReferenceUtilization, strategyCapitalConvexity, strategyCapitalMinScale, strategyShortMemoryScale)
    float opposingSeverity = shortOpposingRiskSeverity(route == 10, strategyRegimeReady, strategyRegimeScore, strategyShortEveUnsafeScore, strategyShortOpposingScoreWidth, strategyRegimeDriftAtr, strategyShortEveBullDriftAtr, strategyRegimeSpreadAtr)
    float riskSurfaceScale = causalRiskSurfaceScale(strategyUseCausalRiskSurface and strategySizeMode == "State-aware risk", -1, capitalScale, opposingSeverity, strategyRiskSurfaceFloor, strategyLongFragileCeiling, strategyLongFragileWidth, strategyShortUncertaintyCenter, strategyShortUncertaintyHalfWidth)
    float qty = baseQty * capitalScale * riskSurfaceScale * (deferredPulse ? strategyDeferredRiskScale : 1.0)
    [logicalDistance, hardDistance, targetDistance, extendedDistance, obstacleLimited, capitalScale, riskSurfaceScale, qty]
buildLongTiming(bool takePulse, bool directEveTiming) =>
    float extremeLag = takePulse ? (bottomLead.extremeBar > -100000 ? bar_index - bottomLead.extremeBar : eventTelemetry.bottom.takeoverLag + 1.0) : directEveTiming ? bottomVictoryExtremeLag : na
    float armLag = takePulse ? bar_index - bottomEve.armBar : directEveTiming ? bottomVictoryArmLag : na
    float decayLag = takePulse ? (bottomLead.decayBar > -100000 ? bar_index - bottomLead.decayBar : na) : directEveTiming ? bottomVictoryDecayLag : na
    float defenseLag = takePulse ? (bottomLead.defenseBar > -100000 ? bar_index - bottomLead.defenseBar : na) : directEveTiming ? bottomVictoryDefenseLag : na
    float displacementAtr = takePulse ? (eventTelemetry.bottom.active and not na(eventTelemetry.bottom.extremePrice) ? math.max(close - eventTelemetry.bottom.extremePrice, 0.0) / math.max(atr, syminfo.mintick) : na) : directEveTiming ? bottomLeadDisplacementAtr : na
    float leadBars = takePulse ? na : directEveTiming ? bottomVictoryLeadBars : na
    float leadEdgeAtr = takePulse ? na : directEveTiming ? bottomVictoryLeadEdgeAtr : na
    float leadScore = takePulse ? na : directEveTiming and bottomLead.candidateSeen ? 100.0 * bottomLead.candidateScore : na
    [extremeLag, armLag, decayLag, defenseLag, displacementAtr, leadBars, leadEdgeAtr, leadScore]
buildShortTiming(bool directEveTiming) =>
    float extremeLag = directEveTiming ? topVictoryExtremeLag : na
    float armLag = directEveTiming ? topVictoryArmLag : na
    float decayLag = directEveTiming ? topVictoryDecayLag : na
    float defenseLag = directEveTiming ? topVictoryDefenseLag : na
    float displacementAtr = directEveTiming ? topLeadDisplacementAtr : na
    float leadBars = directEveTiming ? topVictoryLeadBars : na
    float leadEdgeAtr = directEveTiming ? topVictoryLeadEdgeAtr : na
    float leadScore = directEveTiming and topLead.candidateSeen ? 100.0 * topLead.candidateScore : na
    [extremeLag, armLag, decayLag, defenseLag, displacementAtr, leadBars, leadEdgeAtr, leadScore]
failureToLaunchEvidence(bool isLong, int route, int entryBar, float entryPrice, float baseTargetDistance, float previousMaxProgress) =>
    int barsHeld = math.max(bar_index - entryBar, 0)
    float currentProgress = isLong ? (close - entryPrice) / baseTargetDistance : (entryPrice - close) / baseTargetDistance
    float barFavorableProgress = isLong ? math.max((high - entryPrice) / baseTargetDistance, 0.0) : math.max((entryPrice - low) / baseTargetDistance, 0.0)
    float maxFavorableProgress = math.max(previousMaxProgress, barFavorableProgress)
    float ownControl = isLong ? strategyBullControl : strategyBearControl
    float opposingControl = isLong ? strategyBearControl : strategyBullControl
    bool controlLost = ownControl <= strategyLaunchOwnControlMax and opposingControl >= ownControl + strategyLaunchControlEdge
    bool isRevS = route == 1
    bool isStruct = route == 3
    bool isRevP = route == 5
    bool routeEnabled = isRevS ? strategyLaunchRevSEnabled : isRevP ? strategyLaunchRevPEnabled : isStruct ? strategyLaunchStructEnabled : false
    int revSLateDeadline = math.max(strategyRevSLaunchLateBars, strategyRevSLaunchEarlyBars + 1)
    bool earlyStale = isRevS and barsHeld >= strategyRevSLaunchEarlyBars and barsHeld < revSLateDeadline and maxFavorableProgress < strategyRevSLaunchEarlyProgress and currentProgress < 0.05
    bool revSLateStale = isRevS and barsHeld >= revSLateDeadline and maxFavorableProgress < strategyRevSLaunchLateProgress and currentProgress < strategyLaunchCurrentProgressMax
    bool revPLateStale = isRevP and barsHeld >= strategyRevPLaunchBars and maxFavorableProgress < strategyRevPLaunchProgress and currentProgress < strategyLaunchCurrentProgressMax
    bool structLateStale = isStruct and barsHeld >= strategyStructLaunchBars and maxFavorableProgress < strategyStructLaunchProgress and currentProgress < strategyLaunchCurrentProgressMax
    bool failureEvidence = (earlyStale or revSLateStale or revPLateStale or structLateStale) and controlLost
    [maxFavorableProgress, routeEnabled, failureEvidence]
bool strategyLongTpClose = false
bool strategyShortTpClose = false
bool strategyLongLaunchClose = false
bool strategyShortLaunchClose = false
bool strategyLongSlClose = false
bool strategyShortSlClose = false
bool strategyCanBuy = bar_index > strategyLastEntrySignalBar and (strategy.position_size == 0 or strategyReverseOnOpposite and strategy.position_size < 0)
bool strategyCanSell = bar_index > strategyLastEntrySignalBar and (strategy.position_size == 0 or strategyReverseOnOpposite and strategy.position_size > 0)
// This is exactly the TAKE-specific path into the real LONG execution branch.
// It is not a shadow approximation: when true, the existing BUY branch executes
// strategy.entry("LONG", ...) on this confirmed bar.
bool strategyTakeBuyExecutedNow =
     barstate.isconfirmed and
     strategyTakeBuyPulse and
     strategyExecuteBuySignal and
     strategyCanBuy

strategyTakeCandidateAudit.resolve(
     strategyUseTakeBuyExecution,
     strategyTakeBuyExecutedNow)

if barstate.isconfirmed
    if strategyExecuteBuySignal and strategyCanBuy
        [longLogicalDistance, longHardDistance, longTargetDistance, longExtendedDistance, longObstacleLimited, longCapitalScale, longRiskSurfaceScale, longQty] = buildLongTradePlan(strategyExecuteBuyRoute, strategyExecuteBuyQuality, strategyDeferredBuyPulse)
        if longRiskSurfaceScale >= strategyMinRiskSurfaceScale
            bool longDirectEveTiming = strategyExecuteBuyRoute == 10 and not strategyDeferredBuyPulse
            [longTimingExtremeLag, longTimingArmLag, longTimingDecayLag, longTimingDefenseLag, longTimingDisplacementAtr, longTimingLeadBars, longTimingLeadEdgeAtr, longTimingLeadScore] = buildLongTiming(strategyTakeBuyPulse, longDirectEveTiming)
            strategyTimingExtremeLag := longTimingExtremeLag
            strategyTimingArmLag := longTimingArmLag
            strategyTimingDecayLag := longTimingDecayLag
            strategyTimingDefenseLag := longTimingDefenseLag
            strategyTimingDisplacementAtr := longTimingDisplacementAtr
            strategyTimingLeadBars := longTimingLeadBars
            strategyTimingLeadEdgeAtr := longTimingLeadEdgeAtr
            strategyTimingLeadScore := longTimingLeadScore
            strategyTradeDirection := 1
            strategyTradeRoute := strategyExecuteBuyRoute
            strategyEntryBar := bar_index
            strategyLastEntrySignalBar := bar_index
            strategyLogicalBreakStreak := 0
            strategyInvalidationActive := false
            strategyInvalidationEvidence := 0.0
            strategyTargetExtended := false
            strategyBaseTargetTouched := false
            strategyTargetExtensionAllowed := not longObstacleLimited and longExtendedDistance > longTargetDistance + syminfo.mintick
            strategyMaxFavorableProgress := 0.0
            strategyLaunchFailureStreak := 0
            strategyEntryPrice := close
            strategyEntryAtr := strategySignalAtr
            strategyLogicalDistance := longLogicalDistance
            strategyHardDistance := longHardDistance
            strategyLogicalStop := close - longLogicalDistance
            strategyHardStop := close - longHardDistance
            strategyBaseTargetDistance := longTargetDistance
            strategyExtendedTargetDistance := longExtendedDistance
            strategyTargetDistance := longTargetDistance
            strategyBaseTarget := close + longTargetDistance
            strategyExtendedTarget := close + longExtendedDistance
            strategyTarget := strategyBaseTarget
            if strategyDeferredBuyPulse
                strategyDeferredBuyEntries += 1
                label.new(bar_index, low, "BUY " + routeName(strategyExecuteBuyRoute) + "-G\nR " + str.tostring(strategyDeferredBuyProof, "#.00"), yloc = yloc.belowbar, style = label.style_label_up, color = color.new(bull, 15), textcolor = color.white, size = size.small)
            if strategyTakeBuyPulse
                strategyTakeBuyAdmission.auditExecution(true, eventTelemetry.bottom, atr)
                strategyTakeBuyAdmission.consume(bottomEve.armBar)
                label.new(bar_index, low, "BUY EVE-TAKE EARLY\nH " + str.tostring(strategyExecuteBuyQuality, "#.0"), yloc = yloc.belowbar, style = label.style_label_up, color = color.new(bull, 58), textcolor = color.white, size = size.small)
            strategy.entry("LONG", strategy.long, qty = longQty, comment = "BUY " + routeName(strategyExecuteBuyRoute) + (strategyTakeBuyPulse ? "-T" : strategyDeferredBuyPulse ? "-G" : "") + " A" + str.tostring(longCapitalScale, "#.00") + " X" + str.tostring(longRiskSurfaceScale, "#.00") + " H" + str.tostring(strategyExecuteBuyQuality, "#.0") + " R" + str.tostring(strategyRegimeScore, "#.00"))
    if strategyExecuteSellSignal and strategyCanSell
        [shortLogicalDistance, shortHardDistance, shortTargetDistance, shortExtendedDistance, shortObstacleLimited, shortCapitalScale, shortRiskSurfaceScale, shortQty] = buildShortTradePlan(strategyExecuteSellRoute, strategyExecuteSellQuality, strategyDeferredSellPulse)
        if shortRiskSurfaceScale >= strategyMinRiskSurfaceScale
            bool shortDirectEveTiming = strategyExecuteSellRoute == 10 and not strategyDeferredSellPulse
            [shortTimingExtremeLag, shortTimingArmLag, shortTimingDecayLag, shortTimingDefenseLag, shortTimingDisplacementAtr, shortTimingLeadBars, shortTimingLeadEdgeAtr, shortTimingLeadScore] = buildShortTiming(shortDirectEveTiming)
            strategyTimingExtremeLag := shortTimingExtremeLag
            strategyTimingArmLag := shortTimingArmLag
            strategyTimingDecayLag := shortTimingDecayLag
            strategyTimingDefenseLag := shortTimingDefenseLag
            strategyTimingDisplacementAtr := shortTimingDisplacementAtr
            strategyTimingLeadBars := shortTimingLeadBars
            strategyTimingLeadEdgeAtr := shortTimingLeadEdgeAtr
            strategyTimingLeadScore := shortTimingLeadScore
            strategyTradeDirection := -1
            strategyTradeRoute := strategyExecuteSellRoute
            strategyEntryBar := bar_index
            strategyLastEntrySignalBar := bar_index
            strategyLogicalBreakStreak := 0
            strategyInvalidationActive := false
            strategyInvalidationEvidence := 0.0
            strategyTargetExtended := false
            strategyBaseTargetTouched := false
            strategyTargetExtensionAllowed := not shortObstacleLimited and shortExtendedDistance > shortTargetDistance + syminfo.mintick
            strategyMaxFavorableProgress := 0.0
            strategyLaunchFailureStreak := 0
            strategyEntryPrice := close
            strategyEntryAtr := strategySignalAtr
            strategyLogicalDistance := shortLogicalDistance
            strategyHardDistance := shortHardDistance
            strategyLogicalStop := close + shortLogicalDistance
            strategyHardStop := close + shortHardDistance
            strategyBaseTargetDistance := shortTargetDistance
            strategyExtendedTargetDistance := shortExtendedDistance
            strategyTargetDistance := shortTargetDistance
            strategyBaseTarget := close - shortTargetDistance
            strategyExtendedTarget := close - shortExtendedDistance
            strategyTarget := strategyBaseTarget
            if strategyDeferredSellPulse
                strategyDeferredSellEntries += 1
                label.new(bar_index, high, "SELL " + routeName(strategyExecuteSellRoute) + "-G\nR " + str.tostring(strategyDeferredSellProof, "#.00"), yloc = yloc.abovebar, style = label.style_label_down, color = color.new(bear, 15), textcolor = color.white, size = size.small)
            if strategyFlatLeadSellPulse and strategyShowFlatLeadSell
                label.new(bar_index, high, "FLAT LEAD SELL\nQ " + str.tostring(strategyExecuteSellQuality, "#.0"), yloc = yloc.abovebar, style = label.style_label_down, color = color.new(#9AA4B2, 35), textcolor = color.white, size = size.tiny)
            strategy.entry("SHORT", strategy.short, qty = shortQty, comment = "SELL " + routeName(strategyExecuteSellRoute) + (strategyFlatLeadSellPulse ? "-F" : strategyDeferredSellPulse ? "-G" : "") + " A" + str.tostring(shortCapitalScale, "#.00") + " X" + str.tostring(shortRiskSurfaceScale, "#.00") + " H" + str.tostring(strategyExecuteSellQuality, "#.0") + " R" + str.tostring(strategyRegimeScore, "#.00") + " T" + str.tostring(strategyExecuteSellTransition, "#.00"))
bool strategyNewLongFill = strategy.position_size > 0 and nz(strategy.position_size[1]) <= 0
bool strategyNewShortFill = strategy.position_size < 0 and nz(strategy.position_size[1]) >= 0
if strategyNewLongFill and strategyTradeDirection == 1
    strategyEntryPrice := strategy.position_avg_price
    strategyLogicalStop := strategyEntryPrice - strategyLogicalDistance
    strategyHardStop := strategyEntryPrice - strategyHardDistance
    strategyBaseTarget := strategyEntryPrice + strategyBaseTargetDistance
    strategyExtendedTarget := strategyEntryPrice + strategyExtendedTargetDistance
    strategyTargetDistance := strategyBaseTargetDistance
    strategyTarget := strategyBaseTarget
    strategyEntryBar := bar_index
    strategyMaxFavorableProgress := 0.0
    strategyLaunchFailureStreak := 0
    strategyTailFlagged := false
    strategyTailReduced := false
    labReset(strategyLabData)
    labWriteTiming(strategyLabData, strategyTimingExtremeLag, strategyTimingArmLag, strategyTimingDecayLag, strategyTimingDefenseLag, strategyTimingDisplacementAtr, strategyTimingLeadBars, strategyTimingLeadEdgeAtr, strategyTimingLeadScore)
    strategyLogicalGuide := line.new(strategyEntryBar, strategyLogicalStop, bar_index + 1, strategyLogicalStop, xloc = xloc.bar_index, color = #FF9800, width = 2, style = line.style_dashed)
    strategyHardGuide := line.new(strategyEntryBar, strategyHardStop, bar_index + 1, strategyHardStop, xloc = xloc.bar_index, color = #3D7CFF, width = 2)
    strategyTargetGuide := line.new(strategyEntryBar, strategyTarget, bar_index + 1, strategyTarget, xloc = xloc.bar_index, color = #00B884, width = 2)
if strategyNewShortFill and strategyTradeDirection == -1
    strategyEntryPrice := strategy.position_avg_price
    strategyLogicalStop := strategyEntryPrice + strategyLogicalDistance
    strategyHardStop := strategyEntryPrice + strategyHardDistance
    strategyBaseTarget := strategyEntryPrice - strategyBaseTargetDistance
    strategyExtendedTarget := strategyEntryPrice - strategyExtendedTargetDistance
    strategyTargetDistance := strategyBaseTargetDistance
    strategyTarget := strategyBaseTarget
    strategyEntryBar := bar_index
    strategyMaxFavorableProgress := 0.0
    strategyLaunchFailureStreak := 0
    strategyTailFlagged := false
    strategyTailReduced := false
    labReset(strategyLabData)
    labWriteTiming(strategyLabData, strategyTimingExtremeLag, strategyTimingArmLag, strategyTimingDecayLag, strategyTimingDefenseLag, strategyTimingDisplacementAtr, strategyTimingLeadBars, strategyTimingLeadEdgeAtr, strategyTimingLeadScore)
    strategyLogicalGuide := line.new(strategyEntryBar, strategyLogicalStop, bar_index + 1, strategyLogicalStop, xloc = xloc.bar_index, color = #FF9800, width = 2, style = line.style_dashed)
    strategyHardGuide := line.new(strategyEntryBar, strategyHardStop, bar_index + 1, strategyHardStop, xloc = xloc.bar_index, color = #3D7CFF, width = 2)
    strategyTargetGuide := line.new(strategyEntryBar, strategyTarget, bar_index + 1, strategyTarget, xloc = xloc.bar_index, color = #00B884, width = 2)
bool strategyBuyLaunchGovernorLabPulse = false
if barstate.isconfirmed and strategy.position_size != 0 and strategyTradeDirection != 0 and not na(strategyEntryPrice) and not na(strategyEntryAtr)
    int strategyLabAge = math.max(bar_index - strategyEntryBar, 0)
    labObserve(strategyLabData, strategyLabAge, strategyTradeDirection, strategyEntryPrice, strategyEntryAtr, strategyBullControl, strategyBearControl)
    strategyBuyLaunchGovernorLabPulse := labObserveBuyLaunchGovernor(strategyLabData, strategyUseBuyLaunchGovernorLab, strategyLabAge, strategyTradeDirection, strategyEntryPrice, strategyEntryAtr, strategyBullControl, strategyBearControl)
if strategyShowBuyLaunchGovernorLab and strategyBuyLaunchGovernorLabPulse
    label.new(bar_index, low, "BUY LG?\nvirtual exit", yloc = yloc.belowbar, style = label.style_label_up, color = color.new(#9AA4B2, 45), textcolor = color.white, size = size.tiny)
if strategy.position_size != 0
    if not na(strategyLogicalGuide)
        line.set_x2(strategyLogicalGuide, bar_index + 1)
    if not na(strategyHardGuide)
        line.set_x2(strategyHardGuide, bar_index + 1)
    if not na(strategyTargetGuide)
        line.set_x2(strategyTargetGuide, bar_index + 1)
if barstate.isconfirmed and strategy.position_size > 0 and strategyTradeDirection == 1 and not na(strategyBaseTargetDistance)
    float longTargetProgress = strategyBaseTargetDistance > 0 ? (close - strategyEntryPrice) / strategyBaseTargetDistance : 0.0
    if not strategyTargetExtended and strategyTargetExtensionAllowed and longTargetProgress >= strategyTargetExtensionArm and strategyBullControl >= strategyTargetControlMin
        strategyTargetExtended := true
        strategyTargetDistance := strategyExtendedTargetDistance
        strategyTarget := strategyExtendedTarget
    if strategyTargetExtended
        strategyBaseTargetTouched := strategyBaseTargetTouched or high >= strategyBaseTarget
        bool longTargetControlFade = strategyBullControl <= strategyTargetFadeControl
        if longTargetControlFade and strategyBaseTargetTouched and close >= strategyEntryPrice + 0.15 * strategyEntryAtr
            strategyLongTpClose := true
            strategy.close("LONG", comment = labTag("TP CONTROL FADE", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
        else if longTargetControlFade
            strategyTargetExtended := false
            strategyTargetDistance := strategyBaseTargetDistance
            strategyTarget := strategyBaseTarget
if barstate.isconfirmed and strategy.position_size < 0 and strategyTradeDirection == -1 and not na(strategyBaseTargetDistance)
    float shortTargetProgress = strategyBaseTargetDistance > 0 ? (strategyEntryPrice - close) / strategyBaseTargetDistance : 0.0
    if not strategyTargetExtended and strategyTargetExtensionAllowed and shortTargetProgress >= strategyTargetExtensionArm and strategyBearControl >= strategyTargetControlMin
        strategyTargetExtended := true
        strategyTargetDistance := strategyExtendedTargetDistance
        strategyTarget := strategyExtendedTarget
    if strategyTargetExtended
        strategyBaseTargetTouched := strategyBaseTargetTouched or low <= strategyBaseTarget
        bool shortTargetControlFade = strategyBearControl <= strategyTargetFadeControl
        if shortTargetControlFade and strategyBaseTargetTouched and close <= strategyEntryPrice - 0.15 * strategyEntryAtr
            strategyShortTpClose := true
            strategy.close("SHORT", comment = labTag("TP CONTROL FADE", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
        else if shortTargetControlFade
            strategyTargetExtended := false
            strategyTargetDistance := strategyBaseTargetDistance
            strategyTarget := strategyBaseTarget
if strategy.position_size != 0 and not na(strategyTargetGuide)
    line.set_y1(strategyTargetGuide, strategyTarget)
    line.set_y2(strategyTargetGuide, strategyTarget)
// Route-aware failure-to-launch is a causal survival test, not a tighter stop.
// REV-S is empirically fast and may use early/late deadlines. REV-P receives
// only a delayed test beyond its normal winning-duration range. STRUCT is off
// by default because elapsed time did not separate its winners from its losses.
// Unobserved REV-T, REV-X and CAR routes never receive an FTL exit.
if barstate.isconfirmed and strategyUseFailureToLaunch and strategy.position_size != 0 and not na(strategyEntryPrice) and not na(strategyBaseTargetDistance) and strategyBaseTargetDistance > 0
    bool launchIsLong = strategy.position_size > 0 and strategyTradeDirection == 1
    bool launchIsShort = strategy.position_size < 0 and strategyTradeDirection == -1
    if launchIsLong or launchIsShort
        [launchNextMaxFavorableProgress, launchRouteEnabled, launchFailureEvidence] = failureToLaunchEvidence(launchIsLong, strategyTradeRoute, strategyEntryBar, strategyEntryPrice, strategyBaseTargetDistance, strategyMaxFavorableProgress)
        strategyMaxFavorableProgress := launchNextMaxFavorableProgress
        strategyLaunchFailureStreak := launchRouteEnabled and launchFailureEvidence ? strategyLaunchFailureStreak + 1 : 0
        bool launchTargetUntouched = launchIsLong ? high < strategyBaseTarget : low > strategyBaseTarget
        bool launchConfirmedFailure = launchRouteEnabled and strategyLaunchFailureStreak >= strategyLaunchConfirmCloses and launchTargetUntouched
        if launchConfirmedFailure and not strategyLongTpClose and not strategyShortTpClose
            strategyFailureToLaunchCount += 1
            if launchIsLong
                strategyLongLaunchClose := true
                strategy.close("LONG", comment = labTag("FAILURE TO LAUNCH", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
            else
                strategyShortLaunchClose := true
                strategy.close("SHORT", comment = labTag("FAILURE TO LAUNCH", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
if barstate.isconfirmed and strategy.position_size > 0 and strategyTradeDirection == 1 and bar_index > strategyEntryBar + strategyLogicalGraceBars
    bool longWeakFailure = close < strategyLogicalStop
    if longWeakFailure
        strategyInvalidationActive := true
        strategyInvalidationEvidence += math.max((strategyLogicalStop - close) / strategyEntryAtr, 0.0)
        strategyLogicalBreakStreak := strategyBearControl >= strategyInvalidationControlMin ? strategyLogicalBreakStreak + 1 : 0
    else
        strategyInvalidationActive := false
        strategyLogicalBreakStreak := 0
        strategyInvalidationEvidence := 0.0
    bool longConfirmedFailure = strategyInvalidationActive and strategyLogicalBreakStreak >= strategyLogicalConfirmCloses and strategyInvalidationEvidence >= strategyMinInvalidationEvidenceAtr
    if longConfirmedFailure and not strategyLongTpClose and not strategyLongLaunchClose
        strategyLongSlClose := true
        strategy.close("LONG", comment = labTag("SL CONTROL TRANSFER", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
if barstate.isconfirmed and strategy.position_size < 0 and strategyTradeDirection == -1 and bar_index > strategyEntryBar + strategyLogicalGraceBars
    bool shortWeakFailure = close > strategyLogicalStop
    if shortWeakFailure
        strategyInvalidationActive := true
        strategyInvalidationEvidence += math.max((close - strategyLogicalStop) / strategyEntryAtr, 0.0)
        strategyLogicalBreakStreak := strategyBullControl >= strategyInvalidationControlMin ? strategyLogicalBreakStreak + 1 : 0
    else
        strategyInvalidationActive := false
        strategyLogicalBreakStreak := 0
        strategyInvalidationEvidence := 0.0
    bool shortConfirmedFailure = strategyInvalidationActive and strategyLogicalBreakStreak >= strategyLogicalConfirmCloses and strategyInvalidationEvidence >= strategyMinInvalidationEvidenceAtr
    if shortConfirmedFailure and not strategyShortTpClose and not strategyShortLaunchClose
        strategyShortSlClose := true
        strategy.close("SHORT", comment = labTag("SL CONTROL TRANSFER", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
// Validated 15m tail intervention. Thresholds stay fixed to preserve the
// cross-market test: L8 <= (.50 MFE, >=.20 MAE, <=-.10 progress, <=-.05 edge),
// then L12 must add <=.10 MFE and remain at non-positive close progress.
bool strategyTailTimeframePass = timeframe.isminutes and timeframe.multiplier == 15
if barstate.isconfirmed and strategyUseTailRecovery and strategyTailTimeframePass and strategy.position_size != 0 and strategyTradeDirection != 0 and strategyTradeRoute == 10 and not strategyTailReduced
    int strategyTailAge = math.max(bar_index - strategyEntryBar, 0)
    [strategyTailNextFlagged, strategyTailRecoveryFailed] = tailRecoveryStep(strategyLabData, strategyTailAge, strategyTailFlagged)
    strategyTailFlagged := strategyTailNextFlagged
    if strategyTailRecoveryFailed
        bool strategyTailFullExitCommanded = strategyLongTpClose or strategyShortTpClose or strategyLongLaunchClose or strategyShortLaunchClose or strategyLongSlClose or strategyShortSlClose
        bool strategyTailHardOrTargetTouched = strategyTradeDirection == 1 ? (low <= strategyHardStop or high >= strategyTarget) : (high >= strategyHardStop or low <= strategyTarget)
        if not strategyTailFullExitCommanded and not strategyTailHardOrTargetTouched
            strategyTailReduced := true
            if strategyTradeDirection == 1
                strategy.close("LONG", qty_percent = 25.0, comment = labTag("TAIL RECOVERY DE-RISK", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
            else
                strategy.close("SHORT", qty_percent = 25.0, comment = labTag("TAIL RECOVERY DE-RISK", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
if strategyTradeDirection == 1 and not na(strategyHardStop)
    string strategyLongLabProfit = strategyTargetExtended ? "ADAPTIVE TP" : (strategyTradeRoute == 10 ? "EVE TP" : strategyTradeRoute == 9 ? "CAR TP" : "STRUCT TP")
    strategy.exit("L-EXIT", "LONG", stop = strategyHardStop, limit = strategyTarget, qty_percent = 100.0, comment_profit = labTag(strategyLongLabProfit, strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice), comment_loss = labTag("CATASTROPHE SL", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
if strategyTradeDirection == -1 and not na(strategyHardStop)
    string strategyShortLabProfit = strategyTargetExtended ? "ADAPTIVE TP" : (strategyTradeRoute == 10 ? "EVE TP" : strategyTradeRoute == 9 ? "CAR TP" : "STRUCT TP")
    strategy.exit("S-EXIT", "SHORT", stop = strategyHardStop, limit = strategyTarget, qty_percent = 100.0, comment_profit = labTag(strategyShortLabProfit, strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice), comment_loss = labTag("CATASTROPHE SL", strategyLabData, 100.0 * strategyEntryAtr / strategyEntryPrice))
// ---------------------------------------------------------------------------
// TAKE CANDIDATE AUDIT — render. Keep these two statements in the main body;
// all expensive rendering remains inside the method, which protects Pine's
// main-body execution-size limit.
// ---------------------------------------------------------------------------
var table strategyTakeCandidateAuditTable = table.new(
     position.bottom_right, 8, 15,
     frame_color=color.new(color.gray, 55), frame_width=1)

strategyTakeCandidateAudit.renderTakeCandidateAudit(
     strategyTakeCandidateAuditTable, 12)

// EXPECTED BEHAVIOUR IN THE A/B/C MATRIX
// A: strategyUseTakeBuyExecution=false
//    -> rows show CANDIDATE=YES, but REJECTED/EXECUTED remain empty.
// B: execution=true, noise gate=false
//    -> every raw candidate resolves to REJECTED or EXECUTED.
// C: execution=true, noise gate=true
//    -> candidates with TAKEOVER < 0.20 or MARGIN < 0.04 should become REJECTED;
//       admitted candidates that reach the actual LONG branch become EXECUTED.
// If B and C still have identical trades, the table proves whether the gate
// rejected zero candidates or whether the gate is bypassed elsewhere.

alertcondition(buySignal or strategyTakeBuyPulse, "TRINITY EVE BUY", "{\"action\":\"BUY\",\"symbol\":\"{{ticker}}\",\"timeframe\":\"{{interval}}\",\"price\":\"{{close}}\"}")
alertcondition(sellSignal, "TRINITY EVE SELL", "{\"action\":\"SELL\",\"symbol\":\"{{ticker}}\",\"timeframe\":\"{{interval}}\",\"price\":\"{{close}}\"}")
alertcondition(buySignal or strategyTakeBuyPulse or sellSignal, "TRINITY EVE BUY/SELL", "TRINITY EVE confirmed signal on {{ticker}} {{interval}} at {{close}}")
