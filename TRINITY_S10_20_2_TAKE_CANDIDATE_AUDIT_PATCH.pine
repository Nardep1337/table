//=============================================================================
// Helpers
//=============================================================================
clamp(float value, float floor, float ceiling) => math.max(floor, math.min(ceiling, value))
clamp01(float value) => clamp(value, 0.0, 1.0)
logitSafe(float probability) =>
    float bounded = clamp(probability, 0.02, 0.98)
    math.log(bounded / (1.0 - bounded))
sigmoidSafe(float logOdds) =>
    1.0 / (1.0 + math.exp(-clamp(logOdds, -20.0, 20.0)))
tanhSafe(float value) =>
    float e = math.exp(2.0 * clamp(value, -20.0, 20.0))
    (e - 1.0) / (e + 1.0)
type EveEpisode
    int side
    int state
    int armBar
    float score
    float previousScore
    float frontier
    float invalidation
    int victoryStreak
    bool pulse
    int armedCount
    int decayCount
    int defenseCount
    int victoryCount
    int cancelCount
method step(EveEpisode self, bool cycleArmed, float decay, float defense, float takeover, float continuation, float turnEvidence, float cycleExtremePrice, float frontierCandidate, bool controlBreak, bool structuralTransfer, float directionalChange, bool trendPass, float atrNow, float priceVelocity, float closePosition, float cfgDrift, float cfgMemory, float cfgDecayMin, float cfgDefenseMin, float cfgControlBufferAtr, int cfgMinSequenceBars, float cfgDecisionBoundary, float cfgTakeoverMin, float cfgDominanceMargin, float cfgInvalidationAtr, int cfgArmMemory, int cfgPersistenceBars) =>
    self.pulse := false
    if barstate.isconfirmed
        if cycleArmed and self.state == 0
            self.state := 1
            self.armBar := bar_index
            self.score := 0.0
            self.previousScore := 0.0
            self.frontier := frontierCandidate
            self.invalidation := cycleExtremePrice
            self.victoryStreak := 0
            self.armedCount += 1
        if self.state > 0 and self.state < 4
            bool wasDefense = self.state == 3
            self.previousScore := self.score
            float increment = 0.80 * decay + 0.72 * defense + 0.95 * takeover + 0.35 * turnEvidence - 0.95 * continuation - cfgDrift
            self.score := clamp(cfgMemory * self.score + increment, -4.0, 4.0)
            if self.state == 1
                self.invalidation := self.side == 1 ? math.min(nz(self.invalidation, low), low) : math.max(nz(self.invalidation, high), high)
                if bar_index > self.armBar and decay >= cfgDecayMin and turnEvidence >= 0.18
                    self.state := 2
                    self.frontier := self.side == 1 ? math.max(nz(self.frontier, high[1]), frontierCandidate) : math.min(nz(self.frontier, low[1]), frontierCandidate)
                    self.decayCount += 1
            else if self.state == 2 and defense >= cfgDefenseMin and takeover > continuation
                self.state := 3
                self.defenseCount += 1
            bool basicDirectionalCandle = self.side == 1 ? close > open : close < open
            bool qualityDirectionalCandle = self.side == 1 ? close > open and closePosition >= 0.52 : close < open and closePosition <= 0.48
            bool frontierVictory = self.side == 1 ? close > nz(self.frontier, close) + cfgControlBufferAtr * atrNow : close < nz(self.frontier, close) - cfgControlBufferAtr * atrNow
            bool priceVictory = controlBreak or (structuralTransfer and directionalChange >= 0.30 and qualityDirectionalCandle) or (frontierVictory and basicDirectionalCandle)
            bool victoryObservation = wasDefense and bar_index - self.armBar >= cfgMinSequenceBars and self.score >= cfgDecisionBoundary and self.score > self.previousScore and takeover >= cfgTakeoverMin and takeover >= continuation + cfgDominanceMargin and priceVictory and trendPass
            self.victoryStreak := victoryObservation ? self.victoryStreak + 1 : 0
            bool efficientExtension = self.side == 1 ? low < nz(self.invalidation, low) - cfgInvalidationAtr * atrNow and continuation > takeover and priceVelocity < 0.0 : high > nz(self.invalidation, high) + cfgInvalidationAtr * atrNow and continuation > takeover and priceVelocity > 0.0
            bool expired = not cycleArmed or bar_index - self.armBar > cfgArmMemory
            if self.victoryStreak >= cfgPersistenceBars
                self.pulse := true
                self.state := 4
                self.victoryCount += 1
            else if efficientExtension or expired
                self.state := 0
                self.score := 0.0
                self.victoryStreak := 0
                self.cancelCount += 1
        if self.state == 4 and not cycleArmed
            self.state := 0
            self.score := 0.0
    self
// One event per causal episode. This observer never returns a trading signal.
type EpisodeEventObserver
    int side
    int armBar
    float extremePrice
    bool active
    bool decaySeen
    bool takeoverSeen
    bool reversalSeen
    bool decayPulse
    bool takeoverPulse
    bool reversalPulse
    float decayX
    float takeoverX
    float reversalX
    float decayLag
    float takeoverLag
    float reversalLag
    int episodes
    int victories
    int cancels
newEpisodeEventObserver(int side) =>
    EpisodeEventObserver.new(side, -100000, na, false, false, false, false, false, false, false, na, na, na, na, na, na, 0, 0, 0)
method observe(EpisodeEventObserver self, int stateBefore, int stateAfter, bool cycleArmed, float cycleExtreme, float takeover, float continuation, bool reversalCandle, bool victoryPulse, float atrNow) =>
    self.decayPulse := false
    self.takeoverPulse := false
    self.reversalPulse := false
    bool newArm = stateBefore == 0 and stateAfter == 1
    if newArm
        self.armBar := bar_index
        self.extremePrice := cycleExtreme
        self.active := true
        self.decaySeen := false
        self.takeoverSeen := false
        self.reversalSeen := false
        self.episodes += 1
    if self.active and not na(cycleExtreme)
        self.extremePrice := self.side == 1 ? math.min(nz(self.extremePrice, cycleExtreme), cycleExtreme) : math.max(nz(self.extremePrice, cycleExtreme), cycleExtreme)
    float unit = math.max(atrNow, syminfo.mintick)
    float displacement = self.side == 1 ? math.max(close - nz(self.extremePrice, close), 0.0) / unit : math.max(nz(self.extremePrice, close) - close, 0.0) / unit
    float eventLag = self.active ? float(bar_index - self.armBar) : na
    bool firstDecay = self.active and not self.decaySeen and stateBefore == 1 and stateAfter == 2
    if firstDecay
        self.decaySeen := true
        self.decayPulse := true
        self.decayX := displacement
        self.decayLag := eventLag
    bool firstTakeover = self.active and self.decaySeen and not self.takeoverSeen and takeover > continuation
    if firstTakeover
        self.takeoverSeen := true
        self.takeoverPulse := true
        self.takeoverX := displacement
        self.takeoverLag := eventLag
    bool firstReversal = self.active and self.decaySeen and not self.reversalSeen and reversalCandle
    if firstReversal
        self.reversalSeen := true
        self.reversalPulse := true
        self.reversalX := displacement
        self.reversalLag := eventLag
    if victoryPulse
        self.victories += 1
        self.active := false
    else if self.active and stateBefore > 0 and stateBefore < 4 and stateAfter == 0
        self.cancels += 1
        self.active := false
    self
// Fixed-horizon audit container. Target/stop collision on one bar is a stop.
type EventOutcomeAudit
    int side
    array<float> entries
    array<float> atrs
    array<int> bars
    array<float> pendingX
    array<float> pendingLag
    array<float> results
    array<float> resultX
    array<float> resultLag
method add(EventOutcomeAudit self, bool pulse, float displacement, float eventLag, float atrNow) =>
    if barstate.isconfirmed and pulse
        array.push(self.entries, close)
        array.push(self.atrs, math.max(atrNow, syminfo.mintick))
        array.push(self.bars, bar_index)
        array.push(self.pendingX, displacement)
        array.push(self.pendingLag, eventLag)
    self
method update(EventOutcomeAudit self, float targetAtr, float stopAtr, int horizon, int limit) =>
    if barstate.isconfirmed
        int pendingCount = array.size(self.entries)
        if pendingCount > 0
            for reverseIndex = 0 to pendingCount - 1
                int eventIndex = pendingCount - 1 - reverseIndex
                int age = bar_index - array.get(self.bars, eventIndex)
                if age > 0
                    float entry = array.get(self.entries, eventIndex)
                    float unit = array.get(self.atrs, eventIndex)
                    bool targetHit = self.side == 1 ? high >= entry + targetAtr * unit : low <= entry - targetAtr * unit
                    bool stopHit = self.side == 1 ? low <= entry - stopAtr * unit : high >= entry + stopAtr * unit
                    bool expired = age >= horizon
                    if targetHit or stopHit or expired
                        float outcome = stopHit ? -stopAtr : targetHit ? targetAtr : self.side * (close - entry) / unit
                        array.push(self.results, outcome)
                        array.push(self.resultX, array.get(self.pendingX, eventIndex))
                        array.push(self.resultLag, array.get(self.pendingLag, eventIndex))
                        if array.size(self.results) > limit
                            array.shift(self.results)
                            array.shift(self.resultX)
                            array.shift(self.resultLag)
                        array.remove(self.entries, eventIndex)
                        array.remove(self.atrs, eventIndex)
                        array.remove(self.bars, eventIndex)
                        array.remove(self.pendingX, eventIndex)
                        array.remove(self.pendingLag, eventIndex)
    self
newEventOutcomeAudit(int side) =>
    EventOutcomeAudit.new(side, array.new_float(), array.new_float(), array.new_int(), array.new_float(), array.new_float(), array.new_float(), array.new_float(), array.new_float())
// The six telemetry streams are deliberately enclosed in one object. Pine now
// sees one suite instance and one step call in the script body instead of six
// instances plus twelve independent calls. No value from this suite can reach
// signal routing or strategy execution.
type EventAuditSuite
    EventOutcomeAudit decayBuy
    EventOutcomeAudit decaySell
    EventOutcomeAudit takeoverBuy
    EventOutcomeAudit takeoverSell
    EventOutcomeAudit reversalBuy
    EventOutcomeAudit reversalSell
newEventAuditSuite() =>
    EventAuditSuite.new(newEventOutcomeAudit(1), newEventOutcomeAudit(-1), newEventOutcomeAudit(1), newEventOutcomeAudit(-1), newEventOutcomeAudit(1), newEventOutcomeAudit(-1))
method step(EventAuditSuite self, EpisodeEventObserver bottomEvents, EpisodeEventObserver topEvents, float atrNow, float targetAtr, float stopAtr, int horizon, int limit) =>
    self.decayBuy.add(bottomEvents.decayPulse, bottomEvents.decayX, bottomEvents.decayLag, atrNow)
    self.decaySell.add(topEvents.decayPulse, topEvents.decayX, topEvents.decayLag, atrNow)
    self.takeoverBuy.add(bottomEvents.takeoverPulse, bottomEvents.takeoverX, bottomEvents.takeoverLag, atrNow)
    self.takeoverSell.add(topEvents.takeoverPulse, topEvents.takeoverX, topEvents.takeoverLag, atrNow)
    self.reversalBuy.add(bottomEvents.reversalPulse, bottomEvents.reversalX, bottomEvents.reversalLag, atrNow)
    self.reversalSell.add(topEvents.reversalPulse, topEvents.reversalX, topEvents.reversalLag, atrNow)
    self.decayBuy.update(targetAtr, stopAtr, horizon, limit)
    self.decaySell.update(targetAtr, stopAtr, horizon, limit)
    self.takeoverBuy.update(targetAtr, stopAtr, horizon, limit)
    self.takeoverSell.update(targetAtr, stopAtr, horizon, limit)
    self.reversalBuy.update(targetAtr, stopAtr, horizon, limit)
    self.reversalSell.update(targetAtr, stopAtr, horizon, limit)
    self
// One diagnostic facade owns the two episode observers and all six outcome
// audits. Its single step is the only event-audit statement left in the main
// body. It has no order, route, sizing, signal or graphics output.
type EventTelemetrySuite
    EpisodeEventObserver bottom
    EpisodeEventObserver top
    EventAuditSuite audits
newEventTelemetrySuite() =>
    EventTelemetrySuite.new(newEpisodeEventObserver(1), newEpisodeEventObserver(-1), newEventAuditSuite())
method step(EventTelemetrySuite self, int bottomStateBefore, int bottomStateAfter, int topStateBefore, int topStateAfter, bool bottomArmed, bool topArmed, float bottomExtreme, float topExtreme, float bottomTakeover, float topTakeover, float bottomContinuation, float topContinuation, bool bottomVictory, bool topVictory, float closePosition, float atrNow, float targetAtr, float stopAtr, int horizon, int limit) =>
    bool bottomReversalCandle = close > open and closePosition >= 0.55
    bool topReversalCandle = close < open and closePosition <= 0.42
    self.bottom.observe(bottomStateBefore, bottomStateAfter, bottomArmed, bottomExtreme, bottomTakeover, bottomContinuation, bottomReversalCandle, bottomVictory, atrNow)
    self.top.observe(topStateBefore, topStateAfter, topArmed, topExtreme, topTakeover, topContinuation, topReversalCandle, topVictory, atrNow)
    self.audits.step(self.bottom, self.top, atrNow, targetAtr, stopAtr, horizon, limit)
    self
// Execution admission for the one pre-registered shadow event with positive
// expectancy. The event must persist for one complete confirmed bar. A TAKE
// attempt is consumed once per arm, but it no longer suppresses a later full
// VICTORY after the early position has closed. This object does not alter SELL
// or any exit mathematics.
type TakeBuyAdmission
    bool pulse
    float quality
    int consumedArmBar
    EventOutcomeAudit executedAudit
newTakeBuyAdmission() =>
    TakeBuyAdmission.new(false, 0.0, -100000, newEventOutcomeAudit(1))
method step(TakeBuyAdmission self, bool enabled, bool useNoiseGate, bool takeoverPulsePrevious, bool cycleArmed, int eveState, int armBar, float takeover, float continuation, float eveScore, float decisionBoundary, bool useRegimeRouter, bool regimeReady, bool bearRegime, float counterRegimeMin, float dominanceMargin, float structureEvidence, bool isFlat, bool baseBuyNow, bool confirmedSellNow, float targetAtr, float stopAtr, int horizon, int limit) =>
    self.pulse := false
    self.quality := 100.0 * sigmoidSafe(1.35 * (eveScore - decisionBoundary) + 1.50 * (takeover - continuation))
    bool noisePass = not useNoiseGate or (takeover >= 0.20 and takeover >= continuation + 0.04)
    bool persistent = takeoverPulsePrevious and cycleArmed and eveState > 0 and eveState < 4 and takeover > continuation and noisePass
    bool regimePass = not useRegimeRouter or not regimeReady or not bearRegime or (self.quality >= counterRegimeMin and takeover >= continuation + dominanceMargin and structureEvidence >= 0.20)
    bool unusedEpisode = armBar > -100000 and armBar != self.consumedArmBar
    self.pulse := enabled and barstate.isconfirmed and persistent and regimePass and unusedEpisode and isFlat and not baseBuyNow and not confirmedSellNow
    self.executedAudit.update(targetAtr, stopAtr, horizon, limit)
    self
method auditExecution(TakeBuyAdmission self, bool executed, EpisodeEventObserver observer, float atrNow) =>
    float unit = math.max(atrNow, syminfo.mintick)
    float displacementAtr = observer.active and not na(observer.extremePrice) ? math.max(close - observer.extremePrice, 0.0) / unit : na
    float executionLag = observer.takeoverLag + 1.0
    self.executedAudit.add(executed, displacementAtr, executionLag, atrNow)
    self
method consume(TakeBuyAdmission self, int armBar) =>
    self.consumedArmBar := armBar
    self
// ============================================================================
// TRINITY S10.20.2 SAFE — TAKE CANDIDATE AUDIT PATCH
// Diagnostic-only module: it does not change BUY/SELL signals, order sizing,
// SL or TP logic.
//
// Audit semantics:
//   CANDIDATE = confirmed raw TAKE candidate on the executable persistence bar.
//   REJECTED  = execution is enabled, but this candidate does not become a
//               TAKE order on the same confirmed bar (noise/regime/state/flat/
//               conflict/can-buy gate rejected it).
//   EXECUTED  = the exact TAKE predicate that enters the LONG branch is true.
//
// IMPORTANT: eventTelemetry.bottom.takeoverPulse is a UDT field. Snapshot it
// into a scalar series before using [1]. Never write
// eventTelemetry.bottom.takeoverPulse[1] directly.
// ============================================================================
type TakeCandidateAudit
    int candidateCount
    int rejectedCount
    int executedCount
    int resolutionErrors
    bool candidatePulse
    int candidateArmBar
    array<int> eventBars
    array<int> armBars
    array<float> takeovers
    array<float> continuations
    array<float> margins
    array<int> states

newTakeCandidateAudit() =>
    TakeCandidateAudit.new(
         0, 0, 0, 0, false, -100000,
         array.new<int>(), array.new<int>(),
         array.new<float>(), array.new<float>(), array.new<float>(),
         array.new<int>())

// state: 1 = CANDIDATE (shadow/unresolved), 2 = REJECTED, 3 = EXECUTED.
method capture(TakeCandidateAudit self, bool candidateNow, int armBar,
               float takeover, float continuation, int retainedRows) =>
    self.candidatePulse := candidateNow
    self.candidateArmBar := candidateNow ? armBar : -100000
    if candidateNow
        float margin = takeover - continuation
        self.candidateCount += 1
        array.push(self.eventBars, bar_index)
        array.push(self.armBars, armBar)
        array.push(self.takeovers, takeover)
        array.push(self.continuations, continuation)
        array.push(self.margins, margin)
        array.push(self.states, 1)
        while array.size(self.eventBars) > retainedRows
            array.shift(self.eventBars)
            array.shift(self.armBars)
            array.shift(self.takeovers)
            array.shift(self.continuations)
            array.shift(self.margins)
            array.shift(self.states)
    self

// Resolve only the newest unresolved row belonging to the current TAKE event.
// This prevents a repeated armBar from rewriting an older historical row.
method resolve(TakeCandidateAudit self, bool executionEnabled,
               bool executedNow) =>
    if barstate.isconfirmed and executionEnabled and self.candidatePulse
        int foundIndex = -1
        int rowCount = array.size(self.states)
        if rowCount > 0
            for offset = 0 to rowCount - 1
                int idx = rowCount - 1 - offset
                bool sameArm = array.get(self.armBars, idx) == self.candidateArmBar
                bool unresolved = array.get(self.states, idx) == 1
                if sameArm and unresolved
                    foundIndex := idx
                    break
        if foundIndex >= 0
            if executedNow
                array.set(self.states, foundIndex, 3)
                self.executedCount += 1
            else
                array.set(self.states, foundIndex, 2)
                self.rejectedCount += 1
        else
            self.resolutionErrors += 1
    self

method renderTakeCandidateAudit(TakeCandidateAudit self, table auditTable,
                                int visibleRows) =>
    if barstate.islast
        table.clear(auditTable, 0, 0, 7, 14)

        color headerBg = color.rgb(31, 41, 55)
        color neutralBg = color.rgb(17, 24, 39)
        color candidateBg = color.rgb(55, 65, 81)
        color rejectedBg = color.rgb(127, 29, 29)
        color executedBg = color.rgb(6, 95, 70)
        color weakMarginBg = color.rgb(120, 53, 15)

        table.cell(auditTable, 0, 0, "TAKE AUDIT", text_color=color.white,
             bgcolor=headerBg, text_size=size.tiny)
        table.cell(auditTable, 1, 0, "C " + str.tostring(self.candidateCount),
             text_color=color.white, bgcolor=headerBg, text_size=size.tiny)
        table.cell(auditTable, 2, 0, "R " + str.tostring(self.rejectedCount),
             text_color=color.white, bgcolor=rejectedBg, text_size=size.tiny)
        table.cell(auditTable, 3, 0, "E " + str.tostring(self.executedCount),
             text_color=color.white, bgcolor=executedBg, text_size=size.tiny)
        table.cell(auditTable, 4, 0, "ERR " + str.tostring(self.resolutionErrors),
             text_color=color.white, bgcolor=headerBg, text_size=size.tiny)
        table.cell(auditTable, 5, 0, "", bgcolor=headerBg)
        table.cell(auditTable, 6, 0, "", bgcolor=headerBg)
        table.cell(auditTable, 7, 0, "", bgcolor=headerBg)

        table.cell(auditTable, 0, 1, "BAR", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)
        table.cell(auditTable, 1, 1, "TAKEOVER", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)
        table.cell(auditTable, 2, 1, "CONT", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)
        table.cell(auditTable, 3, 1, "MARGIN", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)
        table.cell(auditTable, 4, 1, "ARM", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)
        table.cell(auditTable, 5, 1, "CAND", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)
        table.cell(auditTable, 6, 1, "REJ", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)
        table.cell(auditTable, 7, 1, "EXEC", text_color=color.silver,
             bgcolor=neutralBg, text_size=size.tiny)

        int storedRows = array.size(self.eventBars)
        int shownRows = math.min(storedRows, visibleRows)
        if shownRows > 0
            for row = 0 to shownRows - 1
                int idx = storedRows - 1 - row
                int outputRow = row + 2
                int state = array.get(self.states, idx)
                float takeover = array.get(self.takeovers, idx)
                float continuation = array.get(self.continuations, idx)
                float margin = array.get(self.margins, idx)
                bool isRejected = state == 2
                bool isExecuted = state == 3
                color marginBg = margin >= 0.04 ? neutralBg : weakMarginBg

                table.cell(auditTable, 0, outputRow,
                     str.tostring(array.get(self.eventBars, idx)),
                     text_color=color.white, bgcolor=neutralBg, text_size=size.tiny)
                table.cell(auditTable, 1, outputRow, str.tostring(takeover, "#.000"),
                     text_color=color.white, bgcolor=neutralBg, text_size=size.tiny)
                table.cell(auditTable, 2, outputRow, str.tostring(continuation, "#.000"),
                     text_color=color.white, bgcolor=neutralBg, text_size=size.tiny)
                table.cell(auditTable, 3, outputRow, str.tostring(margin, "#.000"),
                     text_color=color.white, bgcolor=marginBg, text_size=size.tiny)
                table.cell(auditTable, 4, outputRow,
                     str.tostring(array.get(self.armBars, idx)),
                     text_color=color.white, bgcolor=neutralBg, text_size=size.tiny)
                table.cell(auditTable, 5, outputRow, "YES",
                     text_color=color.white, bgcolor=candidateBg, text_size=size.tiny)
                table.cell(auditTable, 6, outputRow, isRejected ? "YES" : "-",
                     text_color=color.white,
                     bgcolor=isRejected ? rejectedBg : neutralBg, text_size=size.tiny)
                table.cell(auditTable, 7, outputRow, isExecuted ? "YES" : "-",
                     text_color=color.white,
                     bgcolor=isExecuted ? executedBg : neutralBg, text_size=size.tiny)
    self
// Shadow-only observer. Keeping this state machine in a method protects Pine's
// main-body limit and makes it structurally impossible for telemetry to trade.
type LeadObservatory
    int side
    int trackedArmBar
    int extremeBar
    float extremePrice
    int decayBar
    int defenseBar
    int candidateBar
    float candidatePrice
    float candidateAtr
    float candidateScore
    float previousScore
    bool candidateSeen
    bool pulse
    float victoryExtremeLag
    float victoryArmLag
    float victoryDecayLag
    float victoryDefenseLag
    float victoryDisplacementAtr
    float victoryLeadBars
    float victoryLeadEdgeAtr

// Diagnostic-only causal funnel. It counts where a DEFENSE-stage LEAD
// candidate is rejected. No field from this object can reach execution.
type LeadFunnel
    int defense
    int score
    int rising
    int dominance
    int displacement
    int kinematic
    int geometry
    int candle
    int trend
    int eligible
    float maxScore
    float minDisplacement
    float maxKinematic
    int x100
    int x125
    int x150
    int x200
    int x250
    int x300
    float dominantMinDisplacement
    float dominantMaxDisplacement
    float dominantSumDisplacement
    int dominantKinematic
    int dominantGeometry
    int dominantCandle
    int dominantTrend
    int dominantAllWithoutDisplacement
method step(LeadFunnel self, bool enabled, int eveState, bool candidateSeen, float scoreNow, float boundary, float scorePrevious, float takeover, float continuation, float dominanceMin, float displacementAtr, float maxDisplacementAtr, float kinematic, bool geometry, bool directionalCandle, bool trendPass) =>
    if barstate.isconfirmed and enabled and not candidateSeen and eveState == 3
        self.defense += 1
        self.maxScore := math.max(nz(self.maxScore, scoreNow), scoreNow)
        self.minDisplacement := na(self.minDisplacement) ? displacementAtr : math.min(self.minDisplacement, displacementAtr)
        self.maxKinematic := math.max(nz(self.maxKinematic, kinematic), kinematic)
        bool passScore = scoreNow >= boundary
        bool passRising = passScore and scoreNow > scorePrevious
        bool passDominance = passRising and takeover >= continuation + dominanceMin
        if passDominance
            self.x100 += displacementAtr <= 1.00 ? 1 : 0
            self.x125 += displacementAtr <= 1.25 ? 1 : 0
            self.x150 += displacementAtr <= 1.50 ? 1 : 0
            self.x200 += displacementAtr <= 2.00 ? 1 : 0
            self.x250 += displacementAtr <= 2.50 ? 1 : 0
            self.x300 += displacementAtr <= 3.00 ? 1 : 0
            self.dominantMinDisplacement := na(self.dominantMinDisplacement) ? displacementAtr : math.min(self.dominantMinDisplacement, displacementAtr)
            self.dominantMaxDisplacement := na(self.dominantMaxDisplacement) ? displacementAtr : math.max(self.dominantMaxDisplacement, displacementAtr)
            self.dominantSumDisplacement += displacementAtr
            bool rawKinematic = kinematic > 0.0
            self.dominantKinematic += rawKinematic ? 1 : 0
            self.dominantGeometry += geometry ? 1 : 0
            self.dominantCandle += directionalCandle ? 1 : 0
            self.dominantTrend += trendPass ? 1 : 0
            self.dominantAllWithoutDisplacement += (rawKinematic and geometry and directionalCandle and trendPass) ? 1 : 0
        bool passDisplacement = passDominance and displacementAtr <= maxDisplacementAtr
        bool passKinematic = passDisplacement and kinematic > 0.0
        bool passGeometry = passKinematic and geometry
        bool passCandle = passGeometry and directionalCandle
        bool passTrend = passCandle and trendPass
        self.score += passScore ? 1 : 0
        self.rising += passRising ? 1 : 0
        self.dominance += passDominance ? 1 : 0
        self.displacement += passDisplacement ? 1 : 0
        self.kinematic += passKinematic ? 1 : 0
        self.geometry += passGeometry ? 1 : 0
        self.candle += passCandle ? 1 : 0
        self.trend += passTrend ? 1 : 0
        self.eligible += passTrend ? 1 : 0
    self
method step(LeadObservatory self, bool enabled, int eveState, int eveArmBar, bool victoryPulse, bool cycleArmed, float cycleExtremePrice, float leadScore, float boundary, float takeover, float continuation, float dominanceMin, float displacementAtr, float maxDisplacementAtr, float kinematic, bool geometry, bool directionalCandle, bool trendPass, float atrNow) =>
    self.pulse := false
    self.victoryExtremeLag := na
    self.victoryArmLag := na
    self.victoryDecayLag := na
    self.victoryDefenseLag := na
    self.victoryDisplacementAtr := na
    self.victoryLeadBars := na
    self.victoryLeadEdgeAtr := na
    if barstate.isconfirmed
        bool newEpisode = eveState == 1 and eveArmBar != self.trackedArmBar
        bool newExtreme = cycleArmed and not na(cycleExtremePrice) and (na(self.extremePrice) or (self.side == 1 ? cycleExtremePrice < self.extremePrice : cycleExtremePrice > self.extremePrice))
        if newEpisode
            self.trackedArmBar := eveArmBar
            self.extremeBar := bar_index
            self.extremePrice := cycleExtremePrice
            self.decayBar := -100000
            self.defenseBar := -100000
            self.candidateBar := -100000
            self.candidatePrice := na
            self.candidateAtr := na
            self.candidateScore := na
            self.previousScore := 0.0
            self.candidateSeen := false
        else if newExtreme
            self.extremeBar := bar_index
            self.extremePrice := cycleExtremePrice
            self.candidateBar := -100000
            self.candidatePrice := na
            self.candidateAtr := na
            self.candidateScore := na
            self.candidateSeen := false
        if eveState == 2 and self.decayBar == -100000
            self.decayBar := bar_index
        if eveState == 3 and self.defenseBar == -100000
            self.defenseBar := bar_index
        bool observation = enabled and not self.candidateSeen and eveState == 3 and leadScore >= boundary and leadScore > self.previousScore and takeover >= continuation + dominanceMin and displacementAtr <= maxDisplacementAtr and kinematic > 0.0 and geometry and directionalCandle and trendPass
        if observation
            self.pulse := true
            self.candidateSeen := true
            self.candidateBar := bar_index
            self.candidatePrice := close
            self.candidateAtr := math.max(atrNow, syminfo.mintick)
            self.candidateScore := leadScore
        self.previousScore := cycleArmed ? leadScore : 0.0
        if victoryPulse
            self.victoryExtremeLag := self.extremeBar > -100000 ? bar_index - self.extremeBar : na
            self.victoryArmLag := bar_index - eveArmBar
            self.victoryDecayLag := self.decayBar > -100000 ? bar_index - self.decayBar : na
            self.victoryDefenseLag := self.defenseBar > -100000 ? bar_index - self.defenseBar : na
            self.victoryDisplacementAtr := displacementAtr
            self.victoryLeadBars := self.candidateSeen ? bar_index - self.candidateBar : na
            self.victoryLeadEdgeAtr := self.candidateSeen ? (self.side == 1 ? close - self.candidatePrice : self.candidatePrice - close) / math.max(self.candidateAtr, syminfo.mintick) : na
    self
routeName(int route) =>
    switch route
        1 => "REV-S"
        3 => "STRUCT"
        5 => "REV-P"
        6 => "REV-T"
        8 => "REV-X"
        9 => "CAR"
        10 => "EVE"
        => "NONE"
capitalIntelligenceScale(bool enabled, float baseQty, float exposureQty, float referenceUtilization, float convexity, float minimumScale, float memoryScale) =>
    float utilization = exposureQty > 0 ? clamp01(baseQty / exposureQty) : 1.0
    float geometryScale = enabled ? clamp(math.pow(utilization / math.max(referenceUtilization, 0.01), convexity), minimumScale, 1.0) : 1.0
    enabled ? clamp(geometryScale * memoryScale, minimumScale, 1.0) : 1.0
causalRiskSurfaceScale(bool enabled, int direction, float allocation, float opposingShortSeverity, float minimumScale, float longFragileCeiling, float longFragileWidth, float shortUncertaintyCenter, float shortUncertaintyHalfWidth) =>
    float safeLongWidth = math.max(longFragileWidth, 0.01)
    float safeShortWidth = math.max(shortUncertaintyHalfWidth, 0.01)
    float longFragility = direction == 1 ? clamp01((longFragileCeiling + safeLongWidth - allocation) / safeLongWidth) : 0.0
    float shortUncertainty = direction == -1 ? clamp01(1.0 - math.abs(allocation - shortUncertaintyCenter) / safeShortWidth) : 0.0
    float regimeFragility = direction == -1 ? clamp01(opposingShortSeverity) : 0.0
    float fragility = math.max(longFragility, math.max(shortUncertainty, regimeFragility))
    enabled ? 1.0 - (1.0 - minimumScale) * fragility : 1.0
shortOpposingRiskSeverity(bool eveRoute, bool regimeReady, float regimeScore, float unsafeScore, float scoreWidth, float regimeDriftAtr, float bullDriftAtr, float regimeSpreadAtr) =>
    float scoreSeverity = eveRoute and regimeReady ? clamp01((regimeScore - unsafeScore) / math.max(scoreWidth, 0.01)) : 0.0
    float driftSeverity = eveRoute and regimeReady and regimeSpreadAtr > 0.0 ? clamp01(regimeDriftAtr - bullDriftAtr) : 0.0
    math.max(scoreSeverity, driftSeverity)
deferredRouteMinimum(int route, int direction) =>
    switch route
        1 => direction == 1 ? strategyGreyBuyRevSMin : strategyGreySellRevSMin
        3 => strategyDeferredStructMin
        5 => direction == 1 ? strategyGreyBuyRevPMin : strategyGreySellRevPMin
        9 => strategyDeferredCarMin
        10 => strategyDeferredEveMin
        => 101.0
deferredRouteEligible(int route, float quality, int direction) =>
    (route == 1 or route == 3 or route == 5 or route == 9 or route == 10) and quality >= deferredRouteMinimum(route, direction)
behavior(string speed) =>
    float rate = switch speed
        "Glacier"  => 0.06
        "Slow"     => 0.11
        "Balanced" => 0.20
        "Fast"     => 0.32
        =>              0.50
    float deadband = switch speed
        "Glacier"  => 2.00
        "Slow"     => 1.50
        "Balanced" => 1.05
        "Fast"     => 0.80
        =>              0.60
    float processRatio = switch speed
        "Glacier"  => 0.020
        "Slow"     => 0.035
        "Balanced" => 0.050
        "Fast"     => 0.080
        =>              0.120
    float cusumThreshold = switch speed
        "Glacier"  => 9.0
        "Slow"     => 7.5
        "Balanced" => 6.0
        "Fast"     => 4.5
        =>              3.5
    [rate, deadband, processRatio, cusumThreshold]
//=============================================================================
// Robust local-linear Kalman and monotone Ratchet
//=============================================================================
type KalmanState
    float level
    float slope
    float levelVar
    float covariance
    float slopeVar
    float noiseMult
    float baseNoise
    float cusumPos
    float cusumNeg
    int cooldown
newKalman() => KalmanState.new(na, 0.0, na, 0.0, na, 1.0, na, 0.0, 0.0, 0)
method step(KalmanState self, float observation, float trueRange, float processRatio, float cusumThreshold) =>
    if na(self.baseNoise)
        self.level := observation
        if trueRange > 0
            self.baseNoise := math.max(math.pow(0.5 * trueRange, 2.0), 1e-12)
            self.levelVar := self.baseNoise * 10.0
            self.slopeVar := self.baseNoise * 0.1
    float center = self.level
    float innovationDev = 0.0
    float slopeZ = 0.0
    bool changeUp = false
    bool changeDown = false
    if not na(self.baseNoise)
        // The original engine permanently anchored its absolute scale to the first moving bar.
        // A very slow update keeps the robust seed but lets the model survive long volatility regime changes.
        float observedNoise = math.max(math.pow(0.5 * trueRange, 2.0), 1e-12)
        self.baseNoise := 0.998 * self.baseNoise + 0.002 * observedNoise
        float measurementNoise = self.baseNoise * self.noiseMult
        float processNoise = processRatio * measurementNoise
        float predictedLevel = self.level + self.slope
        float predictedSlope = self.slope
        float predictedLevelVar = self.levelVar + 2.0 * self.covariance + self.slopeVar + processNoise / 3.0
        float predictedCov = self.covariance + self.slopeVar + processNoise * 0.5
        float predictedSlopeVar = self.slopeVar + processNoise
        float innovationVar = math.max(predictedLevelVar + measurementNoise, 1e-18)
        float innovation = observation - predictedLevel
        innovationDev := math.sqrt(innovationVar)
        float zInnovation = innovation / innovationDev
        float huberWeight = math.abs(zInnovation) <= 2.5 ? 1.0 : 2.5 / math.abs(zInnovation)
        float robustInnovation = innovation * huberWeight
        float levelGain = predictedLevelVar / innovationVar
        float slopeGain = predictedCov / innovationVar
        self.level := predictedLevel + levelGain * robustInnovation
        self.slope := predictedSlope + slopeGain * robustInnovation
        self.levelVar := math.max(predictedLevelVar - levelGain * predictedLevelVar, 1e-18)
        self.covariance := predictedCov - levelGain * predictedCov
        self.slopeVar := math.max(predictedSlopeVar - slopeGain * predictedCov, 1e-18)
        self.cusumPos := math.max(0.0, self.cusumPos + zInnovation - 0.5)
        self.cusumNeg := math.max(0.0, self.cusumNeg - zInnovation - 0.5)
        changeUp := self.cusumPos > cusumThreshold
        changeDown := self.cusumNeg > cusumThreshold
        if changeUp or changeDown
            self.cooldown := 10
            self.cusumPos := 0.0
            self.cusumNeg := 0.0
        float adaptGain = self.cooldown > 0 ? 0.15 : 0.02
        self.cooldown := math.max(0, self.cooldown - 1)
        if bar_index > 10
            float normalizedInnovation = innovation * innovation / innovationVar
            self.noiseMult := clamp(self.noiseMult * math.exp(adaptGain * (math.min(normalizedInnovation, 9.0) - 1.0)), 0.25, 16.0)
        center := self.level
        slopeZ := self.slope / math.sqrt(self.slopeVar)
    [center, innovationDev, slopeZ, changeUp, changeDown]
type RatchetState
    float level
    int leg
    bool trendOn
newRatchet() => RatchetState.new(na, 0, false)
method step(RatchetState self, float center, float innovationDev, float slopeZ, bool changeUp, bool changeDown,
            float rate, float deadband, float acceleration) =>
    if na(self.level)
        self.level := center
    float conviction = math.abs(slopeZ)
    float band = deadband * innovationDev
    float freezeTolerance = 0.15 * band
    float error = center - self.level
    if self.trendOn and conviction < 0.35
        self.trendOn := false
    else if not self.trendOn and conviction > 1.0
        self.trendOn := true
    float velocity = rate * innovationDev
    if self.leg == 0
        float effectiveBand = band * (1.0 - acceleration * clamp01(conviction))
        if error > effectiveBand or (self.trendOn and error > freezeTolerance)
            self.leg := 1
        else if error < -effectiveBand or (self.trendOn and error < -freezeTolerance)
            self.leg := -1
    if self.leg == 1 and error < -band and changeDown and conviction > 0.35
        self.leg := -1
    else if self.leg == -1 and error > band and changeUp and conviction > 0.35
        self.leg := 1
    if self.leg == 1
        self.level += math.min(velocity, math.max(error, 0.0))
        if center - self.level <= freezeTolerance and not self.trendOn
            self.leg := 0
    else if self.leg == -1
        self.level -= math.min(velocity, math.max(-error, 0.0))
        if self.level - center <= freezeTolerance and not self.trendOn
            self.leg := 0
    [self.level, self.leg, band, self.trendOn]
float safeClose = math.max(close, syminfo.mintick)
float safeHigh = math.max(high, syminfo.mintick)
float safeLow = math.max(low, syminfo.mintick)
float previousSafe = math.max(nz(close[1], open), syminfo.mintick)
float observation = useLog ? math.log(safeClose) : close
float trueRangeGeometry = useLog ? math.max(math.log(safeHigh) - math.log(safeLow), math.max(math.abs(math.log(safeHigh) - math.log(previousSafe)), math.abs(math.log(safeLow) - math.log(previousSafe)))) : ta.tr(true)
[fastRate, fastDeadband, fastProcess, fastCusum] = behavior(fastSpeed)
[slowRate, slowDeadband, slowProcess, slowCusum] = behavior(slowSpeed)
var KalmanState fastKalman = newKalman()
var RatchetState fastRatchet = newRatchet()
[fastCenter, fastInnovation, fastSlopeZ, fastChangeUp, fastChangeDown] = fastKalman.step(observation, trueRangeGeometry, fastProcess, fastCusum)
[fastRailGeometry, fastLeg, fastBand, fastTrendOn] = fastRatchet.step(fastCenter, fastInnovation, fastSlopeZ, fastChangeUp, fastChangeDown, fastRate, fastDeadband, entryAccel)
var KalmanState slowKalman = newKalman()
var RatchetState slowRatchet = newRatchet()
[slowCenter, slowInnovation, slowSlopeZ, slowChangeUp, slowChangeDown] = slowKalman.step(observation, trueRangeGeometry, slowProcess, slowCusum)
[slowRailGeometry, slowLeg, slowBand, slowTrendOn] = slowRatchet.step(slowCenter, slowInnovation, slowSlopeZ, slowChangeUp, slowChangeDown, slowRate, slowDeadband, 0.0)
float fastRail = useLog ? math.exp(fastRailGeometry) : fastRailGeometry
bool fastFlipUp = barstate.isconfirmed and fastLeg == 1 and nz(fastLeg[1], 0) != 1
bool fastFlipDown = barstate.isconfirmed and fastLeg == -1 and nz(fastLeg[1], 0) != -1
//=============================================================================
// Confirmed FLI: Bollinger breakout changes the direction of an ATR ratchet
//=============================================================================
float bbBasis = ta.sma(close, bbLen)
float bbSigma = ta.stdev(close, bbLen)
float bbUpper = bbBasis + bbDev * bbSigma
float bbLower = bbBasis - bbDev * bbSigma
float fliAtr = ta.atr(fliAtrLen) * fliAtrMult
int bbSignal = close > bbUpper ? 1 : close < bbLower ? -1 : 0
var float fliLine = na
var int fliDir = 0
float previousFliLine = nz(fliLine[1], close)
int previousFliDir = nz(fliDir[1], 0)
float nextFliLine = previousFliLine
int nextFliDir = previousFliDir
if bbSignal == 1
    float proposedLong = low - fliAtr
    nextFliLine := previousFliDir == 1 ? math.max(previousFliLine, proposedLong) : proposedLong
    nextFliDir := 1
else if bbSignal == -1
    float proposedShort = high + fliAtr
    nextFliLine := previousFliDir == -1 ? math.min(previousFliLine, proposedShort) : proposedShort
    nextFliDir := -1
if barstate.isconfirmed
    fliLine := nextFliLine
    fliDir := nextFliDir
else
    fliLine := previousFliLine
    fliDir := previousFliDir
bool fliFlipUp = barstate.isconfirmed and fliDir == 1 and nz(fliDir[1], 0) != 1
bool fliFlipDown = barstate.isconfirmed and fliDir == -1 and nz(fliDir[1], 0) != -1
//=============================================================================
// Exhaustion Index 2.0
// Four less-redundant families: momentum, range location, flow, ATR stretch.
// Quiet volatility tightens the extreme threshold; it no longer crushes the score toward 50.
//=============================================================================
float atr = ta.atr(14)
float atrBase = nz(ta.sma(atr, 50), atr)
float atrRatio = atrBase > 0 ? atr / atrBase : 1.0
float volumeBase = nz(ta.sma(volume, 30), volume)
float volumeRatio = not na(volume) and volumeBase > 0 ? volume / volumeBase : 1.0
float rsiScore = nz(ta.rsi(close, exLen), 50.0)
float stochScore = nz(ta.stoch(close, high, low, exLen), 50.0)
float mfiValue = ta.mfi(hlc3, exLen)
float flowScore = na(mfiValue) ? rsiScore : mfiValue
float fairValue = ta.ema(close, exLen)
float stretchZ = atr > 0 ? (close - fairValue) / atr : 0.0
float stretchScore = 50.0 + 50.0 * tanhSafe(stretchZ / 2.0)
float rawExhaustion = 0.30 * rsiScore + 0.25 * stochScore + 0.25 * flowScore + 0.20 * stretchScore
float exhaustion = ta.ema(clamp(rawExhaustion, 0.0, 100.0), exSmooth)
float volatilityQuality = clamp01((atrRatio - 0.70) / 0.60)
float participationQuality = clamp01((volumeRatio - 0.50) / 1.00)
float marketQuality = 0.75 * volatilityQuality + 0.25 * participationQuality
float quietPenalty = (1.0 - marketQuality) * 6.0
float dynamicLow = clamp(exLowBase - quietPenalty, 5.0, 45.0)
float dynamicHigh = clamp(exHighBase + quietPenalty, 55.0, 95.0)
float priorLow = ta.lowest(low[1], sweepLen)
float priorHigh = ta.highest(high[1], sweepLen)
float candleRange = math.max(high - low, syminfo.mintick)
float closePosition = (close - low) / candleRange
bool bullSweep = low < priorLow and close > priorLow and close > open and closePosition >= reclaimPos
bool bearSweep = high > priorHigh and close < priorHigh and close < open and closePosition <= 1.0 - reclaimPos
var int longArmBar = na
var int shortArmBar = na
var int longSweepBar = na
var int shortSweepBar = na
var int longRecoveryBar = na
var int shortRecoveryBar = na
var int lastBullSweepBar = na
var int lastBearSweepBar = na
var bool lowCriticalEpisode = false
var bool highCriticalEpisode = false
var float lowCriticalExtreme = na
var float highCriticalExtreme = na
var label lowCriticalLabel = na
var label highCriticalLabel = na
bool criticalLowNow = barstate.isconfirmed and exhaustion <= dynamicLow
bool criticalHighNow = barstate.isconfirmed and exhaustion >= dynamicHigh
bool newLongArm = criticalLowNow and not lowCriticalEpisode
bool newShortArm = criticalHighNow and not highCriticalEpisode
if barstate.isconfirmed
    if bullSweep
        lastBullSweepBar := bar_index
    if bearSweep
        lastBearSweepBar := bar_index
    if not na(longArmBar) and bar_index - longArmBar > exMemory
        longArmBar := na
        longSweepBar := na
        longRecoveryBar := na
        lowCriticalEpisode := false
    if not na(shortArmBar) and bar_index - shortArmBar > exMemory
        shortArmBar := na
        shortSweepBar := na
        shortRecoveryBar := na
        highCriticalEpisode := false
    if newLongArm
        lowCriticalEpisode := true
        longArmBar := bar_index
        longSweepBar := not na(lastBullSweepBar) and bar_index - lastBullSweepBar <= 3 ? lastBullSweepBar : na
        longRecoveryBar := na
        lowCriticalExtreme := exhaustion
        if showExMarks
            lowCriticalLabel := label.new(bar_index, low, str.tostring(math.round(exhaustion)), yloc = yloc.belowbar,
                 style = label.style_none, textcolor = #00B884, size = size.small)
    else if lowCriticalEpisode and criticalLowNow and exhaustion < nz(lowCriticalExtreme, exhaustion + 1.0)
        lowCriticalExtreme := exhaustion
        longArmBar := bar_index
        if showExMarks and not na(lowCriticalLabel)
            label.set_xy(lowCriticalLabel, bar_index, low)
            label.set_text(lowCriticalLabel, str.tostring(math.round(exhaustion)))
    if newShortArm
        highCriticalEpisode := true
        shortArmBar := bar_index
        shortSweepBar := not na(lastBearSweepBar) and bar_index - lastBearSweepBar <= 3 ? lastBearSweepBar : na
        shortRecoveryBar := na
        highCriticalExtreme := exhaustion
        if showExMarks
            highCriticalLabel := label.new(bar_index, high, str.tostring(math.round(exhaustion)), yloc = yloc.abovebar,
                 style = label.style_none, textcolor = #D84A7F, size = size.small)
    else if highCriticalEpisode and criticalHighNow and exhaustion > nz(highCriticalExtreme, exhaustion - 1.0)
        highCriticalExtreme := exhaustion
        shortArmBar := bar_index
        if showExMarks and not na(highCriticalLabel)
            label.set_xy(highCriticalLabel, bar_index, high)
            label.set_text(highCriticalLabel, str.tostring(math.round(exhaustion)))
    if not na(longArmBar) and bullSweep
        longSweepBar := bar_index
    if not na(shortArmBar) and bearSweep
        shortSweepBar := bar_index
bool longArmed = not na(longArmBar) and bar_index - longArmBar <= exMemory
bool shortArmed = not na(shortArmBar) and bar_index - shortArmBar <= exMemory
bool longRecoveryPulse = barstate.isconfirmed and longArmed and exhaustion >= dynamicLow + exRecovery and exhaustion[1] < dynamicLow[1] + exRecovery
bool shortRecoveryPulse = barstate.isconfirmed and shortArmed and exhaustion <= dynamicHigh - exRecovery and exhaustion[1] > dynamicHigh[1] - exRecovery
if barstate.isconfirmed
    if longRecoveryPulse
        longRecoveryBar := bar_index
        lowCriticalEpisode := false
    if shortRecoveryPulse
        shortRecoveryBar := bar_index
        highCriticalEpisode := false
bool longRecovered = not na(longRecoveryBar) and bar_index - longRecoveryBar <= 3
bool shortRecovered = not na(shortRecoveryBar) and bar_index - shortRecoveryBar <= 3
bool longSweepSeen = not na(longSweepBar) and bar_index - longSweepBar <= exMemory
bool shortSweepSeen = not na(shortSweepBar) and bar_index - shortSweepBar <= exMemory
//=============================================================================
// Signal evidence v7.0: structural context and causal auction response
// and Directional Victory Transfer
//=============================================================================
// Significant swing zones. Nearby pivots are clustered and share one immutable zone identity.
float confirmedPivotHigh = ta.pivothigh(high, swingLeft, swingRight)
float confirmedPivotLow = ta.pivotlow(low, swingLeft, swingRight)
int pivotWindow = swingLeft + swingRight + 1
float pivotAtr = math.max(nz(atr[swingRight], atr), syminfo.mintick)
float pivotWindowLow = ta.lowest(low, pivotWindow)
float pivotWindowHigh = ta.highest(high, pivotWindow)
float highPivotProminence = not na(confirmedPivotHigh) ? (confirmedPivotHigh - pivotWindowLow) / pivotAtr : 0.0
float lowPivotProminence = not na(confirmedPivotLow) ? (pivotWindowHigh - confirmedPivotLow) / pivotAtr : 0.0
bool significantHighPivot = not na(confirmedPivotHigh) and highPivotProminence >= swingPromAtr
bool significantLowPivot = not na(confirmedPivotLow) and lowPivotProminence >= swingPromAtr
var float resistanceTop = na
var float resistanceBottom = na
var float previousResistanceCenter = na
var float resistanceProminence = 0.0
var int resistanceTouches = 0
var int resistanceZoneId = 0
var int resistancePivotBar = -100000
var float supportTop = na
var float supportBottom = na
var float previousSupportCenter = na
var float supportProminence = 0.0
var int supportTouches = 0
var int supportZoneId = 0
var int supportPivotBar = -100000
if barstate.isconfirmed
    float zoneHalf = 0.50 * zoneMergeAtr * pivotAtr
    if significantHighPivot
        float oldCenter = not na(resistanceTop) ? (resistanceTop + resistanceBottom) * 0.5 : na
        bool mergeHigh = not na(oldCenter) and math.abs(confirmedPivotHigh - oldCenter) <= zoneMergeAtr * pivotAtr
        if mergeHigh
            resistanceTop := math.max(resistanceTop, confirmedPivotHigh + zoneHalf)
            resistanceBottom := math.min(resistanceBottom, confirmedPivotHigh - zoneHalf)
            resistanceTouches += 1
            resistanceProminence := math.max(resistanceProminence, highPivotProminence)
            resistancePivotBar := bar_index - swingRight
        else
            previousResistanceCenter := oldCenter
            resistanceTop := confirmedPivotHigh + zoneHalf
            resistanceBottom := confirmedPivotHigh - zoneHalf
            resistanceTouches := 1
            resistanceProminence := highPivotProminence
            resistancePivotBar := bar_index - swingRight
            resistanceZoneId += 1
    if significantLowPivot
        float oldCenter = not na(supportTop) ? (supportTop + supportBottom) * 0.5 : na
        bool mergeLow = not na(oldCenter) and math.abs(confirmedPivotLow - oldCenter) <= zoneMergeAtr * pivotAtr
        if mergeLow
            supportTop := math.max(supportTop, confirmedPivotLow + zoneHalf)
            supportBottom := math.min(supportBottom, confirmedPivotLow - zoneHalf)
            supportTouches += 1
            supportProminence := math.max(supportProminence, lowPivotProminence)
            supportPivotBar := bar_index - swingRight
        else
            previousSupportCenter := oldCenter
            supportTop := confirmedPivotLow + zoneHalf
            supportBottom := confirmedPivotLow - zoneHalf
            supportTouches := 1
            supportProminence := lowPivotProminence
            supportPivotBar := bar_index - swingRight
            supportZoneId += 1
float resistanceCenter = not na(resistanceTop) ? (resistanceTop + resistanceBottom) * 0.5 : na
float supportCenter = not na(supportTop) ? (supportTop + supportBottom) * 0.5 : na
bool structureReady = not na(resistanceCenter) and not na(supportCenter)
bool bullStructure = structureReady and not na(previousResistanceCenter) and not na(previousSupportCenter) and resistanceCenter > previousResistanceCenter and supportCenter > previousSupportCenter
bool bearStructure = structureReady and not na(previousResistanceCenter) and not na(previousSupportCenter) and resistanceCenter < previousResistanceCenter and supportCenter < previousSupportCenter
float structuralRangeHigh = ta.highest(high[1], rangeLen)
float structuralRangeLow = ta.lowest(low[1], rangeLen)
float macroHigh = ta.highest(high[1], macroLen)
float macroLow = ta.lowest(low[1], macroLen)
bool resistanceAtRangeEdge = not na(resistanceTop) and resistanceTop >= structuralRangeHigh - zoneMergeAtr * atr
bool supportAtRangeEdge = not na(supportBottom) and supportBottom <= structuralRangeLow + zoneMergeAtr * atr
// Compression is an armed setup. Chop risk is evaluated separately.
float atrFastMean = ta.sma(atr, compressionLen)
float atrBaseMean = ta.sma(atr, compressionBase)
float bbWidth = bbBasis != 0 ? (bbUpper - bbLower) / math.abs(bbBasis) : 0.0
float bbWidthBase = ta.sma(bbWidth, compressionBase)
bool atrCompressed = atrBaseMean > 0 and atrFastMean <= atrBaseMean * compressionRatio
bool bbCompressed = bbWidthBase > 0 and bbWidth <= bbWidthBase * compressionRatio
bool compressionRaw = atrCompressed or bbCompressed
int compressionAgo = ta.barssince(compressionRaw[1])
bool compressionSeen = not na(compressionAgo) and compressionAgo <= compressionMemory
float efficiencyPath = math.sum(math.abs(ta.change(close)), chopErLen)
float efficiencyRatio = efficiencyPath > 0 ? math.abs(close - close[chopErLen]) / efficiencyPath : 0.0
[plusDIv5, minusDIv5, adxV5] = ta.dmi(chopAdxLen, chopAdxLen)
float adxWeakness = clamp01((25.0 - adxV5) / 10.0)
float erWeakness = clamp01((0.35 - efficiencyRatio) / 0.15)
float lrFast = ta.linreg(close, 8, 0)
float lrMid = ta.linreg(close, 21, 0)
float lrSlow = ta.linreg(close, 55, 0)
int biasFast = lrFast > lrFast[1] ? 1 : lrFast < lrFast[1] ? -1 : 0
int biasMid = lrMid > lrMid[1] ? 1 : lrMid < lrMid[1] ? -1 : 0
int biasSlow = lrSlow > lrSlow[1] ? 1 : lrSlow < lrSlow[1] ? -1 : 0
float structureDisagreement = biasFast != biasMid or biasMid != biasSlow ? 1.0 : 0.0
float chopRisk = 100.0 * (0.40 * adxWeakness + 0.35 * erWeakness + 0.25 * structureDisagreement)
// Robust volume rank and confirmed three-candle imbalance.
float volumeBelowCount = 0.0
float volumeValidCount = 0.0
for volumeIndex = 1 to volumePctLen
    if not na(volume[volumeIndex])
        volumeValidCount += 1.0
        volumeBelowCount += volume > volume[volumeIndex] ? 1.0 : 0.0
float volumePercentile = volumeValidCount > 0 ? 100.0 * volumeBelowCount / volumeValidCount : 50.0
bool volumeExpansion = volumePercentile >= volumePctMin
bool bullFvg = barstate.isconfirmed and bar_index >= 2 and low > high[2]
bool bearFvg = barstate.isconfirmed and bar_index >= 2 and high < low[2]
float candleBody = math.abs(close - open)
float candleRangeV5 = math.max(high - low, syminfo.mintick)
float bodyAtr = atr > 0 ? candleBody / atr : 0.0
float rangeAtr = atr > 0 ? candleRangeV5 / atr : 0.0
float directionalClose = (close - low) / candleRangeV5
// Causal impulse router. It does not use pivots or the visual Kalman speed settings.
// Direction comes from regression slopes, DMI balance, price location and directional persistence.
float midSlopeAtr = atr > 0 ? nz(lrMid - lrMid[impulseSlopeLen]) / (impulseSlopeLen * atr) : 0.0
float slowSlopeAtr = atr > 0 ? nz(lrSlow - lrSlow[impulseSlopeLen]) / (impulseSlopeLen * atr) : 0.0
float midSlopeDirection = tanhSafe(midSlopeAtr / 0.12)
float slowSlopeDirection = tanhSafe(slowSlopeAtr / 0.08)
float diBalance = (plusDIv5 + minusDIv5) > 0 ? (plusDIv5 - minusDIv5) / (plusDIv5 + minusDIv5) : 0.0
float priceLocationDirection = atr > 0 ? tanhSafe((close - lrMid) / (0.80 * atr)) : 0.0
float directionStep = close > close[1] ? 1.0 : close < close[1] ? -1.0 : 0.0
float directionalPersistence = nz(math.sum(directionStep, impulsePersistenceLen)) / impulsePersistenceLen
float impulseDirection = clamp(0.25 * midSlopeDirection + 0.20 * slowSlopeDirection + 0.25 * diBalance + 0.15 * priceLocationDirection + 0.15 * directionalPersistence, -1.0, 1.0)
float adxStrength = clamp01(nz(adxV5) / 35.0)
float efficiencyStrength = clamp01(efficiencyRatio / 0.55)
float impulseStrength = 0.55 * adxStrength + 0.45 * efficiencyStrength
float bullImpulseScore = 100.0 * math.max(impulseDirection, 0.0) * (0.65 + 0.35 * impulseStrength)
float bearImpulseScore = 100.0 * math.max(-impulseDirection, 0.0) * (0.65 + 0.35 * impulseStrength)
bool strongBullImpulse = bullImpulseScore >= impulseThreshold
bool strongBearImpulse = bearImpulseScore >= impulseThreshold
int bullImpulseAgo = ta.barssince(strongBullImpulse)
int bearImpulseAgo = ta.barssince(strongBearImpulse)
bool bullImpulseRecent = not na(bullImpulseAgo) and bullImpulseAgo <= impulseMemory
bool bearImpulseRecent = not na(bearImpulseAgo) and bearImpulseAgo <= impulseMemory
int impulseState = strongBullImpulse ? 1 : strongBearImpulse ? -1 : bullImpulseRecent and not bearImpulseRecent ? 1 : bearImpulseRecent and not bullImpulseRecent ? -1 : bullImpulseRecent and bearImpulseRecent ? (bullImpulseAgo < bearImpulseAgo ? 1 : -1) : 0
//=============================================================================
// Confirmed higher-timeframe regime router — strategy execution only
// Every requested series is shifted by one HTF bar and paired with lookahead_on.
// Therefore the router sees only the last completed HTF candle and cannot use a
// still-forming higher-timeframe value. Raw BUY/SELL events remain untouched.
//=============================================================================
[strategyRegimeClose, strategyRegimePastClose, strategyRegimeFastMean, strategyRegimeSlowMean, strategyRegimeAtr] = request.security(syminfo.tickerid, strategyRegimeTimeframe, [close[1], close[strategyRegimeDriftBars + 1], ta.ema(close, strategyRegimeFastLen)[1], ta.ema(close, strategyRegimeSlowLen)[1], ta.atr(strategyRegimeAtrLen)[1]], lookahead = barmerge.lookahead_on)
bool strategyRegimeReady = not na(strategyRegimeClose) and not na(strategyRegimePastClose) and not na(strategyRegimeFastMean) and not na(strategyRegimeSlowMean) and not na(strategyRegimeAtr) and strategyRegimeAtr > 0
float strategyRegimeDriftAtr = strategyRegimeReady ? (strategyRegimeClose - strategyRegimePastClose) / strategyRegimeAtr : 0.0
float strategyRegimeSpreadAtr = strategyRegimeReady ? (strategyRegimeFastMean - strategyRegimeSlowMean) / strategyRegimeAtr : 0.0
float strategyRegimeScore = strategyRegimeReady ? clamp(0.55 * tanhSafe(strategyRegimeDriftAtr / 4.0) + 0.45 * tanhSafe(strategyRegimeSpreadAtr / 1.50), -1.0, 1.0) : 0.0
bool strategyBullRegime = strategyRegimeReady and strategyRegimeScore >= strategyRegimeDirectionMin
bool strategyBearRegime = strategyRegimeReady and strategyRegimeScore <= -strategyRegimeDirectionMin
bool strategyShortEveOpposingRegime = strategyRegimeReady and (strategyRegimeScore > strategyShortEveUnsafeScore or (strategyRegimeDriftAtr > strategyShortEveBullDriftAtr and strategyRegimeSpreadAtr > 0.0))
bool strategyLongStructRegimePass = strategyAlwaysAllowBuyStruct or not strategyUseRegimeRouter or not strategyRegimeReady or not strategyBearRegime
bool strategyShortStructRegimePass = not strategyUseRegimeRouter or not strategyRegimeReady or not strategyBullRegime
bool strategyLongResolvedRegimePass = not strategyUseRegimeRouter or not strategyRegimeReady or not strategyBearRegime
bool strategyShortResolvedRegimePass = not strategyUseRegimeRouter or not strategyRegimeReady or not strategyBullRegime
bool strategyLongCarRegimePass = not strategyUseRegimeRouter or not strategyRegimeReady or (strategyRegimeScore >= strategyCarRegimeMin and impulseDirection >= strategyCarLocalDirectionMin and biasMid == 1)
bool strategyShortCarRegimePass = not strategyUseRegimeRouter or not strategyRegimeReady or (strategyRegimeScore <= -strategyCarRegimeMin and impulseDirection <= -strategyCarLocalDirectionMin and biasMid == -1)
//=============================================================================
// AERF: causal adaptive effort-response field
// The prior RLS coefficient predicts the current ATR-normalized response from signed effort.
// Only after the bar closes is the model updated, so the residual has no future leakage.
//=============================================================================
float aerfVolumeEffort = clamp01(volumePercentile / 100.0)
float aerfRangeParticipation = tanhSafe(rangeAtr / 1.25)
float aerfSignedForce = aerfVolumeEffort * aerfRangeParticipation * (2.0 * directionalClose - 1.0)
float aerfPriceResponse = atr > 0 ? (close - close[1]) / atr : 0.0
var float aerfBeta = 0.0
var float aerfCovariance = 10.0
float aerfBetaPrior = aerfBeta
float aerfExpectedResponse = aerfBetaPrior * aerfSignedForce
float aerfResidual = aerfPriceResponse - aerfExpectedResponse
if barstate.isconfirmed and bar_index > 1
    float aerfDenominator = aerfForgetting + aerfSignedForce * aerfSignedForce * aerfCovariance
    float aerfGain = aerfDenominator > 0 ? aerfCovariance * aerfSignedForce / aerfDenominator : 0.0
    aerfBeta := clamp(aerfBetaPrior + aerfGain * aerfResidual, -5.0, 5.0)
    aerfCovariance := clamp((aerfCovariance - aerfGain * aerfSignedForce * aerfCovariance) / aerfForgetting, 0.001, 100.0)
float aerfForceScale = math.max(nz(ta.ema(math.abs(aerfSignedForce), aerfScaleLen)[1], 0.05), 0.02)
float aerfResidualScale = math.max(nz(math.sqrt(ta.ema(aerfResidual * aerfResidual, aerfScaleLen)[1]), 0.10), 0.03)
float aerfDrive = ta.ema(aerfSignedForce, 3)
float aerfDriveChange = aerfDrive - aerfDrive[1]
float bullModelMismatch = aerfSignedForce < 0 ? clamp01(math.max(aerfResidual, 0.0) / (2.0 * aerfResidualScale)) : 0.0
float bearModelMismatch = aerfSignedForce > 0 ? clamp01(math.max(-aerfResidual, 0.0) / (2.0 * aerfResidualScale)) : 0.0
float bullDriveDecay = clamp01(math.max(aerfDriveChange, 0.0) / aerfForceScale)
float bearDriveDecay = clamp01(math.max(-aerfDriveChange, 0.0) / aerfForceScale)
float bullOpposingControl = clamp01((0.65 * math.max(aerfSignedForce, 0.0) + 0.35 * math.max(aerfDrive, 0.0)) / aerfForceScale)
float bearOpposingControl = clamp01((0.65 * math.max(-aerfSignedForce, 0.0) + 0.35 * math.max(-aerfDrive, 0.0)) / aerfForceScale)
float bullRetainedEnergy = clamp01(math.max(aerfDrive, 0.0) / (2.0 * aerfForceScale)) * efficiencyStrength
float bearRetainedEnergy = clamp01(math.max(-aerfDrive, 0.0) / (2.0 * aerfForceScale)) * efficiencyStrength
bool aerfReady = bar_index >= aerfWarmup and not na(aerfResidualScale)
bool bullDisplacement = close > open and bodyAtr >= bodyAtrMin and rangeAtr >= rangeAtrMin and directionalClose >= breakClosePos
bool bearDisplacement = close < open and bodyAtr >= bodyAtrMin and rangeAtr >= rangeAtrMin and directionalClose <= 1.0 - breakClosePos
bool bullExpansionEvidence = volumeExpansion or bullFvg
bool bearExpansionEvidence = volumeExpansion or bearFvg
bool bullCompressionRelease = compressionSeen and volumeExpansion and bullFvg
bool bearCompressionRelease = compressionSeen and volumeExpansion and bearFvg
bool longChopPass = chopRisk < chopBlock or bullCompressionRelease
bool shortChopPass = chopRisk < chopBlock or bearCompressionRelease
float breakBuffer = breakBufferAtr * atr
var int usedResistanceZoneId = -1
var int usedSupportZoneId = -1
bool resistanceFresh = structureReady and resistanceZoneId != usedResistanceZoneId
bool supportFresh = structureReady and supportZoneId != usedSupportZoneId
bool longBreakEvent = barstate.isconfirmed and resistanceFresh and close > resistanceTop + breakBuffer and close[1] <= resistanceTop + breakBuffer
bool shortBreakEvent = barstate.isconfirmed and supportFresh and close < supportBottom - breakBuffer and close[1] >= supportBottom - breakBuffer
// A compression release with both ranked volume and imbalance may confirm a real regime escape.
// Without that evidence, a counter-structure break still needs to occur at the outer range edge.
bool longMacroPermission = (not bearStructure or resistanceAtRangeEdge or bullCompressionRelease) and (not strongBearImpulse or bullCompressionRelease)
bool shortMacroPermission = (not bullStructure or supportAtRangeEdge or bearCompressionRelease) and (not strongBullImpulse or bearCompressionRelease)
float longChaseDistance = atr > 0 and not na(resistanceTop) ? math.max(0.0, close - resistanceTop) / atr : 99.0
float shortChaseDistance = atr > 0 and not na(supportBottom) ? math.max(0.0, supportBottom - close) / atr : 99.0
bool longNotChasing = longChaseDistance <= maxChaseAtr
bool shortNotChasing = shortChaseDistance <= maxChaseAtr
// Exhaustion is not a veto for momentum: powerful breakouts are naturally overbought/oversold.
// It remains the arming engine for the independent REV route below.
bool longBreakBaseValid = longBreakEvent and longMacroPermission and longNotChasing
bool shortBreakBaseValid = shortBreakEvent and shortMacroPermission and shortNotChasing
bool longObstacleKnown = not na(resistanceTop) and macroHigh > resistanceTop + syminfo.mintick
bool shortObstacleKnown = not na(supportBottom) and macroLow < supportBottom - syminfo.mintick
float longRoomAtr = longObstacleKnown and atr > 0 ? (macroHigh - resistanceTop) / atr : na
float shortRoomAtr = shortObstacleKnown and atr > 0 ? (supportBottom - macroLow) / atr : na
bool longRoomPass = not longObstacleKnown or longRoomAtr >= minRoomAtr
bool shortRoomPass = not shortObstacleKnown or shortRoomAtr >= minRoomAtr
float longRoomQuality = longObstacleKnown ? clamp01(longRoomAtr / math.max(minRoomAtr * 2.0, 0.01)) : 0.50
float shortRoomQuality = shortObstacleKnown ? clamp01(shortRoomAtr / math.max(minRoomAtr * 2.0, 0.01)) : 0.50
float longCloseQuality = clamp01((directionalClose - 0.50) / 0.40)
float shortCloseQuality = clamp01((0.50 - directionalClose) / 0.40)
float bodyQuality = clamp01(bodyAtr / math.max(bodyAtrMin, 0.01))
float candleExpansionQuality = clamp01(rangeAtr / math.max(rangeAtrMin, 0.01))
float longLevelQuality = 10.0 * clamp01(resistanceProminence / math.max(swingPromAtr * 2.0, 0.01)) + (resistanceTouches >= 2 ? 6.0 : 0.0) + (resistanceAtRangeEdge ? 4.0 : 0.0)
float shortLevelQuality = 10.0 * clamp01(supportProminence / math.max(swingPromAtr * 2.0, 0.01)) + (supportTouches >= 2 ? 6.0 : 0.0) + (supportAtRangeEdge ? 4.0 : 0.0)
float longDisplacementQuality = 10.0 * bodyQuality + 7.0 * candleExpansionQuality + 8.0 * longCloseQuality
float shortDisplacementQuality = 10.0 * bodyQuality + 7.0 * candleExpansionQuality + 8.0 * shortCloseQuality
float longExpansionQuality = 10.0 * clamp01(volumePercentile / 100.0) + (bullFvg ? 10.0 : 0.0)
float shortExpansionQuality = 10.0 * clamp01(volumePercentile / 100.0) + (bearFvg ? 10.0 : 0.0)
float regimeQuality = 15.0 * (1.0 - clamp01(chopRisk / 100.0))
float longSetupQuality = (compressionSeen ? 10.0 : 0.0) + (bullStructure ? 5.0 : 0.0) + (strongBullImpulse ? 5.0 : 0.0)
float shortSetupQuality = (compressionSeen ? 10.0 : 0.0) + (bearStructure ? 5.0 : 0.0) + (strongBearImpulse ? 5.0 : 0.0)
float longBreakQuality = clamp(longLevelQuality + longDisplacementQuality + longExpansionQuality + regimeQuality + longSetupQuality + 5.0 * longRoomQuality, 0.0, 100.0)
float shortBreakQuality = clamp(shortLevelQuality + shortDisplacementQuality + shortExpansionQuality + regimeQuality + shortSetupQuality + 5.0 * shortRoomQuality, 0.0, 100.0)
bool longDirectLevelPass = bullStructure or resistanceTouches >= 2 or resistanceAtRangeEdge
bool shortDirectLevelPass = bearStructure or supportTouches >= 2 or supportAtRangeEdge
// Only an evidence-backed origin may own a zone. It prints nothing on the breakout candle.
// The next bars must hold above/below the zone and print a separate acceptance close.
bool longQualifiedOrigin = longBreakBaseValid and longRoomPass and longDirectLevelPass and longChopPass and bullDisplacement and bullExpansionEvidence and longBreakQuality >= originMin
bool shortQualifiedOrigin = shortBreakBaseValid and shortRoomPass and shortDirectLevelPass and shortChopPass and bearDisplacement and bearExpansionEvidence and shortBreakQuality >= originMin
var float longAcceptTop = na
var float longAcceptBottom = na
var float shortAcceptTop = na
var float shortAcceptBottom = na
var float longAcceptBaseQuality = 0.0
var float shortAcceptBaseQuality = 0.0
var int longAcceptArmBar = -100000
var int shortAcceptArmBar = -100000
if barstate.isconfirmed
    if longQualifiedOrigin
        usedResistanceZoneId := resistanceZoneId
        longAcceptTop := resistanceTop
        longAcceptBottom := resistanceBottom
        longAcceptBaseQuality := longBreakQuality
        longAcceptArmBar := bar_index
    if shortQualifiedOrigin
        usedSupportZoneId := supportZoneId
        shortAcceptTop := supportTop
        shortAcceptBottom := supportBottom
        shortAcceptBaseQuality := shortBreakQuality
        shortAcceptArmBar := bar_index
    if not na(longAcceptTop)
        int longAgeNow = bar_index - longAcceptArmBar
        bool longReturnedTooDeep = longAgeNow > 0 and low < longAcceptBottom - acceptanceTouchAtr * atr
        if longAgeNow > acceptanceBars or close < longAcceptBottom - acceptanceInvalidAtr * atr or longReturnedTooDeep
            longAcceptTop := na
            longAcceptBottom := na
    if not na(shortAcceptTop)
        int shortAgeNow = bar_index - shortAcceptArmBar
        bool shortReturnedTooDeep = shortAgeNow > 0 and high > shortAcceptTop + acceptanceTouchAtr * atr
        if shortAgeNow > acceptanceBars or close > shortAcceptTop + acceptanceInvalidAtr * atr or shortReturnedTooDeep
            shortAcceptTop := na
            shortAcceptBottom := na
int longOriginAge = bar_index - longAcceptArmBar
int shortOriginAge = bar_index - shortAcceptArmBar
bool longAcceptanceActive = not na(longAcceptTop) and longOriginAge >= 1 and longOriginAge <= acceptanceBars
bool shortAcceptanceActive = not na(shortAcceptTop) and shortOriginAge >= 1 and shortOriginAge <= acceptanceBars
float longAcceptedChase = longAcceptanceActive and atr > 0 ? math.max(0.0, close - longAcceptTop) / atr : 99.0
float shortAcceptedChase = shortAcceptanceActive and atr > 0 ? math.max(0.0, shortAcceptBottom - close) / atr : 99.0
bool longAcceptanceConfirmation = longAcceptanceActive and close > longAcceptTop + 0.05 * atr and close > open and close > close[1] and directionalClose >= 0.55 and longAcceptedChase <= maxChaseAtr and (volumePercentile >= acceptanceVolMin or bullFvg)
bool shortAcceptanceConfirmation = shortAcceptanceActive and close < shortAcceptBottom - 0.05 * atr and close < open and close < close[1] and directionalClose <= 0.45 and shortAcceptedChase <= maxChaseAtr and (volumePercentile >= acceptanceVolMin or bearFvg)
float longAcceptedBreakQuality = clamp(0.70 * longAcceptBaseQuality + 10.0 * longCloseQuality + 8.0 * bodyQuality + 7.0 * clamp01(volumePercentile / 100.0) + (close > close[1] ? 5.0 : 0.0), 0.0, 100.0)
float shortAcceptedBreakQuality = clamp(0.70 * shortAcceptBaseQuality + 10.0 * shortCloseQuality + 8.0 * bodyQuality + 7.0 * clamp01(volumePercentile / 100.0) + (close < close[1] ? 5.0 : 0.0), 0.0, 100.0)
// Transfer preparation. Critical exhaustion digits arm the setup, never the signal.
// A signal needs index recovery, price micro-BOS and sweep/divergence/rejection evidence.
float priorExhaustionLow = ta.lowest(exhaustion[1], exhDivLen)
float priorExhaustionHigh = ta.highest(exhaustion[1], exhDivLen)
float priorPriceLowExh = ta.lowest(low[1], exhDivLen)
float priorPriceHighExh = ta.highest(high[1], exhDivLen)
bool bullDivergenceEvent = barstate.isconfirmed and criticalLowNow and low < priorPriceLowExh and exhaustion >= priorExhaustionLow + exhDivGap
bool bearDivergenceEvent = barstate.isconfirmed and criticalHighNow and high > priorPriceHighExh and exhaustion <= priorExhaustionHigh - exhDivGap
var int lastBullDivergenceBar = -100000
var int lastBearDivergenceBar = -100000
var bool exhLongConsumed = false
var bool exhShortConsumed = false
var float exhLongLockPrice = na
var float exhShortLockPrice = na
var float exhLongLockAtr = na
var float exhShortLockAtr = na
var int exhLongLockBar = -100000
var int exhShortLockBar = -100000
bool exhLongArmed = longArmed and bar_index - longArmBar <= exhMemory
bool exhShortArmed = shortArmed and bar_index - shortArmBar <= exhMemory
float lowerWickRatio = (math.min(open, close) - low) / candleRangeV5
float upperWickRatio = (high - math.max(open, close)) / candleRangeV5
bool bullRejection = close > open and directionalClose >= 0.62 and lowerWickRatio >= 0.22
bool bearRejection = close < open and directionalClose <= 0.38 and upperWickRatio >= 0.22
// AERF absorption combines candle geometry with a model surprise.
// A large effort that produces less price response than the causal RLS model expected
// accumulates a stronger reservoir than volume or wick geometry alone.
float absorptionVolumeEffort = clamp01((volumePercentile - 45.0) / 45.0)
float absorptionRangeResult = clamp01(rangeAtr / 1.50)
float absorptionBodyResult = clamp01(bodyAtr / 1.00)
float absorptionInefficiency = clamp01(absorptionVolumeEffort - 0.35 * absorptionRangeResult - 0.25 * absorptionBodyResult + 0.35)
float bullAbsorptionClose = clamp01((directionalClose - 0.45) / 0.45)
float bearAbsorptionClose = clamp01((0.55 - directionalClose) / 0.45)
float bullAbsorptionWick = clamp01(lowerWickRatio / 0.35)
float bearAbsorptionWick = clamp01(upperWickRatio / 0.35)
bool bullAbsorptionEdge = low <= ta.lowest(low[1], absorptionLookback)
bool bearAbsorptionEdge = high >= ta.highest(high[1], absorptionLookback)
float bullGeometryAbsorption = clamp01(0.25 * bullAbsorptionClose + 0.20 * bullAbsorptionWick + 0.20 * absorptionVolumeEffort + 0.20 * absorptionInefficiency + (bullAbsorptionEdge ? 0.15 : 0.0))
float bearGeometryAbsorption = clamp01(0.25 * bearAbsorptionClose + 0.20 * bearAbsorptionWick + 0.20 * absorptionVolumeEffort + 0.20 * absorptionInefficiency + (bearAbsorptionEdge ? 0.15 : 0.0))
float bullAdaptiveAbsorption = clamp01(0.65 * bullModelMismatch + 0.35 * bullGeometryAbsorption)
float bearAdaptiveAbsorption = clamp01(0.65 * bearModelMismatch + 0.35 * bearGeometryAbsorption)
float bullAbsorptionQuality = 100.0 * math.sqrt(bullAdaptiveAbsorption * (0.40 + 0.60 * aerfVolumeEffort))
float bearAbsorptionQuality = 100.0 * math.sqrt(bearAdaptiveAbsorption * (0.40 + 0.60 * aerfVolumeEffort))
bool bullAbsorptionEvent = barstate.isconfirmed and aerfReady and (criticalLowNow or exhLongArmed) and bullAbsorptionEdge and bullAbsorptionQuality >= absorptionMin
bool bearAbsorptionEvent = barstate.isconfirmed and aerfReady and (criticalHighNow or exhShortArmed) and bearAbsorptionEdge and bearAbsorptionQuality >= absorptionMin
var int lastBullAbsorptionBar = -100000
var int lastBearAbsorptionBar = -100000
var float lastBullAbsorptionQuality = 0.0
var float lastBearAbsorptionQuality = 0.0
bool longNeutralHold = ta.lowest(exhaustion, familyResetHoldBars) >= 50.0
bool shortNeutralHold = ta.highest(exhaustion, familyResetHoldBars) <= 50.0
bool longLockMoveComplete = exhLongConsumed and not na(exhLongLockPrice) and close >= exhLongLockPrice + familyResetMoveAtr * nz(exhLongLockAtr, atr)
bool shortLockMoveComplete = exhShortConsumed and not na(exhShortLockPrice) and close <= exhShortLockPrice - familyResetMoveAtr * nz(exhShortLockAtr, atr)
bool longLockContextRecovered = not bearImpulseRecent and biasMid == 1 and close > lrMid
bool shortLockContextRecovered = not bullImpulseRecent and biasMid == -1 and close < lrMid
bool longLockExpired = exhLongConsumed and bar_index - exhLongLockBar >= familyMaxLockBars and longNeutralHold and not bearImpulseRecent
bool shortLockExpired = exhShortConsumed and bar_index - exhShortLockBar >= familyMaxLockBars and shortNeutralHold and not bullImpulseRecent
bool exhLongFamilyReset = exhLongConsumed and ((longLockMoveComplete and longNeutralHold and longLockContextRecovered) or longLockExpired)
bool exhShortFamilyReset = exhShortConsumed and ((shortLockMoveComplete and shortNeutralHold and shortLockContextRecovered) or shortLockExpired)
if barstate.isconfirmed
    if exhLongFamilyReset
        exhLongConsumed := false
        exhLongLockPrice := na
        exhLongLockAtr := na
        exhLongLockBar := -100000
    if exhShortFamilyReset
        exhShortConsumed := false
        exhShortLockPrice := na
        exhShortLockAtr := na
        exhShortLockBar := -100000
    if bullDivergenceEvent
        lastBullDivergenceBar := bar_index
    if bearDivergenceEvent
        lastBearDivergenceBar := bar_index
    if bullAbsorptionEvent
        lastBullAbsorptionBar := bar_index
        lastBullAbsorptionQuality := bullAbsorptionQuality
    if bearAbsorptionEvent
        lastBearAbsorptionBar := bar_index
        lastBearAbsorptionQuality := bearAbsorptionQuality
bool bullDivergenceSeen = bar_index - lastBullDivergenceBar <= exhMemory
bool bearDivergenceSeen = bar_index - lastBearDivergenceBar <= exhMemory
bool bullAbsorptionSeen = bar_index - lastBullAbsorptionBar <= absorptionMemory
bool bearAbsorptionSeen = bar_index - lastBearAbsorptionBar <= absorptionMemory
float bullAbsorptionRecentQuality = bullAbsorptionSeen ? lastBullAbsorptionQuality : 0.0
float bearAbsorptionRecentQuality = bearAbsorptionSeen ? lastBearAbsorptionQuality : 0.0
bool longCounterContext = bearStructure or bearImpulseRecent
bool shortCounterContext = bullStructure or bullImpulseRecent
float counterBullBosLevel = ta.highest(high[1], exhCounterBosLen)
float counterBearBosLevel = ta.lowest(low[1], exhCounterBosLen)
bool longMicroBreak = longCounterContext ? close > counterBullBosLevel : close > high[1]
bool shortMicroBreak = shortCounterContext ? close < counterBearBosLevel : close < low[1]
float exhLongRecovery = exhLongArmed ? exhaustion - nz(lowCriticalExtreme, exhaustion) : 0.0
float exhShortRecovery = exhShortArmed ? nz(highCriticalExtreme, exhaustion) - exhaustion : 0.0
float exhLongRequiredRecovery = longCounterContext ? math.max(exhRecoveryPts, exhCounterRecoveryPts) : exhRecoveryPts
float exhShortRequiredRecovery = shortCounterContext ? math.max(exhRecoveryPts, exhCounterRecoveryPts) : exhRecoveryPts
bool exhLongRecovered = exhLongRecovery >= exhLongRequiredRecovery and exhaustion > exhaustion[1]
bool exhShortRecovered = exhShortRecovery >= exhShortRequiredRecovery and exhaustion < exhaustion[1]
bool exhLongEvidence = longSweepSeen or bullDivergenceSeen or bullRejection or bullAbsorptionSeen
bool exhShortEvidence = shortSweepSeen or bearDivergenceSeen or bearRejection or bearAbsorptionSeen
bool exhLongCounterPass = not longCounterContext or (bullAbsorptionSeen and (supportAtRangeEdge or longSweepSeen or bullDivergenceSeen))
bool exhShortCounterPass = not shortCounterContext or (bearAbsorptionSeen and (resistanceAtRangeEdge or shortSweepSeen or bearDivergenceSeen))
float exhLongDepth = clamp01((dynamicLow - nz(lowCriticalExtreme, dynamicLow)) / 12.0)
float exhShortDepth = clamp01((nz(highCriticalExtreme, dynamicHigh) - dynamicHigh) / 12.0)
float exhLongRecoveryQuality = clamp01(exhLongRecovery / math.max(2.0 * exhLongRequiredRecovery, 0.01))
float exhShortRecoveryQuality = clamp01(exhShortRecovery / math.max(2.0 * exhShortRequiredRecovery, 0.01))
float bullDecayRecent = ta.highest(bullDriveDecay, transferDecayMemory)
float bearDecayRecent = ta.highest(bearDriveDecay, transferDecayMemory)
float bullTransferStructure = longMicroBreak ? 0.70 + 0.30 * longCloseQuality : 0.0
float bearTransferStructure = shortMicroBreak ? 0.70 + 0.30 * shortCloseQuality : 0.0
float bullTransferExhaustion = clamp01(0.20 + 0.40 * exhLongDepth + 0.40 * exhLongRecoveryQuality)
float bearTransferExhaustion = clamp01(0.20 + 0.40 * exhShortDepth + 0.40 * exhShortRecoveryQuality)
float bullTransferProduct = clamp01(bullAbsorptionRecentQuality / 100.0) * bullDecayRecent * bullOpposingControl * bullTransferStructure * bullTransferExhaustion
float bearTransferProduct = clamp01(bearAbsorptionRecentQuality / 100.0) * bearDecayRecent * bearOpposingControl * bearTransferStructure * bearTransferExhaustion
float exhLongQuality = 100.0 * math.pow(math.max(bullTransferProduct, 0.0), 0.20) * (1.0 - 0.60 * bearRetainedEnergy)
float exhShortQuality = 100.0 * math.pow(math.max(bearTransferProduct, 0.0), 0.20) * (1.0 - 0.60 * bullRetainedEnergy)
float exhLongCloseMinimum = longCounterContext ? 0.62 : 0.58
float exhShortCloseMaximum = shortCounterContext ? 0.38 : 0.42
bool exhaustionLongReadyBase = barstate.isconfirmed and aerfReady and not exhLongConsumed and exhLongArmed and exhLongRecovered and longMicroBreak and close > open and directionalClose >= exhLongCloseMinimum and bullAbsorptionSeen and exhLongCounterPass
bool exhaustionShortReadyBase = barstate.isconfirmed and aerfReady and not exhShortConsumed and exhShortArmed and exhShortRecovered and shortMicroBreak and close < open and directionalClose <= exhShortCloseMaximum and bearAbsorptionSeen and exhShortCounterPass
// AERF CONTINUATION. A directional-energy reservoir is captured when a mature trend
// enters a controlled pullback. The signal occurs only when weak opposing effort is
// followed by renewed force, a two-bar recovery break and sufficient structural room.
bool bullContinuationTrend = bullStructure or bullImpulseRecent
bool bearContinuationTrend = bearStructure or bearImpulseRecent
bool bullPullbackEvent = barstate.isconfirmed and aerfReady and bullContinuationTrend and not strongBearImpulse and exhaustion < 50.0 and (low <= lrMid or close < lrFast) and (aerfSignedForce < 0 or close < close[1])
bool bearPullbackEvent = barstate.isconfirmed and aerfReady and bearContinuationTrend and not strongBullImpulse and exhaustion > 50.0 and (high >= lrMid or close > lrFast) and (aerfSignedForce > 0 or close > close[1])
var int bullPullbackBar = -100000
var int bearPullbackBar = -100000
var float bullPullbackEnergy = 0.0
var float bearPullbackEnergy = 0.0
var float bullPullbackQuality = 0.0
var float bearPullbackQuality = 0.0
float bullPullbackReset = clamp01((50.0 - exhaustion) / 25.0)
float bearPullbackReset = clamp01((exhaustion - 50.0) / 25.0)
float currentBullPullbackQuality = clamp01(0.50 * bullModelMismatch + 0.30 * bullPullbackReset + 0.20 * absorptionInefficiency)
float currentBearPullbackQuality = clamp01(0.50 * bearModelMismatch + 0.30 * bearPullbackReset + 0.20 * absorptionInefficiency)
if barstate.isconfirmed
