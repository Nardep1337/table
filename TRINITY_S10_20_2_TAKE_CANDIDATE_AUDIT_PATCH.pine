        bullPullbackQuality := newBullPullback ? currentBullPullbackQuality : math.max(bullPullbackQuality, currentBullPullbackQuality)
    if bearPullbackEvent
        bool newBearPullback = bar_index - bearPullbackBar > continuationMemory
        bearPullbackBar := bar_index
