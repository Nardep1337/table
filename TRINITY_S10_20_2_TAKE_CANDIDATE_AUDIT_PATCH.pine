bool topReversalPriceConfirm = topReversalPriceBoundary and topReversalHypothesisLive
float bottomContDirectDistanceAtr = bottomResolverPending and not na(bottomResolverExtreme) ? math.max(bottomResolverExtreme - close, 0.0) / math.max(nz(bottomContAttackAtr, resolverAtr), syminfo.mintick) : 99.0
float topContDirectDistanceAtr = topResolverPending and not na(topResolverExtreme) ? math.max(close - topResolverExtreme, 0.0) / math.max(nz(topContAttackAtr, resolverAtr), syminfo.mintick) : 99.0
bool bottomContDirectVictory = bottomContStage == 1 and bottomContAcceptStreak >= contDirectBars and bottomContinuationExtremeBreak and bottomContDirectDistanceAtr <= contDirectMaxChaseAtr and bottomRenewalQuality >= contRenewalMin
